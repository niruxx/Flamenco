def kdl_spawn_lines(text: str) -> list[tuple[int, int]]:
    """Spans of top-level spawn-at-startup / spawn-sh-at-startup lines (comments ignored)."""
    masked = kdl_mask(text)
    return [(m.start(), m.end()) for m in re.finditer(r"(?m)^[ \t]*spawn(?:-sh)?-at-startup\b[^\n]*", masked)]


# ─────────────────────────── distros: package names ─────────────────────────
# Flamenco names packages the Arch way; on Debian/Ubuntu (apt) and Fedora (dnf)
# these are their names there. None = not in that distro's repositories.
DISTRO_PACKAGES = {
    "apt": {
        "adw-gtk-theme": None, "bluez-utils": "bluez", "glib2": "libglib2.0-bin", "kvantum": "qt-style-kvantum",
        "libnotify": "libnotify-bin", "libsecret": "libsecret-tools", "matugen-bin": None, "mesa": "libgl1-mesa-dri",
        "networkmanager": "network-manager", "networkmanager-openvpn": "network-manager-openvpn",
        "noto-fonts-emoji": "fonts-noto-color-emoji", "pacman-contrib": None, "pipewire": "pipewire-bin", "libpulse": "pulseaudio-utils", "mako": "mako-notifier",
        "python-anthropic": None, "python-gobject": "python3-gi", "qt6-imageformats": "qt6-image-formats-plugins",
        "quickshell": None, "xwayland-satellite": None, "hyprland": "hyprland",
        "qt6-multimedia": "qml6-module-qtmultimedia", "qt6-multimedia-ffmpeg": "libqt6multimedia6",
    },
    "dnf": {
        "adw-gtk-theme": "adw-gtk3-theme", "bluez-utils": "bluez", "glib2": "glib2", "libnotify": "libnotify",
        "matugen-bin": None, "mesa": "mesa-dri-drivers", "networkmanager": "NetworkManager",
        "networkmanager-openvpn": "NetworkManager-openvpn", "noto-fonts-emoji": "google-noto-color-emoji-fonts",
        "pacman-contrib": None, "pipewire": "pipewire-utils", "libpulse": "pulseaudio-utils", "python-anthropic": None, "python-gobject": "python3-gobject",
        "qt6-imageformats": "qt6-qtimageformats", "quickshell": None,
        "qt6-multimedia": "qt6-qtmultimedia", "qt6-multimedia-ffmpeg": "qt6-qtmultimedia",
    },
}
# where to get what a distro doesn't package
NOT_PACKAGED = {
    "quickshell": "Quickshell: https://quickshell.org/docs/guide/install-setup (Fedora: COPR errornointernet/quickshell)",
    "matugen-bin": "matugen: cargo install matugen",
    "python-anthropic": "the Anthropic SDK: pip install --user anthropic",
}


def pkg_manager() -> str:
    """pacman, apt or dnf: whichever this system has (pacman first)."""
    return next((m for m in ("pacman", "apt", "dnf") if shutil.which(m)), "")


def distro_pkg(name: str) -> str | None:
    """An Arch package name as this distro calls it (None: not in its repositories)."""
    mgr = pkg_manager()
    if mgr in ("", "pacman"):
        return name
    return DISTRO_PACKAGES[mgr].get(name, name)


def install_hint(*names: str) -> str:
    """The command that installs these packages on this system, for messages."""
    mgr = pkg_manager()
    pkgs = [p for p in (distro_pkg(n) for n in names) if p]
    if not pkgs:
        return "; ".join(NOT_PACKAGED.get(n, n) for n in names)
    if mgr == "apt":
        return "sudo apt install " + " ".join(pkgs)
    if mgr == "dnf":
        return "sudo dnf install " + " ".join(pkgs)
    return "sudo pacman -S " + " ".join(pkgs)


def install_command(checks: list[dict]) -> str:
    missing = [c for c in checks if not c["ok"] and c["package"]]
    # a check can name several packages ("qt6-multimedia qt6-multimedia-ffmpeg")
    repo = sorted({p for c in missing if not c["aur"] for p in c["package"].split()})
    aur = sorted({p for c in missing if c["aur"] for p in c["package"].split()})
    helper = next((h for h in ("paru", "yay") if shutil.which(h)), "")
    parts = []
    mgr = pkg_manager()
    if mgr in ("apt", "dnf"):
        # this distro's names; what it doesn't package is said, not installed
        want = sorted({distro_pkg(p) for p in repo + aur if distro_pkg(p)})
        gone = sorted({p for p in repo + aur if not distro_pkg(p)})
        if want:
            parts.append(("sudo apt install " if mgr == "apt" else "sudo dnf install ") + " ".join(want))
        if gone:
            parts.append("echo " + shlex.quote("Not in your distro's repositories: " + " · ".join(NOT_PACKAGED.get(p, p) for p in gone)))
        parts += [c["fix"] for c in checks if not c["ok"] and c.get("fix")]
        return " && ".join(parts) if parts else ""
    if repo:
        parts.append("sudo pacman -S --needed " + " ".join(repo))
    # AUR packages need a helper; without one they're listed but left out (see the "AUR helper" check)
    if aur and helper:
        parts.append(f"{helper} -S --needed " + " ".join(aur))
    # things a package doesn't fix (group membership…)
    parts += [c["fix"] for c in checks if not c["ok"] and c.get("fix")]
    return " && ".join(parts)


def cmd_doctor(args: list[str]) -> int:
    checks = doctor_checks()
    if "--json" in args:
        print(json.dumps({"checks": checks, "install": install_command(checks)}))
        return 0
    if "--install-command" in args:
        print(install_command(checks))
        return 0
    category = None
    for c in checks:
        if c["category"] != category:
            category = c["category"]
            print(f"\n {category}")
        mark = "\033[32m✓\033[0m" if c["ok"] else ("\033[31m✗\033[0m" if c["required"] else "\033[33m-\033[0m")
        pkg = f"  [{c['package']}{' (AUR)' if c['aur'] else ''}]" if not c["ok"] and c["package"] else ""
        print(f"  {mark} {c['name']:<24} {c['purpose']}{pkg}")
        if not c["ok"] and c["hint"]:
            print(f"      → {c['hint']}")
    cmd = install_command(checks)
    if cmd:
        print(f"\n Install what's missing:\n   {cmd}")
    print(f"\n shell dir: {shell_dir()}\n config:    {CONFIG_DIR}\n log:       {LOG_FILE}")
    return 0 if all(c["ok"] for c in checks if c["required"]) else 1


