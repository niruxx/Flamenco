""",
    "launcher.py": """#!/usr/bin/env python3
# A Flamenco launcher extension: called with what's typed after the prefix,
# prints one JSON result per line: title, subtitle, icon (Material Symbols name)
# and one action: exec (a shell command), copy (text) or open (a URL or file).
import json, sys
q = " ".join(sys.argv[1:])
print(json.dumps({"title": f"Search the web for “{q}”", "subtitle": "Opens your browser", "icon": "travel_explore",
                  "open": "https://duckduckgo.com/?q=" + q.replace(" ", "+")}))
print(json.dumps({"title": q.upper() or "Type something", "subtitle": "Copy in capitals", "icon": "text_fields", "copy": q.upper()}))
""",
}


def cmd_plugins(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "list":
        pl = plugins_list()
        if "--json" in args:
            print(json.dumps({"dir": str(PLUGIN_DIR), "plugins": pl}))
        else:
            for p in pl:
                print(f"{p['id']:<20} {'ok ' if p['ok'] else 'ERR'} {p.get('name', '')} {p.get('version', '')}  {p['error']}")
            print(f"({PLUGIN_DIR})")
        return 0
    if sub == "new" and len(args) > 1:
        pid = args[1].lower()
        if not PLUGIN_ID.match(pid):
            die("plugin id: lowercase letters, digits, . _ -")
        d = PLUGIN_DIR / pid
        if d.exists():
            die(f"{d} already exists")
        d.mkdir(parents=True)
        for name, text in PLUGIN_EXAMPLE.items():
            (d / name).write_text(text.replace('"Hello"', json.dumps(pid.capitalize())))
        (d / "launcher.py").chmod(0o755)
        print(f"plugins: created {d}. Turn it on in Settings → Plugins.")
        return 0
    if sub == "install" and len(args) > 1:
        src = args[1]
        if re.match(r"^(https://|git@)", src):
            name = re.sub(r"\.git$", "", src.rstrip("/").rsplit("/", 1)[-1]).lower()
            name = re.sub(r"^flamenco[-_]", "", name)
            if not PLUGIN_ID.match(name):
                die(f"can't make a plugin id from {src}")
            d = PLUGIN_DIR / name
            if d.exists():
                die(f"{d} already exists (remove it first, or `git -C {d} pull` to update)")
            PLUGIN_DIR.mkdir(parents=True, exist_ok=True)
            if subprocess.run(["git", "clone", "--depth", "1", "--", src, str(d)]).returncode != 0:
                die("git clone failed")
        else:
            srcp = Path(os.path.expanduser(src)).resolve()
            if not (srcp / "manifest.json").is_file():
                die("not a plugin folder (no manifest.json)")
            d = PLUGIN_DIR / srcp.name.lower()
            if d.exists():
                die(f"{d} already exists")
            shutil.copytree(srcp, d)
        p = plugin_read(d)
        print(f"plugins: installed {p['id']}" + (f" (problem: {p['error']})" if p["error"] else "") + ". It's off until you turn it on in Settings → Plugins.")
        return 0
    if sub == "remove" and len(args) > 1:
        d = PLUGIN_DIR / args[1]
        if not PLUGIN_ID.match(args[1]) or not d.is_dir():
            die(f"no plugin {args[1]}")
        shutil.rmtree(d)
        print(f"plugins: removed {args[1]}")
        return 0
    die("usage: flamenco plugins list [--json] | new ID | install GIT_URL|FOLDER | remove ID")


# ─────────────────────────────── Super key on its own (overview) ─────────────
# `flamenco super-watch` prints "tap" whenever Super is pressed and let go with
# nothing else in between, like GNOME's Activities key. Compositors run key
# bindings on press, so niri can't tell a lone Super from Super+T. This reads
# the keyboards and mice directly instead (/dev/input, which needs the input
# group). It never grabs them, keeps nothing and only prints "tap".
INPUT_DIR = Path(os.environ.get("FLAMENCO_INPUT_DIR", "/dev/input"))
SYS_INPUT = Path(os.environ.get("FLAMENCO_SYS_INPUT", "/sys/class/input"))
EV_KEY, EV_REL = 1, 2
KEY_META = {125, 126}                      # KEY_LEFTMETA, KEY_RIGHTMETA
BTN_LEFT = 272
REL_WHEELS = {6, 8, 11, 12}                # (H)WHEEL and their hi-res versions


def input_devices() -> list[Path]:
    """Event devices with a Super key (keyboards) or buttons (mice, touchpads)."""
    bits = 8 * struct_size("l")
    out = []
    for dev in sorted(INPUT_DIR.glob("event*"), key=lambda d: int(re.sub(r"\D", "", d.name) or 0)):
        try:
            words = (SYS_INPUT / dev.name / "device/capabilities/key").read_text().split()
        except OSError:
            continue
        caps = 0
        for w in words:
            caps = (caps << bits) | int(w, 16)
        if any(caps >> k & 1 for k in (*KEY_META, BTN_LEFT)):
            out.append(dev)
    return out


def struct_size(fmt: str) -> int:
    import struct
    return struct.calcsize(fmt)


class SuperTap:
    """Feed it input events; it says when one was the end of a lone Super tap."""

    def __init__(self, max_hold: float = 0.6):
        self.max_hold = max_hold
        self.held: set[int] = set()
        self.since: float | None = None    # when the tap started; None = not a tap

    def feed(self, t: float, kind: int, code: int, value: int) -> bool:
        if kind == EV_REL:
            if code in REL_WHEELS:         # Super+scroll
                self.since = None
            return False
        if kind != EV_KEY or value == 2:   # autorepeat
            return False
        meta = code in KEY_META
        if value == 1:
            others = self.held - KEY_META
            if meta and not others:
                if self.since is None:
                    self.since = t
            else:                          # Super+key, Super+click, or Ctrl+Super…
                self.since = None
            self.held.add(code)
            return False
        self.held.discard(code)
        if not meta:
            return False
        tap = self.since is not None and not (self.held & KEY_META) and t - self.since <= self.max_hold
        if tap or not (self.held & KEY_META):
            self.since = None
        return tap


def cmd_super_watch(args: list[str]) -> int:
    import select
    import struct
    ev = struct.Struct("llHHi")
    max_hold = 0.6
    if "--max-hold" in args:
        i = args.index("--max-hold")
        try:
            max_hold = max(0.1, min(5.0, float(args[i + 1])))
        except (IndexError, ValueError):
            die("usage: flamenco super-watch [--max-hold SECONDS]")
    tap = SuperTap(max_hold)
    fds: dict[Path, int] = {}
    said = ""

    def say(line: str):
        nonlocal said
        if line != said:
            said = line
            print(line, flush=True)

    def rescan():
        denied = 0
        for dev in input_devices():
            if dev in fds:
                continue
            try:
                fds[dev] = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            except PermissionError:
                denied += 1
            except OSError:
                pass
        if fds:
            say(f"ready {len(fds)}")
        elif denied:
            say("error permission")
        else:
            say("error no-keyboard")

    rescan()
    if not fds and said == "error permission":
        print("flamenco: no access to /dev/input: add yourself to the input group, then log out and back in", file=sys.stderr)
        return 3
    try:
        while True:
            ready, _, _ = select.select(list(fds.values()), [], [], 3.0)
            if not ready:
                rescan()                    # keyboards plugged in since
                continue
            for dev, fd in list(fds.items()):
                if fd not in ready:
                    continue
                try:
                    data = os.read(fd, ev.size * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    data = b""
                if not data:                # unplugged: forget what it was holding
                    os.close(fd)
                    del fds[dev]
                    tap.held.clear()
                    tap.since = None
                    continue
                for off in range(0, len(data) - ev.size + 1, ev.size):
                    sec, usec, kind, code, value = ev.unpack_from(data, off)
                    if tap.feed(sec + usec / 1e6, kind, code, value):
                        print("tap", flush=True)
    except (KeyboardInterrupt, BrokenPipeError):
        return 0


# ─────────────────────────────── 3rd-party plugins (Noctalia, DMS) ───────────
# Plugins written for Noctalia Shell v4 (QML, manifest.json) and DankMaterialShell
# (plugin.json). They import their own shell's modules (qs.Commons, qs.Widgets…);
# Flamenco keeps a copy of each with those imports pointed at its compatibility
# layer (shell/Compat/<Kind>, see tools/compat-vendor.py) and runs that copy.
#   ~/.config/flamenco/compat/<kind>/<id>/   the plugin as installed
#   ~/.cache/flamenco/compat/<kind>/<id>/    the copy the shell loads
COMPAT_SRC = CONFIG_DIR / "compat"
COMPAT_RUN = XDG_CACHE / "flamenco" / "compat"
COMPAT_REPOS = XDG_CACHE / "flamenco" / "compat-repos"
COMPAT_KINDS = {"noctalia": "Noctalia", "dms": "Dms"}
COMPAT_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$")
NOCTALIA_REPO = "https://github.com/noctalia-dev/noctalia-plugins"
DMS_REGISTRY = "https://github.com/AvengeMedia/dms-plugin-registry"
# entry points the compatibility layer runs, and the ones it doesn't (yet)
NOCTALIA_ENTRIES = {"main": "background service", "barWidget": "bar widget", "panel": "panel", "settings": "settings"}
NOCTALIA_UNSUPPORTED = {"desktopWidget": "desktop widget", "desktopWidgetSettings": "desktop widget settings",
                        "controlCenterWidget": "control center button", "launcherProvider": "launcher provider"}
DMS_SUPPORTED_TYPES = {"widget": "bar widget", "daemon": "background service"}
DMS_UNSUPPORTED_TYPES = {"launcher": "launcher extension", "desktop": "desktop widget", "dash": "dashboard tab", "dashCard": "dashboard card"}
# Qt and Quickshell types a plugin may use without the compatibility layer providing them
QT_TYPES = set("""
Item Rectangle Text TextInput TextEdit Image AnimatedImage BorderImage Row Column Flow Grid Repeater Loader MouseArea Timer
Behavior NumberAnimation ColorAnimation SequentialAnimation ParallelAnimation PauseAnimation PropertyAction RotationAnimation
SmoothedAnimation SpringAnimation ScriptAction PropertyAnimation AnchorAnimation FrameAnimation Canvas Transition Connections
