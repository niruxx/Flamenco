ToolTip Label Control AbstractButton ItemDelegate Pane Frame BusyIndicator ProgressBar StackView SwipeView TabBar TabButton
Dialog Drawer SplitView ButtonGroup Action Page ToolBar Scope Variants PanelWindow FloatingWindow PopupWindow LazyLoader
Singleton SystemClock Process StdioCollector SplitParser FileView JsonAdapter JsonObject IpcHandler Region
PwObjectTracker ClippingRectangle ClippingWrapperRectangle WrapperRectangle WrapperItem WrapperMouseArea IconImage
QsMenuOpener QsMenuAnchor ScriptModel PersistentProperties Socket ScreencopyView HyprlandFocusGrab ElapsedTimer
Retainable PopupAnchor ColorQuantizer SoundEffect MediaPlayer AudioOutput VideoOutput Video Settings Keys
Camera CaptureSession MediaDevices ImageCapture FolderDialog FileDialog ColorDialog MessageDialog FontDialog
""".split())


def compat_dir(kind: str) -> Path:
    return shell_dir() / "Compat" / COMPAT_KINDS[kind]


def compat_manifest(d: Path) -> tuple[str, dict] | None:
    """(kind, manifest) of a plugin folder, or None."""
    for kind, name in (("noctalia", "manifest.json"), ("dms", "plugin.json")):
        f = d / name
        if f.is_file():
            try:
                m = json.loads(f.read_text())
            except Exception:
                continue
            if kind == "noctalia" and not isinstance(m.get("entryPoints"), dict):
                continue
            if isinstance(m, dict) and m.get("id"):
                return kind, m
    return None


def compat_entries(kind: str, m: dict) -> dict:
    """entry point → file (relative), for the parts Flamenco runs."""
    if kind == "noctalia":
        return {k: v for k, v in (m.get("entryPoints") or {}).items() if k in NOCTALIA_ENTRIES and isinstance(v, str)}
    out = {}
    comps = m.get("components") if isinstance(m.get("components"), dict) else None
    if comps:                                   # composite plugin (DMS 1.5+)
        for part, f in comps.items():
            if part in DMS_SUPPORTED_TYPES and isinstance(f, str):
                out[part] = f
    elif (m.get("type") or "widget") in DMS_SUPPORTED_TYPES and isinstance(m.get("component"), str):
        out[m.get("type") or "widget"] = m["component"]     # no type: a widget
    if isinstance(m.get("settings"), str):
        out["settings"] = m["settings"]
    return {k: re.sub(r"^\./", "", v) for k, v in out.items()}


def compat_rewrite(text: str, kind: str) -> str:
    return re.sub(r"(?m)^(\s*import\s+)qs\.(?!Compat\.)", rf"\1qs.Compat.{COMPAT_KINDS[kind]}.", text)


def compat_convert(kind: str, pid: str) -> Path:
    """Copy the installed plugin to the folder the shell loads, imports rewritten."""
    src, out = COMPAT_SRC / kind / pid, COMPAT_RUN / kind / pid
    if out.exists():
        shutil.rmtree(out)
    shutil.copytree(src, out, ignore=shutil.ignore_patterns(".git"), symlinks=False)
    for f in list(out.rglob("*.qml")) + list(out.rglob("*.js")):
        try:
            t = f.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        n = compat_rewrite(t, kind)
        if n != t:
            f.write_text(n)
    return out


def compat_provided(kind: str) -> tuple[set[str], set[str]]:
    """(module paths like "Services/UI", type names) the compatibility layer has."""
    base = compat_dir(kind)
    mods, types = set(), set()
    for f in base.rglob("*.qml"):
        mods.add(f.parent.relative_to(base).as_posix())
        types.add(f.stem)
    return mods, types


def compat_scan(kind: str, d: Path, m: dict) -> dict:
    """What of this plugin Flamenco can run, and what it uses that Flamenco doesn't have."""
    issues, notes = [], []
    entries = compat_entries(kind, m)
    if kind == "noctalia":
        for k, label in NOCTALIA_UNSUPPORTED.items():
            if (m.get("entryPoints") or {}).get(k):
                notes.append(f"its {label} isn't supported yet")
    else:
        parts = list((m.get("components") or {}).keys()) if isinstance(m.get("components"), dict) else [m.get("type") or "widget"]
        for p in parts:
            if p in DMS_UNSUPPORTED_TYPES:
                notes.append(f"its {DMS_UNSUPPORTED_TYPES[p]} isn't supported yet")
            elif p not in DMS_SUPPORTED_TYPES and p:
                notes.append(f"unknown plugin type {p!r}")
    for k, f in entries.items():
        if not (d / f).is_file():
            issues.append(f"{f} is missing")
    mods, types = compat_provided(kind) if compat_dir(kind).is_dir() else (set(), set())
    own = {f.stem for f in d.rglob("*.qml")}
    missing_mods, missing_types, missing_singletons = set(), set(), set()
    for f in d.rglob("*.qml"):
        try:
            raw = f.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        text = re.sub(r"/\*.*?\*/|//[^\n]*", "", raw, flags=re.S)
        text = re.sub(r'"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'|`(?:\\.|[^`\\])*`', '""', text, flags=re.S)
        for mod in re.findall(r"(?m)^\s*import\s+qs\.([\w.]+)", raw):
            if mod.startswith("Compat."):
                continue
            if mod.replace(".", "/") not in mods:
                missing_mods.add("qs." + mod)
        quals = set(re.findall(r"(?m)^\s*import\s+\S+(?:\s+[\d.]+)?\s+as\s+(\w+)", raw))
        for t in re.findall(r"(?:^|[\s:;{(,\[])([A-Z]\w*)\s*\{", re.sub(r"(?m)^\s*(import|pragma)\b.*$", "", text)):
            if t not in QT_TYPES and t not in types and t not in own and t not in quals \
                    and not re.search(rf"\b(component\s+{t}\s*:|enum\s+{t}\b)", text):
                missing_types.add(t)
        for s in re.findall(r"(?<![\w.])([A-Z]\w*Service)\.\w+", text):
            if s not in types and s not in own:
                missing_singletons.add(s)
    for x in sorted(missing_mods):
        issues.append(f"imports {x}, which Flamenco doesn't provide")
    for x in sorted(missing_types):
        issues.append(f"uses {x}, which Flamenco doesn't provide")
    for x in sorted(missing_singletons):
        issues.append(f"uses {x}, which Flamenco doesn't provide")
    runnable = [k for k in entries if k != "settings"]
    if not runnable and not entries.get("settings"):
        status = "unsupported"
        notes.append("nothing in it that Flamenco can run")
    elif missing_mods or missing_types:
        status = "partial" if runnable else "unsupported"
    elif issues or notes:
        status = "partial"
    else:
        status = "ok"
    return {"status": status, "issues": issues, "notes": notes, "entries": entries}


def compat_list() -> list[dict]:
    out = []
    for kind in COMPAT_KINDS:
        for d in sorted((COMPAT_SRC / kind).glob("*")) if (COMPAT_SRC / kind).is_dir() else []:
            found = compat_manifest(d)
            if not d.is_dir() or not found or found[0] != kind:
                continue
            m = found[1]
            run = COMPAT_RUN / kind / d.name
            # (re)make the copy the shell loads when the plugin changed since
            newest = max((f.stat().st_mtime for f in d.rglob("*") if f.is_file() and ".git" not in f.parts), default=0)
            if not run.is_dir() or newest > run.stat().st_mtime:
                run = compat_convert(kind, d.name)
            scan = compat_scan(kind, d, m)
            try:
                origin = json.loads((d / ".flamenco-origin.json").read_text())
            except Exception:
                origin = {}
            key = f"{kind}/{d.name}"
            out.append({
                "key": key, "kind": kind, "id": d.name, "name": str(m.get("name") or d.name),
                "version": str(m.get("version", "")), "author": str(m.get("author", "")),
                "description": str(m.get("description", "")), "icon": str(m.get("icon", "")),
                "dir": str(run), "source": str(d), "origin": origin.get("spec", ""),
                "manifest": m, "status": scan["status"], "issues": scan["issues"], "notes": scan["notes"],
                "entries": {k: str(run / v) for k, v in scan["entries"].items()},
                "defaults": (m.get("metadata") or {}).get("defaultSettings") or {},
                "dmsType": (m.get("type") or "widget") if kind == "dms" else "",
                "permissions": m.get("permissions") or [],
            })
    return out


def compat_repo(url: str, branch: str = "", refresh: bool = False) -> Path:
    """A shallow clone of a git repository, kept in the cache and refreshed every 6 hours."""
    import hashlib
    import time
    # addresses and branches come from plugin catalogs (other people's data): only https
    # addresses, branch names that can't pass for git options, and "--" before them below
    if not re.match(r"^https://[A-Za-z0-9.-]+(:\d+)?/\S+$", url):
        die(f"not an https address: {url}")
    if branch and not re.fullmatch(r"[A-Za-z0-9._][A-Za-z0-9._/-]{0,199}", branch):
        die(f"not a branch name: {branch}")
    name = re.sub(r"[^A-Za-z0-9._-]", "_", re.sub(r"^https?://", "", url).rstrip("/"))[:80]
    d = COMPAT_REPOS / (name + ("@" + branch if branch else "") + "-" + hashlib.sha1(url.encode()).hexdigest()[:6])
    if not shutil.which("git"):
        die(f"git isn't installed (it's needed to fetch plugins): {install_hint('git')}")
    if d.is_dir() and (d / ".git").is_dir():
        stamp = d / ".git" / "FETCH_HEAD"
        age = time.time() - (stamp.stat().st_mtime if stamp.exists() else (d / ".git").stat().st_mtime)
        if refresh or age > 6 * 3600:
            r = subprocess.run(["git", "-C", str(d), "fetch", "--depth", "1", "--", "origin", branch or "HEAD"], capture_output=True, text=True)
            if r.returncode == 0:
                subprocess.run(["git", "-C", str(d), "reset", "--hard", "FETCH_HEAD"], capture_output=True)
            else:
                print(f"compat: couldn't update {url}, using the copy from before", file=sys.stderr)
        return d
    COMPAT_REPOS.mkdir(parents=True, exist_ok=True)
    cmd = ["git", "clone", "--depth", "1", *(["--branch", branch] if branch else []), "--", url, str(d)]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        shutil.rmtree(d, ignore_errors=True)
        die(f"couldn't download {url}: {(r.stderr.strip().splitlines() or ['git clone failed'])[-1]}")
    return d


def compat_catalog(kind: str, refresh: bool = False) -> list[dict]:
    installed = {p["key"] for p in compat_list()}
    out = []
    if kind == "noctalia":
        repo = compat_repo(NOCTALIA_REPO, refresh=refresh)
        try:
            reg = json.loads((repo / "registry.json").read_text()).get("plugins", [])
        except Exception:
            reg = [{"id": d.name} for d in repo.iterdir() if (d / "manifest.json").is_file()]
        for p in reg:
            pid = str(p.get("id", ""))
            d = repo / pid
            if not COMPAT_ID.match(pid) or not d.is_dir():
                continue
            found = compat_manifest(d)
            scan = compat_scan("noctalia", d, found[1]) if found else {"status": "unsupported", "issues": ["no manifest"], "notes": []}
            out.append({"spec": f"noctalia:{pid}", "kind": "noctalia", "id": pid, "name": p.get("name") or pid,
                        "description": p.get("description", ""), "author": p.get("author", ""),
                        "version": p.get("version", ""), "tags": p.get("tags", []), "official": bool(p.get("official")),
                        "status": scan["status"], "issues": scan["issues"][:6], "notes": scan["notes"],
                        "installed": f"noctalia/{pid}" in installed})
    else:
        repo = compat_repo(DMS_REGISTRY, refresh=refresh)
        for f in sorted((repo / "plugins").glob("*.json")):
            try:
                p = json.loads(f.read_text())
            except Exception:
                continue
            pid = str(p.get("id", ""))
            if not COMPAT_ID.match(pid):
                continue
            caps = p.get("capabilities") or []
            # before it's downloaded, only what the registry says can be judged
            can = [c for c in caps if c in ("dankbar-widget", "daemon")]
            out.append({"spec": f"dms:{pid}", "kind": "dms", "id": pid, "name": p.get("name") or pid,
                        "description": p.get("description", ""), "author": p.get("author", ""),
                        "repo": p.get("repo", ""), "tags": caps, "dependencies": p.get("dependencies") or [],
                        "compositors": p.get("compositors") or [], "screenshot": p.get("screenshot", ""),
                        "status": "unknown" if can else "unsupported",
                        "issues": [] if can else ["only " + ", ".join(caps or ["unknown parts"]) + ": Flamenco runs bar widgets and background services"],
                        "notes": [], "installed": f"dms/{pid}" in installed})
    return out


def compat_find_plugin(root: Path, want: str = "") -> Path:
    """The plugin folder in a downloaded repository: the root, or the subfolder with the wanted id."""
    if compat_manifest(root) and (not want or compat_manifest(root)[1].get("id") == want):
        return root
    found = []
    for f in list(root.rglob("manifest.json")) + list(root.rglob("plugin.json")):
        if ".git" in f.parts or "node_modules" in f.parts:
            continue
        mf = compat_manifest(f.parent)
        if mf:
            found.append((f.parent, mf[1].get("id")))
    if want:
        hit = [p for p, i in found if i == want] or [p for p, _ in found if p.name == want]
        if hit:
            return hit[0]
        die(f"there's no plugin {want!r} in it" + (": it has " + ", ".join(sorted(str(i) for _, i in found)) if found else ""))
    if len(found) == 1:
        return found[0][0]
    if not found:
        die("that isn't a Noctalia or DMS plugin (no manifest.json or plugin.json)")
    die("it has several plugins; add #ID to the address. They are: " + ", ".join(sorted(str(i) for _, i in found)))


def compat_install(spec: str, refresh: bool = False) -> str:
    want = ""
    if spec.startswith("noctalia:"):
        want = spec.split(":", 1)[1]
        src = compat_find_plugin(compat_repo(NOCTALIA_REPO, refresh=refresh), want)
    elif spec.startswith("dms:"):
        want = spec.split(":", 1)[1]
        entry = next((p for p in compat_catalog("dms", refresh) if p["id"] == want), None)
        if not entry or not entry.get("repo"):
            die(f"no DMS plugin {want!r} in the registry")
        m = re.match(r"^(https://[^/]+/[^/]+/[^/#]+?)(?:\.git)?(?:/tree/([^/]+)(?:/(.*))?)?/?$", entry["repo"])
        if not m:
            die(f"can't read the address {entry['repo']}")
        repo = compat_repo(m.group(1), m.group(2) or "", refresh)
        sub = repo / m.group(3) if m.group(3) else repo
        src = compat_find_plugin(sub if sub.is_dir() else repo, want)
    elif re.match(r"^(https://|git@)", spec):
        url, _, sub = spec.partition("#")
        m = re.match(r"^(https://[^/]+/[^/]+/[^/#]+?)(?:\.git)?/tree/([^/]+)(?:/(.*))?/?$", url)
        if m:                                   # a GitHub folder address
            repo = compat_repo(m.group(1), m.group(2), refresh)
            base = repo / m.group(3) if m.group(3) else repo
        else:
            base = compat_repo(url, "", refresh)
        src = compat_find_plugin(base, sub)
    else:
        p = Path(os.path.expanduser(spec)).resolve()
        if not p.is_dir():
            die(f"{spec}: no such folder")
        src = compat_find_plugin(p)
    found = compat_manifest(src)
    if not found:
        die("that isn't a Noctalia or DMS plugin")
    kind, m = found
    pid = str(m["id"])
    if not COMPAT_ID.match(pid):
        die(f"the plugin's id {pid!r} has characters Flamenco doesn't allow")
    dest = COMPAT_SRC / kind / pid
    keep = None
    if dest.is_dir() and (dest / "settings.json").is_file():
        keep = (dest / "settings.json").read_bytes()
    if dest.exists():
        shutil.rmtree(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(src, dest, ignore=shutil.ignore_patterns(".git"), symlinks=False)
    if keep is not None:
        (dest / "settings.json").write_bytes(keep)
    import time
    (dest / ".flamenco-origin.json").write_text(json.dumps({"spec": spec, "installed": int(time.time())}) + "\n")
    compat_convert(kind, pid)
    return f"{kind}/{pid}"


def compat_key(arg: str) -> tuple[str, str]:
    kind, _, pid = arg.partition("/")
    if kind not in COMPAT_KINDS or not COMPAT_ID.match(pid) or not (COMPAT_SRC / kind / pid).is_dir():
        die(f"no 3rd-party plugin {arg!r} (see `flamenco compat list`)")
    return kind, pid


def cmd_compat(args: list[str]) -> int:
    sub = args[0] if args else "list"
    js = "--json" in args
    refresh = "--refresh" in args
    rest = [a for a in args[1:] if not a.startswith("--")]
    if sub == "list":
        pl = compat_list()
        if js:
            print(json.dumps({"plugins": pl, "dir": str(COMPAT_SRC)}))
        else:
            for p in pl:
                print(f"{p['key']:<34} {p['status']:<12} {p['name']} {p['version']}")
                for i in p["issues"] + p["notes"]:
                    print(f"{'':<36}· {i}")
            if not pl:
                print("no 3rd-party plugins installed (flamenco compat catalog noctalia|dms)")
        return 0
    if sub == "catalog" and rest and rest[0] in COMPAT_KINDS:
        cat = compat_catalog(rest[0], refresh)
        if js:
            print(json.dumps(cat))
        else:
            for p in cat:
                print(f"{p['spec']:<40} {p['status']:<12} {p['name']}{'  (installed)' if p['installed'] else ''}")
        return 0
    if sub == "install" and rest:
        key = compat_install(rest[0], refresh)
        p = next((x for x in compat_list() if x["key"] == key), None)
        print(json.dumps(p) if js else f"compat: installed {key} ({p['status'] if p else '?'}). Turn it on in Settings → Plugins (3rd party).")
        return 0
    if sub == "update" and rest:
        keys = [p["key"] for p in compat_list()] if rest[0] == "all" else [rest[0]]
        for k in keys:
            kind, pid = compat_key(k)
            try:
                spec = json.loads((COMPAT_SRC / kind / pid / ".flamenco-origin.json").read_text())["spec"]
            except Exception:
                print(f"compat: {k}: don't know where it came from, skipped", file=sys.stderr)
                continue
            compat_install(spec, refresh=True)
            print(f"compat: updated {k}")
        return 0
    if sub == "remove" and rest:
        kind, pid = compat_key(rest[0])
        shutil.rmtree(COMPAT_SRC / kind / pid)
        shutil.rmtree(COMPAT_RUN / kind / pid, ignore_errors=True)
        print(f"compat: removed {kind}/{pid}")
        return 0
    if sub == "scan" and rest:
        kind, pid = compat_key(rest[0])
        d = COMPAT_SRC / kind / pid
        r = compat_scan(kind, d, compat_manifest(d)[1])
        print(json.dumps(r) if js else "\n".join([r["status"]] + ["· " + x for x in r["issues"] + r["notes"]]))
        return 0
    die("usage: flamenco compat list | catalog noctalia|dms [--refresh] | install noctalia:ID|dms:ID|GIT_URL[#ID]|FOLDER"
        " | update KEY|all | remove KEY | scan KEY   (KEY: noctalia/ID or dms/ID; --json for JSON)")


# ─────────────────────────────── fingerprints (fprintd) ──────────────────────
# Enrolling goes through fprintd's own tools (fprintd-list / -enroll / -delete),
# which talk to fprintd over D-Bus as you; polkit lets the active session manage
# its own prints. Nothing here touches /etc/pam.d: the lock screen uses its own
# PAM file (shell/assets/pam/fingerprint), and greetd's is only read.

FINGERS = ("right-index-finger", "left-index-finger", "right-thumb", "left-thumb",
           "right-middle-finger", "left-middle-finger", "right-ring-finger", "left-ring-finger",
           "right-little-finger", "left-little-finger")
ENROLL_FAIL = ("enroll-failed", "enroll-data-full", "enroll-disconnected", "enroll-unknown-error", "enroll-duplicate")
PAM_DIR = Path(os.environ.get("FLAMENCO_PAM_DIR", "/etc/pam.d"))


def pam_uses(service: str, module: str, depth: int = 0) -> bool:
    """True if /etc/pam.d/SERVICE's auth stack loads MODULE, following include / substack."""
    if depth > 6:
        return False
    try:
        text = (PAM_DIR / service).read_text(errors="ignore")
    except OSError:
        return False
    for line in text.splitlines():
        words = line.split("#", 1)[0].split()
        if not words:
            continue
        if words[0] == "@include" and len(words) > 1 and pam_uses(words[1], module, depth + 1):
            return True
        if words[0].lstrip("-") != "auth" or len(words) < 3:
            continue
        if words[1] in ("include", "substack"):
            if pam_uses(words[2], module, depth + 1):
                return True
        elif any(os.path.basename(w) == module for w in words[2:]):
            return True
    return False


def fprint_props(path: str) -> dict:
    out = run_out(["gdbus", "introspect", "--system", "--dest", "net.reactivated.Fprint", "--object-path", path, "--only-properties"])
    props = dict(re.findall(r"readonly \w+ ([\w-]+) = '?([^';]*)'?;", out))
    try:
        stages = int(props.get("num-enroll-stages", "0"))
    except ValueError:
        stages = 0
    return {"device": props.get("name", ""), "stages": max(stages, 0), "scanType": props.get("scan-type", "")}


def fprint_status() -> dict:
    me = os.environ.get("USER") or HOME.name
    st = {"installed": shutil.which("fprintd-list") is not None, "user": me, "device": "", "path": "", "stages": 0,
          "scanType": "", "fingers": [], "error": "",
          "pam": {"login": pam_uses("login", "pam_fprintd.so"), "greetd": pam_uses("greetd", "pam_fprintd.so")}}
    if not st["installed"]:
        return st
    try:
        p = subprocess.run(["fprintd-list", me], capture_output=True, text=True, timeout=15)
        text = p.stdout + p.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        st["error"] = f"fprintd didn't answer: {e}"
        return st
    if re.search(r"No devices available", text):
        st["error"] = "no reader"
        return st
    m = re.search(r"^Device at (\S+)", text, re.M)
    if m:
        st["path"] = m.group(1)
        st.update(fprint_props(m.group(1)))
    if not st["device"]:
        d = re.search(r"Fingerprints for user \S+ on (.+?) \((\w+)\):", text) or re.search(r"has no fingers enrolled for (.+?)\.?\s*$", text, re.M)
        if d:
            st["device"] = d.group(1)
            if d.lastindex and d.lastindex > 1:
                st["scanType"] = d.group(2)
    st["fingers"] = [f for f in re.findall(r"^\s*- #\d+: (\S+)", text, re.M) if f in FINGERS]
    if not st["device"] and p.returncode != 0:
        st["error"] = text.strip().splitlines()[-1] if text.strip() else f"fprintd-list exited with {p.returncode}"
    return st


def fprint_enroll(finger: str) -> int:
    """Run fprintd-enroll, printing one line per event: KIND <TAB> DETAIL.
    KIND is start | stage | retry | done | fail | info."""
    import signal
    me = os.environ.get("USER") or HOME.name
    proc = subprocess.Popen(["fprintd-enroll", "-f", finger, me], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)

    # cancelling (SIGTERM from the settings page) must release the reader too
    def stop(*_):
        proc.terminate()
        sys.exit(130)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    result = ""
    for line in proc.stdout:
        line = line.strip()
        m = re.search(r"Enroll result: (\S+)", line)
        if m:
            result = m.group(1)
            kind = "done" if result == "enroll-completed" else "stage" if result == "enroll-stage-passed" \
                else "fail" if result in ENROLL_FAIL else "retry"
            print(f"{kind}\t{result}", flush=True)
        elif line.startswith("Enrolling"):
            print(f"start\t{finger}", flush=True)
        elif line and not line.startswith(("Using device", "found ")):
            print(f"info\t{line}", flush=True)
    rc = proc.wait()
    if result != "enroll-completed":
        if not result:
            print("fail\tno-result", flush=True)
        return rc or 1
    return 0


def cmd_fingerprint(args: list[str]) -> int:
    sub = args[0] if args else "status"
    if sub == "status":
        print(json.dumps(fprint_status(), indent=None if "--json" in args else 2))
        return 0
    if sub not in ("enroll", "delete"):
        die("usage: flamenco fingerprint status [--json] | enroll FINGER | delete FINGER|all")
    if not shutil.which("fprintd-list"):
        die(f"fprintd isn't installed ({install_hint('fprintd')})")
    target = args[1] if len(args) > 1 else ""
    if sub == "enroll":
        if target not in FINGERS:
            die("finger must be one of: " + ", ".join(FINGERS))
        return fprint_enroll(target)
    if target != "all" and target not in FINGERS:
        die("finger must be 'all' or one of: " + ", ".join(FINGERS))
    me = os.environ.get("USER") or HOME.name
    cmd = ["fprintd-delete", me] + ([] if target == "all" else ["-f", target])
    rc = subprocess.run(cmd).returncode
    if rc != 0:
        die("fprintd-delete failed" + ("" if target == "all" else " (fprintd older than 1.92 can only remove all fingers)"))
    return 0


# ─────────────────────────────── portals (screen sharing) ────────────────────
# Which xdg-desktop-portal backend handles each feature is set per desktop in
# ~/.config/xdg-desktop-portal/niri-portals.conf.

PORTAL_CONF = XDG_CONFIG / ("xdg-desktop-portal/" + ("hyprland" if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") else "niri") + "-portals.conf")
XDPW_CONF = XDG_CONFIG / "xdg-desktop-portal-wlr/config"
PORTAL_IFACES = {
    "ScreenCast": "org.freedesktop.impl.portal.ScreenCast",
    "Screenshot": "org.freedesktop.impl.portal.Screenshot",
    "FileChooser": "org.freedesktop.impl.portal.FileChooser",
}
# How well each backend's screen capture works on niri.
PORTAL_NIRI = {
    "gnome": ("works", "screens and single windows (needs GNOME libraries)"),
    "wlr": ("works", "whole screens only, very lightweight"),
    "kde": ("no", "its screen capture needs KWin (Plasma's own compositor); its file chooser and other dialogs are fine"),
    "cosmic": ("no", "relies on COSMIC compositor protocols niri doesn't implement"),
    "hyprland": ("works" if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") else "no", "screens and windows on Hyprland" if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") else "Hyprland only"),
    "gtk": ("n/a", "file chooser, settings and other basics; no screen capture"),
}
PORTAL_PACKAGES = {"gnome": "xdg-desktop-portal-gnome", "wlr": "xdg-desktop-portal-wlr", "kde": "xdg-desktop-portal-kde",
                   "gtk": "xdg-desktop-portal-gtk", "cosmic": "xdg-desktop-portal-cosmic"}


def installed_portals() -> list[dict]:
    found = {}
    for d in data_dirs():
        pdir = d / "xdg-desktop-portal/portals"
        if not pdir.is_dir():
            continue
        for f in sorted(pdir.glob("*.portal")):
            if f.stem in found:
                continue
            cp = read_index(f)
            sec = "portal"
            ifaces = [i.strip() for i in cp.get(sec, "Interfaces", fallback="").split(";") if i.strip()]
            found[f.stem] = {"name": f.stem, "interfaces": [i.rsplit(".", 1)[-1] for i in ifaces],
                             "niri": PORTAL_NIRI.get(f.stem, ("unknown", ""))[0],
                             "note": PORTAL_NIRI.get(f.stem, ("unknown", ""))[1]}
    return sorted(found.values(), key=lambda p: p["name"])


def read_portal_conf(path: Path) -> dict:
    cp = read_index(path) if path.is_file() else configparser.RawConfigParser()
    if not cp.has_section("preferred"):
        return {}
    out = {}
    for k, v in cp.items("preferred"):
        out["default" if k == "default" else k.rsplit(".", 1)[-1]] = v.split(";")[0].strip()
    return out


def effective_portals() -> dict:
    """User config if present, else the one niri ships."""
    if PORTAL_CONF.is_file():
        return {"source": str(PORTAL_CONF), **read_portal_conf(PORTAL_CONF)}
    for d in data_dirs():
        f = d / "xdg-desktop-portal" / PORTAL_CONF.name
        if f.is_file():
            return {"source": str(f), **read_portal_conf(f)}
    return {"source": ""}


def portals_diagnose() -> int:
    """What's actually serving screen sharing, and what the portals logged: for a frozen
    or failing share, run it while sharing (or right after)."""
    def run(*cmd, timeout=10):
        try:
            r = subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout)
            return (r.stdout + r.stderr).strip()
        except (OSError, subprocess.TimeoutExpired) as e:
            return f"({e})"
    print("== Flamenco", VERSION, "on", compositor())
    print("== portal config:", effective_portals())
    if XDPW_CONF.is_file():
        print("== xdg-desktop-portal-wlr config:\n" + XDPW_CONF.read_text().strip())
    print("== installed backends:", ", ".join(p["name"] for p in installed_portals()) or "none")
    # which backends are running right now (two answering ScreenCast is the classic problem)
    procs = "\n".join(l[:140] for l in run("ps", "-eo", "comm=,args=").splitlines() if l.startswith(("xdg-desktop-por", ".xdg-desktop-po")))
    print("== running portal processes:\n" + (procs or "(none)"))
    for unit in ("xdg-desktop-portal", "xdg-desktop-portal-wlr", "xdg-desktop-portal-gnome", "plasma-xdg-desktop-portal-kde"):
        print(f"== {unit}: " + run("systemctl", "--user", "is-active", unit + ".service"))
    for b in ("niri", "Hyprland"):
        if shutil.which(b):
            print(f"== {b}:", run(b, "--version").splitlines()[0] if run(b, "--version") else "?")
    xdpw = next((p for p in ("/usr/lib/xdg-desktop-portal-wlr", "/usr/libexec/xdg-desktop-portal-wlr") if Path(p).exists()), "")
    if xdpw:
        print("== xdpw:", run(xdpw, "--version") or "?")
    if shutil.which("lspci"):
        print("== GPUs:\n" + run("sh", "-c", "lspci | grep -Ei 'vga|3d|display'"))
    if shutil.which("pw-cli"):
        print("== PipeWire:", run("pw-cli", "info", "0").splitlines()[0:4])
    if shutil.which("journalctl"):
        print("== recent portal logs:")
        print(run("journalctl", "--user", "-b", "--no-pager", "-n", "60", "-u", "xdg-desktop-portal-wlr.service",
                  "-u", "xdg-desktop-portal.service", "-u", "xdg-desktop-portal-gnome.service", timeout=20))
    return 0


def portals_choose() -> int:
    """xdg-desktop-portal-wlr's screen chooser (chooser_type=dmenu): the screens' names come in
    on stdin; print the chosen one (exit 1 to cancel). Flamenco's window asks, through the
    running shell; without the shell, slurp's click (or the first screen) does."""
    import secrets
    import time
    outs = [l.strip() for l in sys.stdin.read().splitlines() if l.strip()]
    if not outs:
        return 1
    # it asks even with one screen: sharing your screen should never happen silently
    rid = secrets.token_hex(8)
    answer = RUN_DIR / f"flamenco-share-{rid}.answer"
    try:
        r = qs("ipc", "call", "share", "pick", rid, ",".join(outs), capture=True)
        asked = r.returncode == 0
    except (SystemExit, OSError):
        asked = False
    if asked:
        deadline = time.time() + 120
        while time.time() < deadline:
            if answer.exists():
                got = answer.read_text(errors="replace").strip()
                answer.unlink(missing_ok=True)
                # only a screen the portal offered
                if got in outs:
                    print(got)
                    return 0
                return 1                      # cancelled
            time.sleep(0.15)
        return 1
    # no shell: click a screen with slurp, else the first one
    if shutil.which("slurp"):
        s = subprocess.run(["slurp", "-f", "%o", "-or"], capture_output=True, text=True)
        if s.returncode == 0 and s.stdout.strip() in outs:
            print(s.stdout.strip())
            return 0
        return 1
    print(outs[0])
    return 0


def cmd_portals(args: list[str]) -> int:
    sub = args[0] if args else "get"
    if sub == "get":
        cur = effective_portals()
        xdpw = read_index(XDPW_CONF) if XDPW_CONF.is_file() else configparser.RawConfigParser()
        env = kdl_block(NIRI_CONFIG.read_text(), "environment") if NIRI_CONFIG.is_file() else None
        gtk_portal = bool(env) and "GTK_USE_PORTAL" in block_line_values(NIRI_CONFIG.read_text(), env, ("GTK_USE_PORTAL",))
        print(json.dumps({
            "gtkUsePortal": gtk_portal,
            "installed": installed_portals(),
            "current": cur,
            "packages": PORTAL_PACKAGES,
            "wlr": {k: v for k, v in (xdpw.items("screencast") if xdpw.has_section("screencast") else [])},
        }))
        return 0
    if sub == "apply":
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco portals apply --json SPEC")
        spec = json.loads(args[args.index("--json") + 1])
        installed = {p["name"] for p in installed_portals()}

        def put(path: Path, content: str):
            # separate from the app-theming manifest; keep a one-time copy of the user's file
            if path.is_file() and MARKER not in path.read_text(errors="ignore")[:200]:
                bak = BACKUP_DIR / "portals" / path.name
                if not bak.exists():
                    bak.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, bak)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)

        lines = [f"# {MARKER}: written by Flamenco Settings → Screen sharing", "[preferred]"]
        dflt = spec.get("default") or "gtk"
        lines.append("default=" + (dflt if dflt == "gtk" else dflt + ";gtk"))
        previous = read_portal_conf(PORTAL_CONF)
        for key, iface in PORTAL_IFACES.items():
            # keys not mentioned keep their current setting
            v = (spec[key] if key in spec else previous.get(key, "")) or ""
            if v:
                if installed and v not in installed:
                    die(f"the {v} portal isn't installed ({PORTAL_PACKAGES.get(v, 'xdg-desktop-portal-' + v)})")
                lines.append(f"{iface}={v}")
        put(PORTAL_CONF, "\n".join(lines) + "\n")

        if "wlr" in (spec.get("ScreenCast"), spec.get("Screenshot")):
            pick = spec.get("wlrOutput") or ""
            fps = int(spec.get("maxFps") or 0)
            sc = ["[screencast]"]
            if pick:
                sc += [f"output_name={pick}", "chooser_type=none"]
            elif (spec.get("wlrChooser") or "flamenco") == "flamenco":
                # Flamenco's "Share your screen" window (`flamenco portals choose`): the portal
                # sends the screens' names in, the chosen one comes back out
                sc += ["chooser_type=dmenu", "chooser_cmd=" + shlex.quote(self_path()) + " portals choose"]
            else:
                # click the screen to share (falls back to the first screen without slurp)
                sc += ["chooser_type=simple", "chooser_cmd=slurp -f %o -or"]
            if fps > 0:
                sc.append(f"max_fps={fps}")
            # compatibility: plain (linear) buffers, for GPUs / drivers / apps that get a frozen
            # picture from xdpw's default buffers (the man page's experimental option)
            if spec.get("forceLinear"):
                sc.append("force_mod_linear=1")
            put(XDPW_CONF, f"# {MARKER}\n" + "\n".join(sc) + "\n")

        # optional: route every GTK app's file dialogs through the portal (niri environment)
        if "gtkUsePortal" in spec and NIRI_CONFIG.is_file():
            text = NIRI_CONFIG.read_text()
            if kdl_block(text, "environment") is None:
                text = text.rstrip("\n") + "\n\nenvironment {\n}\n"
            on = bool(spec["gtkUsePortal"])
            new = set_block_lines(text, kdl_block(text, "environment"), {
                "GTK_USE_PORTAL": 'GTK_USE_PORTAL "1"' if on else None,
                "GDK_DEBUG": 'GDK_DEBUG "portals"' if on else None})
            write_niri_config(new, NIRI_CONFIG.read_text())

        if shutil.which("systemctl"):
            for unit in ("xdg-desktop-portal.service", "xdg-desktop-portal-wlr.service", "xdg-desktop-portal-gnome.service",
                         "plasma-xdg-desktop-portal-kde.service", "xdg-desktop-portal-hyprland.service"):
                subprocess.run(["systemctl", "--user", "try-restart", unit], capture_output=True)
        print(f"portals: wrote {PORTAL_CONF}; restarted xdg-desktop-portal (apps opened before may need a restart)")
        return 0
    if sub == "choose":
        return portals_choose()
    if sub == "diagnose":
        return portals_diagnose()
    die("usage: flamenco portals get | apply --json SPEC | choose")


# ─────────────────────────────── fonts & sounds ──────────────────────────────

def font_families(mono: bool = False) -> list[str]:
    if not shutil.which("fc-list"):
        return []
    args = ["fc-list", ":spacing=mono" if mono else ":", "family"]
    names = set()
    for line in run_out(args).splitlines():
        first = line.split(",")[0].strip()      # fc-list joins localized names with commas
        if first and not first.startswith("."):
            names.add(first)
    return sorted(names, key=str.lower)


def cmd_fonts(args: list[str]) -> int:
    out = {"families": font_families(), "mono": font_families(mono=True)}
    if "--json" in args:
        print(json.dumps(out))
    else:
        print(f"{len(out['families'])} families, {len(out['mono'])} monospace")
    return 0


def bundled_sounds() -> Path | None:
    """The "flamenco" sound theme that ships with the shell (also found from a git checkout)."""
    here = Path(__file__).resolve().parent
    for c in (here.parent / "data/sounds", here.parent / "share/flamenco-shell/sounds",
              XDG_DATA / "flamenco-shell/sounds", Path("/usr/share/flamenco-shell/sounds")):
        if (c / "flamenco/index.theme").is_file():
            return c
    return None


def sound_theme_dirs() -> dict[str, Path]:
    found = {}
    roots = [d / "sounds" for d in [XDG_DATA] + data_dirs()]
    if (b := bundled_sounds()):
        roots.append(b)
    for root in roots:
        if root.is_dir():
            for t in sorted(root.iterdir()):
                if t.name not in found and (t / "index.theme").is_file():
                    found[t.name] = t
    return found


def sound_themes() -> list[dict]:
    out = []
    for name, path in sound_theme_dirs().items():
        cp = read_index(path / "index.theme")
        label = cp.get("Sound Theme", "Name", fallback=name) if cp.has_section("Sound Theme") else name
        out.append({"value": name, "label": label})
    return sorted(out, key=lambda t: t["label"].lower())


# Events the shell plays that not every theme has, with stand-ins to try next.
SOUND_ALIASES = {
    "brightness-change": ["audio-volume-change", "button-pressed"],
    "audio-volume-change": ["button-pressed", "bell"],
    "message-new-instant": ["message", "dialog-information", "bell"],
    "message": ["message-new-instant", "dialog-information", "bell"],
    "dialog-warning": ["dialog-error", "bell"],
    "dialog-error": ["dialog-warning", "bell"],
    "screen-capture": ["camera-shutter"],
    "camera-shutter": ["screen-capture"],
    "complete": ["dialog-information", "bell"],
}


def _sound_in_theme(event: str, theme: str, themes: dict[str, Path]) -> Path | None:
    """freedesktop sound-theme lookup in one theme and the themes it inherits."""
    seen, queue = set(), [theme]
    while queue:
        t = queue.pop(0)
        if t in seen or t not in themes:
            continue
        seen.add(t)
        base = themes[t]
        cp = read_index(base / "index.theme")
        dirs = [d.strip() for d in cp.get("Sound Theme", "Directories", fallback="stereo").split(",") if d.strip()] or ["stereo"]
        for sub in dirs + ["stereo", "."]:
            for ext in ("oga", "ogg", "wav"):
                f = base / sub / f"{event}.{ext}"
                if f.is_file():
                    return f
        queue[:0] = [i.strip() for i in cp.get("Sound Theme", "Inherits", fallback="").split(",") if i.strip()]
    return None


def find_sound(event: str, theme: str) -> Path | None:
    """The chosen theme first; when it isn't installed or lacks the event, fall
    back to freedesktop and then the bundled flamenco theme, so the shell is
    never silent. Each step also tries the event's stand-ins."""
    themes = sound_theme_dirs()
    events = [event] + SOUND_ALIASES.get(event, [])
    for t in dict.fromkeys([theme, "freedesktop", "flamenco"]):
        for e in events:
            if (f := _sound_in_theme(e, t, themes)):
                return f
    return None


def configured_sound_theme() -> str:
    try:
        return json.loads((CONFIG_DIR / "settings.json").read_text()).get("sound", {}).get("theme") or "flamenco"
    except Exception:
        return "flamenco"


def cmd_sound(args: list[str]) -> int:
    sub = args[0] if args else "themes"
    if sub == "themes":
        print(json.dumps(sound_themes()))
        return 0
    if sub in ("play", "find"):
        if len(args) < 2:
            die(f"usage: flamenco sound {sub} EVENT [--theme NAME]")
        theme = args[args.index("--theme") + 1] if "--theme" in args else configured_sound_theme()
        f = find_sound(args[1], theme)
        if sub == "find":
            print(f or "")
            return 0 if f else 1
        if f is None:
            return 1   # quietly: themes don't have every event
        for player in (["pw-play"], ["paplay"], ["aplay", "-q"]):
            if shutil.which(player[0]) and (player[0] != "aplay" or f.suffix == ".wav"):
                subprocess.Popen([*player, str(f)], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return 0
        die("no audio player found (pw-play, paplay or aplay)")
    die("usage: flamenco sound themes | play EVENT | find EVENT")


# ─────────────────────────────── more apps: terminals, launchers, browsers… ──
# Opt-in per app (Settings → App Theming → Other apps). Each gets a color file
# Flamenco owns, plus at most one marked line in the app's own config to load
# it; both are undone by "Restore originals" (the config is backed up first).

EXTRA_APPS = {
    "kitty": "kitty", "ghostty": "ghostty", "alacritty": "alacritty", "foot": "foot", "fuzzel": "fuzzel",
    "pywalfox": "pywalfox", "vesktop": "vesktop", "spicetify": "spicetify", "vscode": "code",
}


def ansi_palette(s: "Spec") -> dict:
    """16 terminal colors in the palette's spirit: red/green/yellow from error/success/warning,
    blue/magenta/cyan nudged towards the accent's hue."""
    import colorsys
    c, dark = s.c, s.dark

    def hls(h):
        r, g, b = (x / 255 for x in hex_to_rgb(h))
        return colorsys.rgb_to_hls(r, g, b)

    ah, al, asat = hls(c["accent"])
    sat = max(0.45, min(0.8, asat))
    light = 0.68 if dark else 0.40

    def hue(deg):
        d = ((ah * 360 - deg + 540) % 360) - 180        # shortest way to the accent's hue
        r, g, b = colorsys.hls_to_rgb(((deg + d * 0.15) % 360) / 360, light, sat)
        return rgb_to_hex((r * 255, g * 255, b * 255))

    normal = [c["surfaceHigh"] if dark else c["text"], c["error"], c["success"], c["warning"],
              hue(215), hue(300), hue(185), mix(c["text"], c["bg"], 0.2) if dark else c["surfaceHighest"]]
    bright = [c["textDim"]] + [shade(x, 0.18 if dark else -0.18) for x in normal[1:7]] + [c["text"] if dark else c["surface"]]
    return {"fg": c["text"], "bg": c["bg"], "cursor": s.caret, "selBg": mix(c["bg"], c["accent"], 0.35),
            "selFg": c["text"], "colors": normal + bright}


def ensure_line(path: Path, line: str, m: dict, at_top: bool = False, replace: str | None = None):
    """Make a config load our file: add `line` once (marked), or put it in place of a
    line matching `replace` (kept as a comment). The config is backed up first."""
    text = path.read_text() if path.exists() else ""
    if line in text.splitlines():
        return
    backup_once(path, m)
    lines = text.splitlines()
    if replace:
        for i, l in enumerate(lines):
            if re.match(replace, l):
                lines[i:i + 1] = [f"# {MARKER}: was: {l}", line]
                break
        else:
            lines = ([f"# {MARKER}: palette", line] + lines) if at_top else (lines + [f"# {MARKER}: palette", line])
    else:
        lines = ([f"# {MARKER}: palette", line] + lines) if at_top else (lines + [f"# {MARKER}: palette", line])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")


def apply_extra_apps(s: "Spec", m: dict) -> list[str]:
    want = s.o.get("apps") or {}
    p = ansi_palette(s)
    col, c = p["colors"], s.c
    bare = lambda h: h.lstrip("#")
    done = []
    head = f"# {MARKER}: Flamenco palette ({s.name}, {'dark' if s.dark else 'light'}). Rewritten on palette changes.\n"

    if want.get("kitty"):
        d = XDG_CONFIG / "kitty"
        body = head + f"foreground {p['fg']}\nbackground {p['bg']}\ncursor {p['cursor']}\nselection_background {p['selBg']}\n" \
            f"selection_foreground {p['selFg']}\nactive_border_color {c['accent']}\ninactive_border_color {c['border']}\n" \
            f"active_tab_background {c['accent']}\nactive_tab_foreground {c['onAccent']}\n" \
            f"inactive_tab_background {c['surfaceHigh']}\ninactive_tab_foreground {c['textDim']}\nurl_color {c['accent']}\n" \
            + "".join(f"color{i} {x}\n" for i, x in enumerate(col))
        write(d / "flamenco-theme.conf", body, m)
        ensure_line(d / "kitty.conf", "include flamenco-theme.conf", m)
        subprocess.run(["pkill", "-USR1", "-x", "kitty"], capture_output=True)      # kitty reloads its config
        done.append("kitty")

    if want.get("ghostty"):
        d = XDG_CONFIG / "ghostty"
        body = head + f"background = {p['bg']}\nforeground = {p['fg']}\ncursor-color = {p['cursor']}\n" \
            f"selection-background = {p['selBg']}\nselection-foreground = {p['selFg']}\n" \
            + "".join(f"palette = {i}={x}\n" for i, x in enumerate(col))
        write(d / "themes/flamenco", body, m)
        ensure_line(d / "config", "theme = flamenco", m, replace=r"^\s*theme\s*=")
        subprocess.run(["pkill", "-USR2", "-x", "ghostty"], capture_output=True)    # ghostty reloads its config
        done.append("ghostty")

    if want.get("alacritty"):
        d = XDG_CONFIG / "alacritty"
        names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
        body = head + f"[colors.primary]\nbackground = \"{p['bg']}\"\nforeground = \"{p['fg']}\"\n\n" \
            f"[colors.cursor]\ncursor = \"{p['cursor']}\"\ntext = \"{p['bg']}\"\n\n" \
            f"[colors.selection]\nbackground = \"{p['selBg']}\"\ntext = \"{p['selFg']}\"\n\n[colors.normal]\n" \
            + "".join(f"{n} = \"{col[i]}\"\n" for i, n in enumerate(names)) + "\n[colors.bright]\n" \
            + "".join(f"{n} = \"{col[i + 8]}\"\n" for i, n in enumerate(names))
        write(d / "flamenco.toml", body, m)
        conf = d / "alacritty.toml"
        text = conf.read_text() if conf.exists() else ""
        imp = f'import = ["{d / "flamenco.toml"}"]'
        if "flamenco.toml" not in text:
            backup_once(conf, m)
            if re.search(r"(?m)^\[general\]", text):
                if re.search(r"(?ms)^\[general\][^\[]*^\s*import\s*=", text):
                    done.append("alacritty (add flamenco.toml to general.import yourself)")
                    imp = ""
                else:
                    text = re.sub(r"(?m)^\[general\]\s*$", f"[general]\n# {MARKER}: palette\n{imp}", text, count=1)
            else:
                text = f"# {MARKER}: palette\n[general]\n{imp}\n\n" + text
            if imp:
                conf.parent.mkdir(parents=True, exist_ok=True)
                conf.write_text(text)
        if not done or not done[-1].startswith("alacritty"):
            done.append("alacritty")                # it reloads by itself

    if want.get("foot"):
        d = XDG_CONFIG / "foot"
        ver = re.search(r"(\d+)\.(\d+)", run_out(["foot", "--version"]) if shutil.which("foot") else "")
        section = "colors-dark" if ver and (int(ver.group(1)), int(ver.group(2))) >= (1, 20) else "colors"
        body = head + f"[{section}]\nforeground={bare(p['fg'])}\nbackground={bare(p['bg'])}\n" \
            f"selection-foreground={bare(p['selFg'])}\nselection-background={bare(p['selBg'])}\n" \
            + "".join(f"regular{i}={bare(x)}\n" for i, x in enumerate(col[:8])) \
            + "".join(f"bright{i}={bare(x)}\n" for i, x in enumerate(col[8:])) \
            + f"\n[cursor]\ncolor={bare(p['bg'])} {bare(p['cursor'])}\n"
        write(d / "flamenco.ini", body, m)
        ensure_line(d / "foot.ini", f"include={d / 'flamenco.ini'}", m, at_top=True)
        done.append("foot (new windows)")

    if want.get("fuzzel"):
        d = XDG_CONFIG / "fuzzel"
        a = lambda h, alpha="ff": bare(h) + alpha
        body = head + f"[colors]\nbackground={a(c['surface'], 'f2')}\ntext={a(c['text'])}\nprompt={a(c['textDim'])}\n" \
            f"placeholder={a(c['textDim'])}\ninput={a(c['text'])}\nmatch={a(c['accent'])}\nselection={a(c['accent'])}\n" \
            f"selection-text={a(c['onAccent'])}\nselection-match={a(c['onAccent'])}\nborder={a(c['accent'])}\n"
        write(d / "flamenco.ini", body, m)
        ensure_line(d / "fuzzel.ini", f"include={d / 'flamenco.ini'}", m, at_top=True)
        done.append("fuzzel")

    if want.get("pywalfox"):
        wal = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "wal/colors.json"
        data = {"wallpaper": "", "alpha": "100",
                "special": {"background": p["bg"], "foreground": p["fg"], "cursor": p["cursor"]},
                "colors": {f"color{i}": x for i, x in enumerate(col)}}
        # pywalfox reads color1–7 as accents: lead with the palette's own
        data["colors"]["color1"], data["colors"]["color2"] = c["accent"], c.get("accent2", c["accent"])
        write(wal, json.dumps(data, indent=2), m)
        if shutil.which("pywalfox"):
            subprocess.run(["pywalfox", "update"], capture_output=True, timeout=20)
        done.append("Firefox (pywalfox)")

    if want.get("vesktop"):
        css = "/**\n * @name Flamenco\n * @author flamenco-shell\n * @description Colors from your Flamenco palette (" + MARKER + ")\n */\n" \
            ":root, .theme-dark, .theme-light, .visual-refresh {\n" \
            f"  --background-primary: {c['bg']};\n  --background-secondary: {c['surface']};\n" \
            f"  --background-secondary-alt: {c['surfaceHigh']};\n  --background-tertiary: {shade(c['bg'], -0.15 if s.dark else 0.0)};\n" \
            f"  --background-floating: {c['surfaceHigh']};\n  --background-base-lowest: {shade(c['bg'], -0.15 if s.dark else 0.0)};\n" \
            f"  --background-base-lower: {c['bg']};\n  --background-base-low: {c['surface']};\n" \
            f"  --background-surface-high: {c['surfaceHigh']};\n  --background-surface-higher: {c['surfaceHighest']};\n" \
            f"  --chat-background-default: {c['bg']};\n  --channeltextarea-background: {c['surfaceHigh']};\n" \
            f"  --background-modifier-hover: {rgba(c['text'], 0.06)};\n  --background-modifier-selected: {rgba(c['accent'], 0.18)};\n" \
            f"  --brand-500: {c['accent']};\n  --brand-560: {shade(c['accent'], -0.1)};\n  --brand-experiment: {c['accent']};\n" \
            f"  --text-normal: {c['text']};\n  --text-default: {c['text']};\n  --text-muted: {c['textDim']};\n" \
            f"  --header-primary: {c['text']};\n  --header-secondary: {c['textDim']};\n" \
            f"  --interactive-normal: {c['textDim']};\n  --interactive-hover: {c['text']};\n  --interactive-active: {c['text']};\n" \
            f"  --text-link: {c['accent']};\n  --border-subtle: {c['border']};\n}}\n"
        wrote = False
        for base in (XDG_CONFIG / "vesktop", XDG_CONFIG / "Vencord", XDG_CONFIG / "equibop"):
            if base.is_dir():
                write(base / "themes/flamenco.theme.css", css, m)
                wrote = True
        done.append("Discord (turn on the Flamenco theme in Vencord → Themes)" if wrote else "Discord (no Vesktop / Vencord folder found)")

    if want.get("spicetify"):
        d = XDG_CONFIG / "spicetify/Themes/Flamenco"
        body = head.replace("#", ";") + "[flamenco]\n" + "".join(f"{k:<16}= {bare(v)}\n" for k, v in (
            ("text", c["text"]), ("subtext", c["textDim"]), ("main", c["bg"]), ("sidebar", c["surface"]),
            ("player", c["surface"]), ("card", c["surfaceHigh"]), ("shadow", c["bg"]), ("selected-row", c["textDim"]),
            ("button", c["accent"]), ("button-active", c["accent"]), ("button-disabled", c["border"]),
            ("tab-active", c["surfaceHighest"]), ("notification", c["accent"]), ("notification-error", c["error"]),
            ("misc", c["border"])))
        write(d / "color.ini", body, m)
        write(d / "user.css", f"/* {MARKER}: Flamenco */\n", m)
        if shutil.which("spicetify"):
            cur = run_out(["spicetify", "config", "current_theme"]).strip()
            if cur == "Flamenco":
                r = subprocess.run(["spicetify", "refresh", "-q"], capture_output=True, text=True, timeout=60)
            else:
                subprocess.run(["spicetify", "config", "current_theme", "Flamenco", "color_scheme", "flamenco"], capture_output=True, timeout=30)
                r = subprocess.run(["spicetify", "apply", "-q"], capture_output=True, text=True, timeout=120)
            done.append("Spotify" if r.returncode == 0 else "Spotify (spicetify failed: run `spicetify apply` in a terminal)")
        else:
            done.append("Spotify (theme written; install spicetify to apply it)")

    if want.get("vscode"):
        ui = "vs-dark" if s.dark else "vs"
        theme = {"name": "Flamenco", "type": "dark" if s.dark else "light", "colors": {
            "editor.background": c["bg"], "editor.foreground": c["text"], "editorCursor.foreground": c["accent"],
            "editor.selectionBackground": p["selBg"], "editor.lineHighlightBackground": c["surface"],
            "editorLineNumber.foreground": c["textDim"], "editorLineNumber.activeForeground": c["text"],
            "sideBar.background": c["surface"], "sideBar.foreground": c["text"], "activityBar.background": c["surface"],
            "activityBar.foreground": c["accent"], "activityBarBadge.background": c["accent"], "activityBarBadge.foreground": c["onAccent"],
            "titleBar.activeBackground": c["surface"], "titleBar.activeForeground": c["text"], "statusBar.background": c["surface"],
            "statusBar.foreground": c["textDim"], "tab.activeBackground": c["bg"], "tab.inactiveBackground": c["surface"],
            "tab.activeBorderTop": c["accent"], "editorGroupHeader.tabsBackground": c["surface"], "panel.background": c["surface"],
            "terminal.background": c["bg"], "terminal.foreground": c["text"], "focusBorder": c["accent"],
            "button.background": c["accent"], "button.foreground": c["onAccent"], "input.background": c["surfaceHigh"],
            "dropdown.background": c["surfaceHigh"], "list.activeSelectionBackground": rgba(c["accent"], 0.25),
            "list.hoverBackground": rgba(c["text"], 0.06), "textLink.foreground": c["accent"], "badge.background": c["accent"],
            "badge.foreground": c["onAccent"], "progressBar.background": c["accent"], "editorWidget.background": c["surfaceHigh"],
            **{f"terminal.ansi{n}": col[i] for i, n in enumerate(["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White"])},
            **{f"terminal.ansiBright{n}": col[i + 8] for i, n in enumerate(["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White"])}},
            "tokenColors": [
                {"scope": ["comment"], "settings": {"foreground": c["textDim"], "fontStyle": "italic"}},
                {"scope": ["keyword", "storage", "storage.type"], "settings": {"foreground": c["accent"]}},
                {"scope": ["string"], "settings": {"foreground": col[2]}},
                {"scope": ["constant.numeric", "constant.language"], "settings": {"foreground": col[3]}},
                {"scope": ["entity.name.function", "support.function"], "settings": {"foreground": col[4]}},
                {"scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": {"foreground": col[6]}},
                {"scope": ["variable.parameter"], "settings": {"foreground": col[5]}},
                {"scope": ["invalid"], "settings": {"foreground": c["error"]}}]}
        pkg = {"name": "flamenco-theme", "displayName": "Flamenco", "publisher": "flamenco-shell", "version": "1.0.0",
               "engines": {"vscode": "^1.60.0"}, "categories": ["Themes"],
               "contributes": {"themes": [{"label": "Flamenco", "uiTheme": ui, "path": "./themes/flamenco.json"}]}}
        found = False
        for base in (HOME / ".vscode/extensions", HOME / ".vscode-oss/extensions", HOME / ".cursor/extensions"):
            if base.parent.is_dir():
                ext = base / "flamenco-shell.flamenco-theme-1.0.0"
                write(ext / "package.json", json.dumps(pkg, indent=2), m)
                write(ext / "themes/flamenco.json", json.dumps(theme, indent=2), m)
                found = True
        done.append("VS Code (pick the Flamenco color theme once)" if found else "VS Code (no ~/.vscode or ~/.vscode-oss found)")
    return done


def apply_sound(s: "Spec", m: dict) -> list[str]:
    """Tell GTK, GNOME and KDE apps which sound theme to use."""
    theme = s.o.get("soundTheme") or ""
    if not theme:
        return []
    events = bool(s.o.get("eventSounds", True))
    for v in ("gtk-3.0", "gtk-4.0"):
        ini_update(XDG_CONFIG / v / "settings.ini", {"Settings": {
            "gtk-sound-theme-name": theme,
            "gtk-enable-event-sounds": "true" if events else "false"}}, m)
    global _GS_MANIFEST
    _GS_MANIFEST = m
    gsettings("org.gnome.desktop.sound", "theme-name", theme)
    gsettings("org.gnome.desktop.sound", "event-sounds", "true" if events else "false")
    ini_update(XDG_CONFIG / "kdeglobals", {"Sounds": {"Theme": theme, "Enable": "true" if events else "false"}}, m)
    return ["sound"]


# ─────────────────────────────── firewall (ufw / firewalld) ──────────────────
# Reads what it can without root; changes run through `sudo` in one batch.

FW_CACHE = XDG_CACHE / "flamenco/firewall-ufw.json"
PORT_RE = re.compile(r"^\d{1,5}(:\d{1,5})?(/(tcp|udp))?$")
NAME_RE = re.compile(r"^[A-Za-z0-9_.:-]+$")


def unit_state(unit: str) -> dict:
    return {"active": run_out(["systemctl", "is-active", unit]).strip() == "active",
            "enabled": run_out(["systemctl", "is-enabled", unit]).strip() == "enabled"}


def parse_ufw_numbered(text: str) -> list[dict]:
    rules = []
    for line in text.splitlines():
        m = re.match(r"\[\s*(\d+)\]\s+(.+?)\s{2,}(ALLOW|DENY|REJECT|LIMIT)(?:\s+(IN|OUT|FWD))?\s+(.+?)\s*(?:#\s*(.*))?$", line)
        if m:
            num, to, action, direction, frm, comment = m.groups()
            rules.append({"num": int(num), "to": to.strip(), "action": action, "direction": direction or "IN",
                          "from": frm.strip(), "v6": "(v6)" in to, "comment": (comment or "").strip()})
    return rules


def parse_ufw_verbose(text: str) -> dict:
    out = {}
    m = re.search(r"^Status:\s*(\w+)", text, re.M)
    if m:
        out["active"] = m.group(1) == "active"
    m = re.search(r"^Logging:\s*(\w+)(?:\s*\((\w+)\))?", text, re.M)
    if m:
        out["logging"] = m.group(2) if m.group(1) == "on" and m.group(2) else m.group(1)
    m = re.search(r"^Default:\s*(\w+) \(incoming\),\s*(\w+) \(outgoing\)", text, re.M)
    if m:
        out["incoming"], out["outgoing"] = m.group(1), m.group(2)
    return out


def ufw_state() -> dict:
    st = {"installed": True, "service": unit_state("ufw.service"), "rules": None, "rulesTime": 0}
    raw = Path("/etc/ufw/ufw.conf").read_text(errors="ignore") if Path("/etc/ufw/ufw.conf").exists() else ""
    st["enabled"] = bool(re.search(r"^ENABLED=yes", raw, re.M))
    lvl = re.search(r"^LOGLEVEL=(\w+)", raw, re.M)
    st["logging"] = lvl.group(1) if lvl else "low"
    pol = Path("/etc/default/ufw").read_text(errors="ignore") if Path("/etc/default/ufw").exists() else ""
    words = {"DROP": "deny", "REJECT": "reject", "ACCEPT": "allow"}
    for key, name in (("DEFAULT_INPUT_POLICY", "incoming"), ("DEFAULT_OUTPUT_POLICY", "outgoing")):
        m = re.search(rf'^{key}="?(\w+)"?', pol, re.M)
        st[name] = words.get(m.group(1), m.group(1).lower()) if m else ""
    # rules need root: try directly (works when run as root), else the last saved copy
    r = subprocess.run(["ufw", "status", "numbered"], capture_output=True, text=True)
    if r.returncode == 0:
        st["rules"] = parse_ufw_numbered(r.stdout)
        st["rulesTime"] = int(__import__("time").time())
    elif FW_CACHE.is_file():
        try:
            cached = json.loads(FW_CACHE.read_text())
            st["rules"] = cached.get("rules")
            st["rulesTime"] = cached.get("time", 0)
            st.update({k: v for k, v in cached.get("verbose", {}).items() if k in ("incoming", "outgoing", "logging")})
        except Exception:
            pass
    return st


def firewalld_state() -> dict:
    fc = lambda *a: subprocess.run(["firewall-cmd", *a], capture_output=True, text=True)
    st = {"installed": True, "service": unit_state("firewalld.service"), "readable": False,
          "defaultZone": "", "zones": [], "activeZones": {}, "services": [], "zoneInfo": {}}
    if not st["service"]["active"]:
        return st
    r = fc("--get-default-zone")
    if r.returncode != 0:
        return st          # D-Bus/polkit refused; the page offers to load with sudo
    st["readable"] = True
    st["defaultZone"] = r.stdout.strip()
    st["zones"] = fc("--get-zones").stdout.split()
    st["services"] = fc("--get-services").stdout.split()
    current = None
    for line in fc("--get-active-zones").stdout.splitlines():
        if line and not line.startswith((" ", "\t")):
            current = line.split()[0]
            st["activeZones"][current] = []
        elif current and "interfaces:" in line:
            st["activeZones"][current] = line.split(":", 1)[1].split()
    for z in st["zones"]:
        if z:
            st["zoneInfo"][z] = {"ports": fc("--zone=" + z, "--list-ports").stdout.split(),
                                 "services": fc("--zone=" + z, "--list-services").stdout.split(),
                                 "target": fc("--zone=" + z, "--get-target", "--permanent").stdout.strip()}
    return st


def firewall_state() -> dict:
    has_ufw, has_fwd = bool(shutil.which("ufw")), bool(shutil.which("firewall-cmd"))
    st = {"ufw": ufw_state() if has_ufw else {"installed": False},
          "firewalld": firewalld_state() if has_fwd else {"installed": False}}
    active = [n for n in ("firewalld", "ufw") if st[n].get("installed") and st[n].get("service", {}).get("active")]
    st["backend"] = active[0] if active else ("firewalld" if has_fwd else "ufw" if has_ufw else "")
    st["conflict"] = len(active) > 1
    return st


def firewall_commands(backend: str, op: dict) -> list[list[str]]:
    """Validated root commands for one queued change."""
    kind = op.get("op")
    port, zone, name = str(op.get("port", "")), str(op.get("zone", "")), str(op.get("name", ""))
    for v, label in ((zone, "zone"), (name, "name")):
        if v and not NAME_RE.match(v):
            raise ValueError(f"invalid {label}: {v!r}")
    if port and not PORT_RE.match(port):
        raise ValueError(f"invalid port: {port!r} (use 8080, 8080/tcp or 6000:6010/udp)")
    if backend == "ufw":
        if kind == "enable":
            return [["systemctl", "enable", "--now", "ufw.service"], ["ufw", "--force", "enable"]]
        if kind == "disable":
            return [["ufw", "disable"]]
        if kind == "default":
            pol, direction = op.get("policy"), op.get("direction")
            if pol not in ("allow", "deny", "reject") or direction not in ("incoming", "outgoing"):
                raise ValueError("bad default policy")
            return [["ufw", "default", pol, direction]]
        if kind == "logging":
            if op.get("level") not in ("off", "low", "medium", "high", "full"):
                raise ValueError("bad logging level")
            return [["ufw", "logging", op["level"]]]
        if kind == "add":
            action = op.get("action", "allow")
            if action not in ("allow", "deny", "reject", "limit"):
                raise ValueError("bad rule action")
            src = str(op.get("from", "") or "")
            if src and not re.fullmatch(r"[0-9a-fA-F.:/]+", src):
                raise ValueError(f"invalid source address: {src!r}")
            target = port if port else name
            if ":" in port and "/" not in port:
                raise ValueError("ufw needs a protocol for port ranges, e.g. 6000:6010/tcp")
            if not target:
                raise ValueError("a rule needs a port or a service name")
            cmd = ["ufw", action]
            if src:
                p, _, proto = port.partition("/")
                cmd = ["ufw", action, "from", src, "to", "any", "port", p] + (["proto", proto] if proto else [])
            else:
                cmd.append(target)
            if op.get("comment"):
                cmd += ["comment", str(op["comment"])[:60]]
            return [cmd]
        if kind == "delete":
            return [["ufw", "--force", "delete", str(int(op["num"]))]]
    if backend == "firewalld":
        if kind == "enable":
            return [["systemctl", "enable", "--now", "firewalld.service"]]
        if kind == "disable":
            return [["systemctl", "disable", "--now", "firewalld.service"]]
        z = ["--zone=" + zone] if zone else []
        if kind == "set-default-zone":
            return [["firewall-cmd", "--set-default-zone=" + zone]]
        if kind == "zone-interface":
            iface = str(op.get("interface", ""))
            if not NAME_RE.match(iface):
                raise ValueError("bad interface")
            return [["firewall-cmd", *z, "--change-interface=" + iface, "--permanent"]]
        flag = {"add-port": "--add-port=", "remove-port": "--remove-port=",
                "add-service": "--add-service=", "remove-service": "--remove-service="}.get(kind)
        if flag:
            val = port if "port" in kind else name
            if not val:
                raise ValueError(f"{kind} needs a value")
            if "port" in kind and "/" not in val:
                val += "/tcp"
            return [["firewall-cmd", *z, flag + val, "--permanent"]]
    raise ValueError(f"unknown change {kind!r} for {backend}")


def save_ufw_cache():
    """As the user, with sudo's cached credentials: keep a readable copy of ufw's status."""
    numbered = subprocess.run(["sudo", "-n", "ufw", "status", "numbered"], capture_output=True, text=True)
    verbose = subprocess.run(["sudo", "-n", "ufw", "status", "verbose"], capture_output=True, text=True)
    if numbered.returncode == 0:
        FW_CACHE.parent.mkdir(parents=True, exist_ok=True)
        FW_CACHE.write_text(json.dumps({"time": int(__import__("time").time()), "rules": parse_ufw_numbered(numbered.stdout),
                                        "verbose": parse_ufw_verbose(verbose.stdout)}))


def cmd_firewall(args: list[str]) -> int:
    sub = args[0] if args else "status"
    if sub == "status":
        st = firewall_state()
        if "--json" in args:
            print(json.dumps(st))
        else:
            print(f"backend: {st['backend'] or 'none installed'}" + ("  (both ufw and firewalld are running!)" if st["conflict"] else ""))
            b = st.get(st["backend"], {}) if st["backend"] else {}
            if b:
                print(f"service: {'active' if b['service']['active'] else 'inactive'}, {'enabled' if b['service']['enabled'] else 'disabled'} at boot")
        return 0
    if sub == "apply":
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco firewall apply --json '{\"backend\": \"ufw\", \"ops\": [...]}'")
        spec = json.loads(args[args.index("--json") + 1])
        backend = spec.get("backend")
        if backend not in ("ufw", "firewalld"):
            die("backend must be ufw or firewalld")
        try:
            cmds = [c for op in spec.get("ops", []) for c in firewall_commands(backend, op)]
        except ValueError as e:
            die(str(e))
        # ufw rule numbers shift as rules are deleted: delete from the highest number down
        dels = sorted([c for c in cmds if c[:3] == ["ufw", "--force", "delete"]], key=lambda c: -int(c[3]))
        cmds = [c for c in cmds if c[:3] != ["ufw", "--force", "delete"]] + dels
        if backend == "firewalld" and any("--permanent" in c for c in cmds):
            cmds.append(["firewall-cmd", "--reload"])
        failed = 0
        for c in cmds:
            print("→ " + " ".join(c), flush=True)
            if privileged(c) != 0:
                failed += 1
        if backend == "ufw" and shutil.which("sudo"):
            save_ufw_cache()
        print("done" if not failed else f"{failed} step(s) failed")
        return 1 if failed else 0
    if sub == "load":
        # read ufw rules with sudo once and keep a copy the settings page can read
        if shutil.which("ufw"):
            if privileged(["true"]) == 0:
                save_ufw_cache()
                print("loaded ufw rules")
        return 0
    die("usage: flamenco firewall status [--json] | apply --json SPEC | load")


# ─────────────────────────────── lid & power button (logind) ─────────────────

LOGIND_DROPIN = Path("/etc/systemd/logind.conf.d/90-flamenco.conf")
LOGIND_KEYS = ("HandleLidSwitch", "HandleLidSwitchExternalPower", "HandleLidSwitchDocked", "HandlePowerKey")
LOGIND_ACTIONS = ("suspend", "hibernate", "hybrid-sleep", "suspend-then-hibernate", "lock", "ignore", "poweroff")


def logind_settings() -> dict:
    """Effective logind values: defaults, then logind.conf, then drop-ins in name order."""
    vals = {"HandleLidSwitch": "suspend", "HandleLidSwitchExternalPower": "", "HandleLidSwitchDocked": "ignore",
            "HandlePowerKey": "poweroff"}
    files = [Path("/etc/systemd/logind.conf")]
    dropins = {}
    for d in (Path("/usr/lib/systemd/logind.conf.d"), Path("/run/systemd/logind.conf.d"), Path("/etc/systemd/logind.conf.d")):
        if d.is_dir():
            for f in d.glob("*.conf"):
                dropins[f.name] = f
    files += [dropins[k] for k in sorted(dropins)]
    for f in files:
        try:
            for line in f.read_text(errors="ignore").splitlines():
                m = re.match(r"^\s*(\w+)\s*=\s*(\S*)", line)
                if m and m.group(1) in vals:
                    vals[m.group(1)] = m.group(2)
        except OSError:
            pass
    if not vals["HandleLidSwitchExternalPower"]:
        vals["HandleLidSwitchExternalPower"] = vals["HandleLidSwitch"]
    return vals


def cmd_power(args: list[str]) -> int:
    if args[:2] == ["logind", "get"]:
        out = logind_settings()
        out["hasLid"] = any(Path("/proc/acpi/button/lid").glob("*")) if Path("/proc/acpi/button/lid").is_dir() else False
        out["managed"] = LOGIND_DROPIN.is_file()
        print(json.dumps(out))
        return 0
    if args[:2] == ["logind", "apply"]:
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco power logind apply --json '{\"HandleLidSwitch\": \"suspend\", …}'")
        spec = json.loads(args[args.index("--json") + 1])
        lines = [f"# {MARKER}: written by Flamenco Settings → Power", "[Login]"]
        for k in LOGIND_KEYS:
            v = spec.get(k)
            if v is None:
                continue
            if v not in LOGIND_ACTIONS:
                die(f"{k}: unsupported action {v!r}")
            lines.append(f"{k}={v}")
        tmp = XDG_CACHE / "flamenco/90-flamenco.conf"
        tmp.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text("\n".join(lines) + "\n")
        print("→ writing " + str(LOGIND_DROPIN))
        if privileged(["install", "-Dm644", str(tmp), str(LOGIND_DROPIN)]) != 0:
            die("could not write the logind settings")
        # SIGHUP makes logind re-read its config without ending your session
        print("→ reloading systemd-logind")
        privileged(["systemctl", "kill", "-s", "HUP", "systemd-logind.service"])
        print("done")
        return 0
    if args[:2] == ["logind", "reset"]:
        if LOGIND_DROPIN.exists():
            privileged(["rm", "-f", str(LOGIND_DROPIN)])
            privileged(["systemctl", "kill", "-s", "HUP", "systemd-logind.service"])
        print("logind back to system defaults")
        return 0
    die("usage: flamenco power logind get | apply --json SPEC | reset")


# ─────────────────────────────── keyring (Secret Service) ────────────────────
# Apps store passwords through org.freedesktop.secrets; whichever daemon owns
# that name is "the keyring". A per-user D-Bus activation file decides which
# one starts when an app asks.

SECRETS_OVERRIDE = XDG_DATA / "dbus-1/services/org.freedesktop.secrets.service"

KEYRINGS = {
    "gnome": {"label": "GNOME Keyring", "package": "gnome-keyring", "bins": ["gnome-keyring-daemon"],
              "exec": "{bin} --start --foreground --components=secrets", "systemd": "gnome-keyring-daemon.service",
              "manager": ["seahorse"], "managerPackage": "seahorse", "pam": "pam_gnome_keyring.so",
              "note": "The common choice; COSMIC uses it too."},
    "kde": {"label": "KDE Wallet", "package": "kwallet", "bins": ["kwalletd6", "kwalletd5"],
            "exec": "{bin}", "systemd": "", "manager": ["kwalletmanager"], "managerPackage": "kwalletmanager",
            "pam": "pam_kwallet5.so", "note": "Flamenco turns on its Secret Service support."},
    "keepassxc": {"label": "KeePassXC", "package": "keepassxc", "bins": ["keepassxc"],
                  "exec": "{bin}", "systemd": "", "manager": ["keepassxc"], "managerPackage": "keepassxc",
                  "pam": "", "note": "Also turn on Settings → Secret Service Integration inside KeePassXC."},
    "oo7": {"label": "oo7", "package": "oo7", "bins": ["oo7-daemon"],
            "exec": "{bin}", "systemd": "", "manager": [], "managerPackage": "",
            "pam": "pam_oo7.so", "note": "A newer Rust implementation of the Secret Service."},
}


def keyring_bin(kind: str) -> str:
    for b in KEYRINGS[kind]["bins"]:
        p = shutil.which(b) or next((str(x) for x in (Path("/usr/lib") / b, Path("/usr/libexec") / b) if x.exists()), "")
        if p:
            return p
    return ""


def secrets_owner() -> dict:
    """Which process currently answers org.freedesktop.secrets."""
    out = run_out(["busctl", "--user", "status", "org.freedesktop.secrets"]) if shutil.which("busctl") else ""
    comm = re.search(r"^Comm=(\S+)", out, re.M)
    pid = re.search(r"^PID=(\d+)", out, re.M)
    name = comm.group(1) if comm else ""
    kind = next((k for k, v in KEYRINGS.items() if any(name and (name in b or b.startswith(name)) for b in v["bins"])), "")
    return {"process": name, "pid": int(pid.group(1)) if pid else 0, "kind": kind}


def pam_unlock() -> dict:
    """Login-time unlock: which PAM modules are configured, per service file."""
    found = {}
    for svc in ("login", "system-login", "sddm", "greetd", "gdm-password", "lightdm", "ly"):
        f = Path("/etc/pam.d") / svc
        try:
            text = f.read_text(errors="ignore")
        except OSError:
            continue
        mods = [k for k, v in KEYRINGS.items() if v["pam"] and re.search(r"^\s*[^#].*" + re.escape(v["pam"]), text, re.M)]
        found[svc] = mods
    return found


def cmd_keyring(args: list[str]) -> int:
    sub = args[0] if args else "get"
    if sub == "get":
        chosen = ""
        if SECRETS_OVERRIDE.is_file():
            m = re.search(r"^# flamenco-keyring: (\w+)", SECRETS_OVERRIDE.read_text(), re.M)
            chosen = m.group(1) if m else "custom"
        print(json.dumps({
            "chosen": chosen,
            "owner": secrets_owner(),
            "pam": pam_unlock(),
            "keyrings": [{"value": k, "label": v["label"], "package": v["package"], "installed": bool(keyring_bin(k)),
                          "manager": v["manager"], "managerPackage": v["managerPackage"],
                          "managerInstalled": bool(v["manager"]) and bool(shutil.which(v["manager"][0])),
                          "pam": v["pam"], "note": v["note"]} for k, v in KEYRINGS.items()],
        }))
        return 0
    if sub == "use":
        if len(args) < 2 or args[1] not in (*KEYRINGS, "none", "default"):
            die("usage: flamenco keyring use gnome|kde|keepassxc|oo7|none|default")
        kind = args[1]
        if kind == "default":
            if SECRETS_OVERRIDE.is_file():
                SECRETS_OVERRIDE.unlink()
            for unit in ("gnome-keyring-daemon.socket", "gnome-keyring-daemon.service"):
                subprocess.run(["systemctl", "--user", "unmask", unit], capture_output=True)
            print("keyring: back to the system default")
            return 0
        SECRETS_OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
        if kind == "none":
            # an activation entry that can't start anything: no keyring gets launched on demand
            SECRETS_OVERRIDE.write_text("# flamenco-keyring: none\n[D-BUS Service]\nName=org.freedesktop.secrets\nExec=/bin/false\n")
        else:
            b = keyring_bin(kind)
            if not b:
                die(f"{KEYRINGS[kind]['label']} isn't installed ({install_hint(KEYRINGS[kind]['package'])})")
            lines = [f"# flamenco-keyring: {kind}", "[D-BUS Service]", "Name=org.freedesktop.secrets",
                     "Exec=" + KEYRINGS[kind]["exec"].format(bin=b)]
            if KEYRINGS[kind]["systemd"]:
                lines.append("SystemdService=" + KEYRINGS[kind]["systemd"])
            SECRETS_OVERRIDE.write_text("\n".join(lines) + "\n")

        # KDE Wallet only answers Secret Service requests when its API is on
        # (not tracked in the app-theming manifest, so "Restore originals" there won't switch keyrings)
        untracked = {"files": [], "backups": {}}
        if kind == "kde":
            ini_update(XDG_CONFIG / "kwalletrc", {"Wallet": {"Enabled": "true"},
                                                   "org.freedesktop.secrets": {"apiEnabled": "true"}}, untracked)
        elif (XDG_CONFIG / "kwalletrc").is_file():
            ini_update(XDG_CONFIG / "kwalletrc", {"org.freedesktop.secrets": {"apiEnabled": "false"}}, untracked)

        # GNOME Keyring also starts from its own systemd socket; keep it out of the way when not chosen
        for unit in ("gnome-keyring-daemon.socket", "gnome-keyring-daemon.service"):
            if kind == "gnome":
                subprocess.run(["systemctl", "--user", "unmask", unit], capture_output=True)
            else:
                subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True)
                subprocess.run(["systemctl", "--user", "mask", unit], capture_output=True)

        # hand the name over now: stop whichever other keyring holds it
        owner = secrets_owner()
        if owner["pid"] and owner["kind"] != kind:
            try:
                os.kill(owner["pid"], 15)
            except OSError:
                pass
        if shutil.which("busctl"):
            # make D-Bus re-read activation files, then (for a real keyring) start it
            subprocess.run(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                            "org.freedesktop.DBus", "ReloadConfig"], capture_output=True)
            if kind != "none":
                subprocess.run(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                                "org.freedesktop.DBus", "StartServiceByName", "su", "org.freedesktop.secrets", "0"],
                               capture_output=True, timeout=15)
        print(f"keyring: {kind} will answer org.freedesktop.secrets")
        return 0
    die("usage: flamenco keyring get | use gnome|kde|keepassxc|oo7|none|default")


# ─────────────────────────────── Hyprland ────────────────────────────────────
# Same features on Hyprland: Settings write small files that hyprland.conf sources.

HYPR_DIR = XDG_CONFIG / "hypr"
HYPR_CONFIG = HYPR_DIR / "hyprland.conf"
HYPR_BINDS = HYPR_DIR / "flamenco-binds.conf"
HYPR_INPUT = HYPR_DIR / "flamenco-input.conf"
HYPR_CURSOR = HYPR_DIR / "flamenco-cursor.conf"
HYPR_MONITORS = HYPR_DIR / "flamenco-monitors.conf"
HYPR_TRANSFORMS = {t: i for i, t in enumerate(TRANSFORMS)}       # normal=0 … flipped-270=7
HYPR_KEYS = {"Comma": "comma", "Period": "period", "Slash": "slash", "BackSlash": "backslash", "Minus": "minus",
             "Equal": "equal", "BracketLeft": "bracketleft", "BracketRight": "bracketright", "Semicolon": "semicolon",
             "Apostrophe": "apostrophe", "Grave": "grave", "Space": "space"}
HYPR_MODS = {"mod": "SUPER", "super": "SUPER", "ctrl": "CTRL", "alt": "ALT", "shift": "SHIFT"}


def compositor() -> str:
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    if os.environ.get("NIRI_SOCKET"):
        return "niri"
    desk = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    return "hyprland" if "hyprland" in desk else "niri"


def hypr_niri_action(action: str) -> str | None:
    """Translate a niri action into a Hyprland dispatcher (None if there's no equivalent)."""
    a = action.split()
    name, args = a[0], a[1:]
    simple = {"close-window": "killactive", "fullscreen-window": "fullscreen, 0", "maximize-column": "fullscreen, 1",
              "toggle-window-floating": "togglefloating", "center-column": "centerwindow",
              "focus-column-left": "movefocus, l", "focus-column-right": "movefocus, r",
              "focus-window-up": "movefocus, u", "focus-window-down": "movefocus, d",
              "move-column-left": "movewindow, l", "move-column-right": "movewindow, r",
              "focus-workspace-down": "workspace, e+1", "focus-workspace-up": "workspace, e-1",
              "focus-monitor-left": "focusmonitor, l", "focus-monitor-right": "focusmonitor, r",
              "quit": "exit", "power-off-monitors": "dpms, off", "toggle-column-tabbed-display": "togglegroup",
              "screenshot": 'exec, grim -g "$(slurp)" - | wl-copy', "screenshot-screen": "exec, grim - | wl-copy",
              "screenshot-window": 'exec, grim -g "$(hyprctl -j activewindow | jq -r \'"\\(.at[0]),\\(.at[1]) \\(.size[0])x\\(.size[1])"\')" - | wl-copy',
              "switch-layout": "exec, hyprctl switchxkblayout all next"}
    if name in ("focus-workspace", "move-column-to-workspace") and args:
        return ("workspace, " if name == "focus-workspace" else "movetoworkspace, ") + args[0].strip('"')
    return simple.get(name)


def hypr_combo(key: str) -> tuple[str, str]:
    parts = key.split("+")
    mods = " ".join(HYPR_MODS.get(p.lower(), p.upper()) for p in parts[:-1])
    k = parts[-1]
    return mods, HYPR_KEYS.get(k, k)


def hypr_bind_line(sc: dict) -> str:
    mods, key = hypr_combo(sc["key"].strip())
    t, v = sc.get("type"), str(sc.get("value", "")).strip()
    note = f"  # {sc['title']}" if sc.get("title") else ""
    if t == "none":
        return f"unbind = {mods}, {key}"
    flag = "bindl" if sc.get("locked") and t != "niri" else "bind"
    if t == "flamenco":
        if v not in SHELL_FUNCTIONS:
            raise ValueError(f"unknown Flamenco function: {v!r}")
        return f"{flag} = {mods}, {key}, exec, flamenco {' '.join(SHELL_FUNCTIONS[v][1])}{note}"
    if t == "app":
        return f"{flag} = {mods}, {key}, exec, flamenco launch {v}{note}"
    if t == "command":
        return f"{flag} = {mods}, {key}, exec, {v}{note}"
    if t == "niri":
        d = hypr_niri_action(v)
        return f"{flag} = {mods}, {key}, {d}{note}" if d else f"# {sc['key']}: no Hyprland equivalent for niri action '{v}'"
    raise ValueError(f"{sc['key']}: unknown shortcut type {t!r}")


def hypr_write(path: Path, lines: list[str], data: dict | None = None):
    head = [f"# {MARKER}: managed by Flamenco Settings, regenerated on change"]
    if data is not None:
        head.append("# flamenco-json: " + json.dumps(data))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(head + lines) + "\n")


def hypr_read_json(path: Path) -> dict:
    try:
        m = re.search(r"^# flamenco-json: (.*)$", path.read_text(), re.M)
        return json.loads(m.group(1)) if m else {}
    except Exception:
        return {}


def hypr_reload():
    if shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], capture_output=True)


def hypr_apply_shortcuts(shortcuts: list[dict]):
    keys = [norm_key(sc["key"]) for sc in shortcuts]
    dup = {k for k in keys if keys.count(k) > 1}
    if dup:
        raise ValueError("the same key is used twice: " + ", ".join(sorted(dup)))
    lines = []
    # an "unbind" must come before Flamenco's own bind for the same key
    for sc in sorted(shortcuts, key=lambda x: x.get("type") != "none"):
        lines.append(hypr_bind_line(sc))
    # a Flamenco shortcut takes its key even if hyprland.conf binds it: unbind first
    for sc in shortcuts:
        # skip niri actions Hyprland can't do: they bind nothing, so don't take the key away
        if sc.get("type") != "none" and not (sc.get("type") == "niri" and hypr_niri_action(str(sc.get("value", ""))) is None):
            mods, key = hypr_combo(sc["key"])
            lines.insert(0, f"unbind = {mods}, {key}")
    hypr_write(HYPR_BINDS, lines, {"shortcuts": shortcuts})


def hypr_pointer_fields(p: dict | None) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    """(input fields, input:touchpad fields). Hyprland has one global speed/profile: the mouse's."""
    if not p:
        return [], []
    p = pointer_norm(p)
    b = lambda v: "true" if v else "false"
    top = [("sensitivity", f"{p['mouseSpeed']:g}"), ("natural_scroll", b(p["mouseNatural"])),
           ("left_handed", b(p["mouseLeftHanded"])), ("scroll_factor", f"{p['mouseScroll']:g}")]
    if p["mouseAccel"] == "flat":
        top.append(("accel_profile", "flat"))
    tp = [("natural_scroll", b(p["touchNatural"])), ("tap-to-click", b(p["tap"])),
          ("disable_while_typing", b(p["dwt"])), ("scroll_factor", f"{p['touchScroll']:g}")]
    return top, tp


def hypr_apply_input(kb: dict | None, pointer: dict | None = None):
    """Keyboard and/or pointer settings; whichever is None keeps what the file had."""
    old = hypr_read_json(HYPR_INPUT)
    kb = kb if kb is not None else old.get("input") or {}
    pointer = pointer if pointer is not None else old.get("pointer")
    lines = ["input {"]
    for k, hk in (("layout", "kb_layout"), ("variant", "kb_variant"), ("options", "kb_options"), ("model", "kb_model")):
        if str(kb.get(k, "")).strip():
            lines.append(f"    {hk} = {kb[k]}")
    lines += [f"    repeat_delay = {int(kb.get('repeatDelay', 600))}", f"    repeat_rate = {int(kb.get('repeatRate', 25))}",
              f"    numlock_by_default = {'true' if kb.get('numlock') else 'false'}"]
    top, tp = hypr_pointer_fields(pointer)
    lines += [f"    {k} = {v}" for k, v in top]
    if tp:
        lines += ["    touchpad {", *[f"        {k} = {v}" for k, v in tp], "    }"]
    lines.append("}")
    data = {"input": kb}
    if pointer is not None:
        data["pointer"] = pointer
    hypr_write(HYPR_INPUT, lines, data)


def hypr_apply_cursor(theme: str, size: int):
    hypr_write(HYPR_CURSOR, [f"env = XCURSOR_THEME,{theme}", f"env = XCURSOR_SIZE,{size}",
                             f"env = HYPRCURSOR_THEME,{theme}", f"env = HYPRCURSOR_SIZE,{size}",
                             f"exec-once = hyprctl setcursor {theme} {size}"])
    if shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "setcursor", theme, str(size)], capture_output=True)


def hypr_monitor_line(o: dict) -> str:
    if not o.get("enabled", True):
        return f"monitor = {o['name']}, disable"
    m = o.get("mode") or {}
    mode = f"{m['w']}x{m['h']}@{int(m['r']) / 1000:.2f}" if m else "preferred"
    line = f"monitor = {o['name']}, {mode}, {int(o.get('x', 0))}x{int(o.get('y', 0))}, {fmt_hypr_scale(o)}"
    line += f", transform, {HYPR_TRANSFORMS.get(norm_transform(o.get('transform')), 0)}"
    if o.get("vrrSupported") and "vrr" in o:
        line += f", vrr, {1 if o['vrr'] else 0}"
    return line


def hypr_display_list() -> list[dict]:
    raw = run_out(["hyprctl", "-j", "monitors", "all"])
    try:
        mons = json.loads(raw)
    except Exception:
        die("could not query Hyprland monitors (is Hyprland running?)")
    out = []
    for mo in mons:
        modes = []
        for s_ in mo.get("availableModes", []):
            mm = re.match(r"(\d+)x(\d+)@([\d.]+)Hz", s_)
            if mm:
                modes.append({"w": int(mm.group(1)), "h": int(mm.group(2)), "r": round(float(mm.group(3)) * 1000), "preferred": False})
        if modes:
            modes[0]["preferred"] = True
        cur = {"w": mo["width"], "h": mo["height"], "r": round(mo.get("refreshRate", 60) * 1000), "preferred": False}
        enabled = not mo.get("disabled", False)
        tf = TRANSFORMS[mo.get("transform", 0)] if 0 <= mo.get("transform", 0) < 8 else "normal"
        scale = mo.get("scale", 1.0) or 1.0
        rot = tf in ("90", "270", "flipped-90", "flipped-270")
        out.append({"name": mo["name"], "make": mo.get("make", ""), "model": mo.get("model", ""), "modes": modes,
                    "current": cur if enabled else None, "enabled": enabled, "x": mo.get("x", 0), "y": mo.get("y", 0),
                    "logicalW": round((mo["height"] if rot else mo["width"]) / scale),
                    "logicalH": round((mo["width"] if rot else mo["height"]) / scale),
                    "scale": scale, "transform": tf, "vrrSupported": True, "vrrEnabled": bool(mo.get("vrr")), "physical": None})
    return sorted(out, key=lambda d: (d["x"], d["y"], d["name"]))


def hypr_display_apply(spec: list[dict]) -> int:
    failed = 0
    for o in spec:
        r = subprocess.run(["hyprctl", "keyword", "monitor", hypr_monitor_line(o).split("=", 1)[1].strip()],
                           capture_output=True, text=True)
        if r.returncode != 0 or "error" in r.stdout.lower():
            failed += 1
            print(f"flamenco: {o['name']}: {(r.stdout or r.stderr).strip()}", file=sys.stderr)
    return 1 if failed else 0


def hypr_display_save(spec: list[dict]) -> int:
    hypr_write(HYPR_MONITORS, [hypr_monitor_line(o) for o in spec])
    print(f"displays: saved to {HYPR_MONITORS}")
    return 0


def hypr_validate(path: Path) -> bool:
    if not shutil.which("Hyprland"):
        return True
    r = subprocess.run(["Hyprland", "--verify-config", "-c", str(path)], capture_output=True, text=True)
    return r.returncode == 0 and "error" not in (r.stdout + r.stderr).lower()


def cmd_hyprland_config(args: list[str]) -> int:
    use_lua = "--lua" in args or ("--conf" not in args and hypr_lua())
    if use_lua:
        return cmd_hyprland_lua_config(args)
    here = Path(__file__).resolve().parent
    tpl = next((c for c in (here.parent / "data/hypr/hyprland.conf", shell_dir().parent / "hypr/hyprland.conf",
                            Path("/usr/share/flamenco-shell/hypr/hyprland.conf")) if c.is_file()), None)
    if tpl is None:
        die("Hyprland config template not found")
    text = tpl.read_text().replace("@@TERMINAL@@", pick_terminal())
    if "--print" in args:
        print(text, end="")
        return 0
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    # the sourced files must exist, or Hyprland reports errors
    try:
        saved = json.loads((CONFIG_DIR / "settings.json").read_text())
    except Exception:
        saved = {}
    if not HYPR_BINDS.exists():
        hypr_apply_shortcuts(saved.get("keyboard", {}).get("shortcuts") or DEFAULT_SHORTCUTS)
    if not HYPR_INPUT.exists():
        hypr_apply_input(saved.get("keyboard", {}) or {}, saved.get("pointer"))
    for f in (HYPR_CURSOR, HYPR_MONITORS, HYPR_LAYOUT):
        if not f.exists():
            hypr_write(f, [])
    tmp = HYPR_CONFIG.with_suffix(".conf.flamenco-tmp")
    tmp.write_text(text)
    if not hypr_validate(tmp):
        tmp.unlink()
        die("Hyprland rejected the generated config; hyprland.conf was not changed")
    if HYPR_CONFIG.exists():
        import time
        backup = HYPR_CONFIG.with_name(f"hyprland.conf.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        backup.write_text(HYPR_CONFIG.read_text())
        print(f"previous config saved as {backup}")
    tmp.replace(HYPR_CONFIG)
    print(f"wrote {HYPR_CONFIG} (+ flamenco-*.conf)")
    print(f"terminal: {pick_terminal()}  (Super+T / Super+Return)")
    hypr_reload()
    return 0


# ─────────────────────────────── Hyprland (Lua config) ───────────────────────
# Newer Hyprland reads ~/.config/hypr/hyprland.lua (an `hl.*` API). Flamenco's
# parts live in ~/.config/hypr/flamenco/*.lua and are required with pcall.

HYPR_LUA = HYPR_DIR / "hyprland.lua"
HYPR_LUA_DIR = HYPR_DIR / "flamenco"


def hypr_lua() -> bool:
    """Lua config in use: hyprland.lua exists, or neither config exists yet (new Hyprland)."""
    return HYPR_LUA.exists() or not HYPR_CONFIG.exists()


def lua_str(v) -> str:
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def lua_keys(key: str) -> str:
    mods, k = hypr_combo(key)
    return " + ".join([*mods.split(), k]) if mods else k


def lua_norm(key: str) -> str:
    """Same normalisation as norm() in the generated hyprland.lua."""
    mods, k = hypr_combo(key)
    return "+".join(sorted(m.upper() for m in mods.split()) + [k.upper()])


def lua_niri_action(action: str) -> str | None:
    """niri action → hl.dsp call (only forms shown in Hyprland's own example config)."""
    a = action.split()
    name, args = a[0], a[1:]
    if name in ("focus-workspace", "move-column-to-workspace") and args:
        w = args[0].strip('"')
        w = w if w.isdigit() else lua_str(w)
        return f"hl.dsp.focus({{ workspace = {w} }})" if name == "focus-workspace" else f"hl.dsp.window.move({{ workspace = {w} }})"
    return {
        "close-window": "hl.dsp.window.close()",
        "toggle-window-floating": 'hl.dsp.window.float({ action = "toggle" })',
        "focus-column-left": 'hl.dsp.focus({ direction = "left" })',
        "focus-column-right": 'hl.dsp.focus({ direction = "right" })',
        "focus-window-up": 'hl.dsp.focus({ direction = "up" })',
        "focus-window-down": 'hl.dsp.focus({ direction = "down" })',
        "focus-workspace-down": 'hl.dsp.focus({ workspace = "e+1" })',
        "focus-workspace-up": 'hl.dsp.focus({ workspace = "e-1" })',
        "quit": "hl.dsp.exit()",
        "screenshot": "hl.dsp.exec_cmd(" + lua_str('grim -g "$(slurp)" - | wl-copy') + ")",
        "screenshot-screen": "hl.dsp.exec_cmd(" + lua_str("grim - | wl-copy") + ")",
        "switch-layout": "hl.dsp.exec_cmd(" + lua_str("hyprctl switchxkblayout all next") + ")",
    }.get(name)


def lua_write(name: str, lines: list[str], data: dict | None = None):
    head = [f"-- {MARKER}: managed by Flamenco Settings, regenerated on change"]
    if data is not None:
        head.append("-- flamenco-json: " + json.dumps(data))
    HYPR_LUA_DIR.mkdir(parents=True, exist_ok=True)
    (HYPR_LUA_DIR / f"{name}.lua").write_text("\n".join(head + lines) + "\n")


def lua_read_json(name: str) -> dict:
    try:
        m = re.search(r"^-- flamenco-json: (.*)$", (HYPR_LUA_DIR / f"{name}.lua").read_text(), re.M)
        return json.loads(m.group(1)) if m else {}
    except Exception:
        return {}


def lua_apply_shortcuts(shortcuts: list[dict]):
    keys = [norm_key(sc["key"]) for sc in shortcuts]
    dup = {k for k in keys if keys.count(k) > 1}
    if dup:
        raise ValueError("the same key is used twice: " + ", ".join(sorted(dup)))
    lines = ["flamenco_taken = flamenco_taken or {}", ""]
    for sc in shortcuts:
        t, v = sc.get("type"), str(sc.get("value", "")).strip()
        title = f"  -- {sc['title']}" if sc.get("title") else ""
        opts = ", { locked = true }" if sc.get("locked") and t != "niri" else ""
        if t == "none":
            action = None
        elif t == "flamenco":
            if v not in SHELL_FUNCTIONS:
                raise ValueError(f"unknown Flamenco function: {v!r}")
            action = "hl.dsp.exec_cmd(" + lua_str("flamenco " + " ".join(SHELL_FUNCTIONS[v][1])) + ")"
        elif t == "app":
            action = "hl.dsp.exec_cmd(" + lua_str("flamenco launch " + v) + ")"
        elif t == "command":
            action = "hl.dsp.exec_cmd(" + lua_str(v) + ")"
        elif t == "niri":
            action = lua_niri_action(v)
            if action is None:
                lines.append(f"-- {sc['key']}: no Hyprland equivalent for niri action '{v}'")
                continue
        else:
            raise ValueError(f"{sc['key']}: unknown shortcut type {t!r}")
        # claim the key so the defaults in hyprland.lua step aside
        lines.append(f"flamenco_taken[{lua_str(lua_norm(sc['key']))}] = true{title}")
        if action:
            lines.append(f"hl.bind({lua_str(lua_keys(sc['key']))}, {action}{opts})")
    lua_write("binds", lines, {"shortcuts": shortcuts})


def lua_apply_input(kb: dict | None, pointer: dict | None = None):
    old = lua_read_json("input")
    kb = kb if kb is not None else old.get("input") or {}
    pointer = pointer if pointer is not None else old.get("pointer")
    fields = []
    for k, hk in (("layout", "kb_layout"), ("variant", "kb_variant"), ("options", "kb_options"), ("model", "kb_model")):
        if str(kb.get(k, "")).strip():
            fields.append(f"        {hk} = {lua_str(kb[k])},")
    fields += [f"        repeat_delay = {int(kb.get('repeatDelay', 600))},",
               f"        repeat_rate = {int(kb.get('repeatRate', 25))},",
               f"        numlock_by_default = {'true' if kb.get('numlock') else 'false'},"]
    lval = lambda v: v if v in ("true", "false") or re.fullmatch(r"-?[\d.]+", v) else lua_str(v)
    # the Lua config spells options with underscores (hyprlang's tap-to-click is tap_to_click)
    lkey = lambda k: k.replace("-", "_")
    top, tp = hypr_pointer_fields(pointer)
    fields += [f"        {lkey(k)} = {lval(v)}," for k, v in top]
    if tp:
        fields += ["        touchpad = {", *[f"            {lkey(k)} = {lval(v)}," for k, v in tp], "        },"]
    data = {"input": kb}
    if pointer is not None:
        data["pointer"] = pointer
    lua_write("input", ["hl.config({", "    input = {", *fields, "    },", "})"], data)


def lua_apply_cursor(theme: str, size: int):
    lua_write("cursor", [f'hl.env("XCURSOR_THEME", {lua_str(theme)})', f'hl.env("XCURSOR_SIZE", {lua_str(size)})',
                         f'hl.env("HYPRCURSOR_THEME", {lua_str(theme)})', f'hl.env("HYPRCURSOR_SIZE", {lua_str(size)})',
                         'hl.on("hyprland.start", function()',
                         f'    hl.exec_cmd({lua_str(f"hyprctl setcursor {theme} {size}")})',
                         "end)"])
    if shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "setcursor", theme, str(size)], capture_output=True)


def lua_monitor(o: dict) -> str:
    if not o.get("enabled", True):
        # a separate field, like monitorv2's; "disable" isn't a mode in the Lua config
        # ("hl.monitor: error applying field mode")
        return f'hl.monitor({{ output = {lua_str(o["name"])}, disabled = true }})'
    m = o.get("mode") or {}
    mode = f"{m['w']}x{m['h']}@{int(m['r']) / 1000:.3f}" if m else "preferred"
    parts = [f"output = {lua_str(o['name'])}", f"mode = {lua_str(mode)}",
             f"position = {lua_str(str(int(o.get('x', 0))) + 'x' + str(int(o.get('y', 0))))}",
             f"scale = {fmt_hypr_scale(o)}"]
    tf = HYPR_TRANSFORMS.get(norm_transform(o.get("transform")), 0)
    if tf:
        parts.append(f"transform = {tf}")   # same name as hyprlang's monitor option
    if o.get("vrrSupported") and "vrr" in o:
        parts.append(f"vrr = {1 if o['vrr'] else 0}")
    return "hl.monitor({ " + ", ".join(parts) + " })"


def lua_repair():
    """Fix files older versions wrote into hypr/flamenco/ that Hyprland's Lua config
    rejects: `mode = "disable"` (hl.monitor: error applying field mode) and dashed
    option names like ["tap-to-click"] (unknown config key). Runs as the shell starts."""
    fixes = {
        "monitors.lua": [(re.compile(r'mode = "disable"'), "disabled = true")],
        "input.lua": [(re.compile(r'\["([a-z_]+(?:-[a-z_]+)+)"\]'), lambda m: m.group(1).replace("-", "_"))],
    }
    changed = False
    for name, subs in fixes.items():
        f = HYPR_LUA_DIR / name
        try:
            text = f.read_text()
        except OSError:
            continue
        new = text
        for pat, repl in subs:
            new = pat.sub(repl, new)
        if new != text:
            f.write_text(new)
            changed = True
    if changed:
        hypr_reload()


def lua_display_write(spec: list[dict]) -> int:
    lua_write("monitors", [lua_monitor(o) for o in spec])
    hypr_reload()
    return 0


def cmd_hyprland_lua_config(args: list[str]) -> int:
    here = Path(__file__).resolve().parent
    tpl = next((c for c in (here.parent / "data/hypr/hyprland.lua", shell_dir().parent / "hypr/hyprland.lua",
                            Path("/usr/share/flamenco-shell/hypr/hyprland.lua")) if c.is_file()), None)
    if tpl is None:
        die("Hyprland Lua config template not found")
    text = tpl.read_text().replace("@@TERMINAL@@", pick_terminal())
    if "--print" in args:
        print(text, end="")
        return 0
    try:
        saved = json.loads((CONFIG_DIR / "settings.json").read_text())
    except Exception:
        saved = {}
    if not (HYPR_LUA_DIR / "binds.lua").exists():
        lua_apply_shortcuts(saved.get("keyboard", {}).get("shortcuts") or DEFAULT_SHORTCUTS)
    if not (HYPR_LUA_DIR / "input.lua").exists():
        lua_apply_input(saved.get("keyboard", {}) or {}, saved.get("pointer"))
    for name in ("cursor", "monitors"):
        if not (HYPR_LUA_DIR / f"{name}.lua").exists():
            lua_write(name, [])
    if HYPR_LUA.exists():
        import time
        backup = HYPR_LUA.with_name(f"hyprland.lua.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        backup.write_text(HYPR_LUA.read_text())
        print(f"previous config saved as {backup}")
    HYPR_LUA.write_text(text)
    print(f"wrote {HYPR_LUA} (+ flamenco/*.lua)")
    print(f"terminal: {pick_terminal()}  (Super+T / Super+Return)")
    if HYPR_CONFIG.exists():
        print(f"note: {HYPR_CONFIG} is still there; Hyprland uses hyprland.lua when both exist")
    hypr_reload()
    return 0


LUA_DISPATCH = {
    # niri action → (Lua expression, legacy dispatcher) for `hyprctl dispatch`
    "focus-workspace-up": ('hl.dsp.focus({ workspace = "e-1" })', ["workspace", "e-1"]),
    "focus-workspace-down": ('hl.dsp.focus({ workspace = "e+1" })', ["workspace", "e+1"]),
    "quit": ("hl.dsp.exit()", ["exit"]),
}


def cmd_hypr_dispatch(args: list[str]) -> int:
    """Run a niri-style action on Hyprland, in whichever syntax this Hyprland accepts."""
    if not args:
        die("usage: flamenco hypr-dispatch ACTION [ARGS]")
    a, rest = args[0], args[1:]
    win = rest[rest.index("--id") + 1] if "--id" in rest else ""
    if a == "switch-layout":
        return subprocess.run(["hyprctl", "switchxkblayout", "all", "prev" if rest[:1] == ["prev"] else "next"]).returncode
    if a == "focus-workspace" and rest:
        w = rest[0] if rest[0].isdigit() else lua_str(rest[0])
        lua, legacy = f"hl.dsp.focus({{ workspace = {w} }})", ["workspace", rest[0]]
    elif a == "focus-window" and win:
        lua, legacy = f'hl.dsp.focus({{ window = "address:{win}" }})', ["focuswindow", f"address:{win}"]   # Lua form: best guess
    elif a == "move-window-to-workspace" and "--window-id" in rest:
        wid = rest[rest.index("--window-id") + 1]
        ws = [x for i, x in enumerate(rest) if not x.startswith("--") and (i == 0 or rest[i - 1] not in ("--window-id", "--focus"))][-1]
        lua, legacy = (f'hl.dsp.window.move({{ workspace = {ws if ws.isdigit() else lua_str(ws)}, window = "address:{wid}", follow = false }})',   # Lua form: best guess
                       ["movetoworkspacesilent", f"{ws},address:{wid}"])
    elif a == "close-window":
        lua, legacy = (f'hl.dsp.window.close({{ window = "address:{win}" }})', ["closewindow", f"address:{win}"]) if win \
            else ("hl.dsp.window.close()", ["killactive"])
    elif a in ("move-window-to-floating", "move-window-to-tiling") and win:
        on = a == "move-window-to-floating"
        lua, legacy = (f'hl.dsp.window.float({{ action = "{"set" if on else "unset"}", window = "address:{win}" }})',   # Lua form: best guess
                       ["setfloating" if on else "settiled", f"address:{win}"])
    elif a == "power-off-monitors":
        lua, legacy = 'hl.dsp.dpms({ action = "off" })', ["dpms", "off"]                                      # Lua form: best guess
    elif a in LUA_DISPATCH:
        lua, legacy = LUA_DISPATCH[a]
    else:
        die(f"no Hyprland equivalent for {a!r}")
    attempts = [[lua], legacy] if hypr_lua() else [legacy, [lua]]
    for cmd in attempts:
        r = subprocess.run(["hyprctl", "dispatch", *cmd], capture_output=True, text=True)
        out = (r.stdout + r.stderr).strip().lower()
        if r.returncode == 0 and not any(w in out for w in ("error", "invalid", "unknown", "not found")):
            return 0
    print(f"flamenco: Hyprland rejected {a}", file=sys.stderr)
    return 1


# ─────────────────────────────── apps-theme ──────────────────────────────────

# ─────────────────────────────── theming: back to a desktop's defaults ───────
# For using GNOME or Plasma (even for a while): Flamenco's colors leak into them
# through files they read too (gtk.css overrides that GNOME Tweaks can't undo,
# kdeglobals, gsettings). `apps-theme --reset gnome|kde` puts back the files that
# were there before Flamenco (its backups), removes everything it generated, and
# resets every key it changed to that desktop's own defaults: GNOME (Adwaita,
# its fonts, no color scheme) or KDE (Breeze). The shell stops re-applying its
# theme to apps until you pick Flamenco again in Settings → App Theming.

GTK_KEYS = ("gtk-application-prefer-dark-theme", "gtk-font-name", "gtk-icon-theme-name", "gtk-theme-name",
            "gtk-cursor-theme-name", "gtk-cursor-theme-size")
GS_KEYS = ("color-scheme", "gtk-theme", "font-name", "monospace-font-name", "document-font-name", "icon-theme",
           "cursor-theme", "cursor-size", "accent-color")


def ini_edit(path: Path, edit) -> bool:
    """Change an ini file in place (no backups: this is undoing ours). False if it isn't there."""
    if not path.is_file():
        return False
    cp = ini_read(path)
    edit(cp)
    from io import StringIO
    buf = StringIO()
    cp.write(buf, space_around_delimiters=False)
    path.write_text(buf.getvalue())
    return True


def generated(path: Path) -> bool:
    try:
        return path.is_file() and MARKER in path.read_text(errors="ignore")[:400]
    except OSError:
        return False


def theme_reset(target: str) -> list[str]:
    done = []
    restore()                                         # the user's own files back, ours removed
    kde = target == "kde"
    breeze_gtk = "Breeze" in gtk_themes()
    # GTK: no colour overrides, no forced theme / fonts / icons / cursor
    for v in ("gtk-3.0", "gtk-4.0"):
        css = XDG_CONFIG / v / "gtk.css"
        if generated(css):
            css.unlink()
            done.append(f"{v}/gtk.css removed")

        def gtk_edit(cp, v=v):
            if not cp.has_section("Settings"):
                return
            for k in GTK_KEYS:
                cp.remove_option("Settings", k)
            if kde:
                if breeze_gtk and v == "gtk-3.0":
                    cp.set("Settings", "gtk-theme-name", "Breeze")
                cp.set("Settings", "gtk-icon-theme-name", "breeze")
        if ini_edit(XDG_CONFIG / v / "settings.ini", gtk_edit):
            done.append(f"{v}/settings.ini")
    # GNOME settings: each key back to the schema's default (Adwaita, its fonts, no dark preference)
    if shutil.which("gsettings"):
        iface = "org.gnome.desktop.interface"
        for k in GS_KEYS:
            subprocess.run(["gsettings", "reset", iface, k], capture_output=True)
        if kde:
            if breeze_gtk:
                subprocess.run(["gsettings", "set", iface, "gtk-theme", "Breeze"], capture_output=True)
            subprocess.run(["gsettings", "set", iface, "icon-theme", "breeze"], capture_output=True)
            subprocess.run(["gsettings", "set", iface, "cursor-theme", "breeze_cursors"], capture_output=True)
        done.append("GNOME settings reset" + (" (Breeze for GTK)" if kde else " (Adwaita)"))
    # KDE / Qt: Flamenco's colour scheme out, Breeze (Plasma's default) in
    scheme = XDG_DATA / "color-schemes/Flamenco.colors"
    if scheme.is_file():
        scheme.unlink()

    def kde_edit(cp):
        if cp.has_section("General") and cp.get("General", "ColorScheme", fallback="") == "Flamenco":
            for sec in [x for x in cp.sections() if x.startswith("Colors:")] + ["WM"]:
                cp.remove_section(sec)
            cp.remove_option("General", "ColorScheme")
            if cp.get("General", "Name", fallback="") == "Flamenco":
                cp.remove_option("General", "Name")
        if cp.has_section("KDE"):
            cp.set("KDE", "widgetStyle", "Breeze")
        if kde:
            if not cp.has_section("Icons"):
                cp.add_section("Icons")
            cp.set("Icons", "Theme", "breeze")
            if not cp.has_section("General"):
                cp.add_section("General")
            cp.set("General", "ColorScheme", "BreezeLight")
    if ini_edit(XDG_CONFIG / "kdeglobals", kde_edit):
        done.append("kdeglobals")
    if kde and shutil.which("plasma-apply-colorscheme"):
        subprocess.run(["plasma-apply-colorscheme", "BreezeLight"], capture_output=True)
    # qt5ct / qt6ct (Qt apps in niri): the style's own palette, no stylesheet, no forced fonts
    for ct in ("qt5ct", "qt6ct"):
        def qt_edit(cp):
            if not cp.has_section("Appearance"):
                cp.add_section("Appearance")
            cp.set("Appearance", "custom_palette", "false")
            cp.remove_option("Appearance", "color_scheme_path")
            cp.set("Appearance", "style", "Breeze" if kde else "Fusion")
            if cp.has_section("Interface"):
                cp.set("Interface", "stylesheets", "@Invalid()")
            if cp.has_section("Fonts"):
                cp.remove_section("Fonts")
        if ini_edit(XDG_CONFIG / ct / f"{ct}.conf", qt_edit):
            done.append(ct)
    # the default X cursor Flamenco set
    cur = XDG_DATA / "icons/default/index.theme"
    if generated(cur):
        cur.unlink()
    save_manifest({"files": [], "backups": {}, "gsettings": {}})
    return done


def cmd_apps_theme(args: list[str]) -> int:
    if "--restore" in args:
        return restore()
    if "--reset" in args:
        i = args.index("--reset")
        target = args[i + 1] if i + 1 < len(args) else "gnome"
        if target not in ("gnome", "kde"):
            die("usage: flamenco apps-theme --reset gnome|kde")
        for d in theme_reset(target):
            print(d)
        print("Apps are back to " + ("KDE's defaults (Breeze)" if target == "kde" else "GNOME's defaults (Adwaita)") + ". Restart open apps to see it.")
        return 0
    raw = None
    if "--json" in args:
        i = args.index("--json")
        if i + 1 >= len(args):
            die("--json needs an argument")
        raw = args[i + 1]
    elif "--stdin" in args:
        raw = sys.stdin.read()
    elif "--file" in args:
        raw = Path(args[args.index("--file") + 1]).read_text()
    else:
        die("usage: flamenco apps-theme --json SPEC | --stdin | --file PATH | --restore | --reset gnome|kde")
    try:
        spec = Spec(json.loads(raw))
    except json.JSONDecodeError as e:
        die(f"invalid theme JSON: {e}")

    m = load_manifest()
    done = apply_cursor_tint(spec)          # first: the cursor theme may become its tinted copy
    try:
        if spec.o.get("qt", True):
            done += apply_qt(spec, m)
        if spec.o.get("gtk", True):
            done += apply_gtk(spec, m)
        done += apply_cursor(spec, m)
        done += apply_sound(spec, m)
        done += apply_extra_apps(spec, m)
    finally:
        save_manifest(m)
    print("themed: " + (", ".join(done) or "nothing (Qt and GTK disabled)"))
    return 0


def restore() -> int:
    m = load_manifest()
    restored = removed = 0
    for target, backup in m.get("backups", {}).items():
        t = Path(target)
        if backup is None:
            if t.exists():
                t.unlink()
                removed += 1
        elif Path(backup).exists():
            t.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(backup, t)
            restored += 1
    for f in m.get("files", []):
        p = Path(f)
        if p.exists() and f not in m.get("backups", {}):
            p.unlink()
            removed += 1
    restore_niri_cursor(m)
    gs = 0
    if shutil.which("gsettings"):
        for k, v in m.get("gsettings", {}).items():
            schema, key = k.split(" ", 1)
            # values come back GVariant-formatted ('foo'); strip quotes for `gsettings set`
            if len(v) >= 2 and v[0] == v[-1] == "'":
                v = v[1:-1]
            subprocess.run(["gsettings", "set", schema, key, v], capture_output=True)
            gs += 1
    save_manifest({"files": [], "backups": {}})
    print(f"restored {restored} file(s), removed {removed} generated file(s), reset {gs} gsettings key(s)")
    return 0


# ─────────────────────────────── UI icons from an icon theme ─────────────────
