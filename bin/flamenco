UI_ICON_CACHE = XDG_CACHE / "flamenco" / "ui-icons"


def icon_theme_root(name: str) -> Path | None:
    for base in [HOME / ".icons"] + [d / "icons" for d in data_dirs()]:
        p = base / name
        if (p / "index.theme").is_file() or p.is_dir():
            return p
    return None


def icon_theme_chain(name: str, fallbacks: bool = True) -> list[Path]:
    chain, seen, todo = [], set(), [name]
    while todo:
        n = todo.pop(0)
        if n in seen:
            continue
        seen.add(n)
        root = icon_theme_root(n)
        if not root:
            continue
        chain.append(root)
        inh = read_index(root / "index.theme").get("Icon Theme", "Inherits", fallback="")
        todo += [x.strip() for x in inh.split(",") if x.strip()]
    for fallback in ("Adwaita", "hicolor") if fallbacks else ():
        r = icon_theme_root(fallback) if fallback not in seen else None
        if r:
            chain.append(r)
    return chain


def icon_index(root: Path) -> dict[str, str]:
    """name → the best file for it in one theme folder: SVG first, then the biggest PNG.
    Linked folders are followed (Papirus-Dark, Tela's colors… are mostly links to the main theme)."""
    best: dict[str, tuple[int, str]] = {}
    seen: set[str] = set()
    for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
        real = os.path.realpath(dirpath)
        if real in seen:
            dirnames[:] = []
            continue
        seen.add(real)
        parts = Path(dirpath).relative_to(root).parts
        px = next((int(m.group(1)) for x in reversed(parts) if (m := re.fullmatch(r"(\d+)(?:x\d+)?(?:@\d+x?)?", x))), 1)
        for fn in filenames:
            stem, ext = os.path.splitext(fn)
            if ext not in (".svg", ".png"):
                continue
            f = os.path.join(dirpath, fn)
            size = 10000 if ext == ".svg" else px
            if (stem not in best or size > best[stem][0]) and os.path.isfile(f):
                best[stem] = (size, f)
    return {k: v[1] for k, v in best.items()}


def icon_one_color(path: str) -> bool:
    """A one-color SVG that isn't named -symbolic: KDE's (Breeze's small icons draw in
    ColorScheme-Text) or a plain single gray. The shell tints these like symbolic ones,
    or they'd be dark on a dark bar."""
    if not path.endswith(".svg"):
        return False
    try:
        with open(path, "rb") as fh:
            svg = fh.read(200_000).decode("utf-8", errors="replace").lower()
    except OSError:
        return False
    if "<image" in svg or "gradient" in svg:
        return False
    colors = set(re.findall(r"#[0-9a-f]{6}\b|#[0-9a-f]{3}\b", svg))
    if ("colorscheme-" in svg or "currentcolor" in svg) and len(colors) <= 3:
        return True
    if len(colors) == 1:
        c = colors.pop().lstrip("#")
        c = "".join(ch * 2 for ch in c) if len(c) == 3 else c
        r, g, b = (int(c[i:i + 2], 16) for i in (0, 2, 4))
        return max(r, g, b) - min(r, g, b) < 24
    return False


def ui_icon_map(theme: str) -> dict:
    # the theme and what it says it builds on; not Adwaita or hicolor behind its back,
    # so what a pack lacks stays Flamenco's instead of turning into another theme's
    chain = [p for p in icon_theme_chain(theme, fallbacks=False) if p.name != "hicolor"]
    if not chain:
        return {}
    # cached per theme until one of its folders changes
    stamp = max((max(p.stat().st_mtime, (p / "index.theme").stat().st_mtime if (p / "index.theme").exists() else 0) for p in chain), default=0)
    cache = UI_ICON_CACHE / (re.sub(r"[^\w.-]", "_", theme) + ".json")
    try:
        c = json.loads(cache.read_text())
        if c.get("stamp") == stamp and c.get("version") == 2 and c.get("chain") == [str(p) for p in chain]:
            return c["map"]
    except (OSError, ValueError, KeyError):
        pass
    indexes = [icon_index(r) for r in chain]
    out = {}
    for material, names in UI_ICON_MAP.items():
        hit = None
        # the theme's own first, then what it inherits; in each, the one-color (-symbolic)
        # version of a name before its full-color one
        for idx in indexes:
            for n in names:
                for want in (n + "-symbolic", n):
                    if want in idx:
                        p = idx[want]
                        hit = {"p": p, "s": want.endswith("-symbolic") or icon_one_color(p)}
                        break
                if hit:
                    break
            if hit:
                break
        if hit:
            out[material] = hit
    UI_ICON_CACHE.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps({"version": 2, "stamp": stamp, "chain": [str(p) for p in chain], "map": out}))
    return out


def cmd_icons(args: list[str]) -> int:
    if args[:1] == ["map"] and len(args) > 1:
        print(json.dumps(ui_icon_map(args[1])))
        return 0
    if args[:1] == ["names"]:
        print("\n".join(sorted(UI_ICON_MAP)))
        return 0
    die("usage: flamenco icons map THEME | names")


# ─────────────────────────────── installed themes ────────────────────────────

def data_dirs() -> list[Path]:
    dirs = [XDG_DATA] + [Path(d) for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if d]
    for extra in (Path("/usr/share"), Path("/usr/local/share")):
        if extra not in dirs:
            dirs.append(extra)
    return dirs


def read_index(path: Path) -> configparser.RawConfigParser:
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(path, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        pass
    return cp


def icon_and_cursor_themes() -> tuple[list[dict], list[dict]]:
    icons: dict[str, dict] = {}
    cursors: dict[str, dict] = {}
    roots = [HOME / ".icons"] + [d / "icons" for d in data_dirs()]
    for root in roots:
        if not root.is_dir():
            continue
        for t in sorted(root.iterdir()):
            if not t.is_dir() or t.name in ("default", "hicolor", "locolor"):
                continue
            idx = read_index(t / "index.theme")
            label = idx.get("Icon Theme", "Name", fallback=t.name) if idx.has_section("Icon Theme") else t.name
            if (t / "cursors").is_dir() and t.name not in cursors:
                cursors[t.name] = {"value": t.name, "label": label}
            dirs = idx.get("Icon Theme", "Directories", fallback="") if idx.has_section("Icon Theme") else ""
            if dirs.strip() and t.name not in icons:
                icons[t.name] = {"value": t.name, "label": label}
    key = lambda d: d["label"].lower()
    return sorted(icons.values(), key=key), sorted(cursors.values(), key=key)


def gtk_themes() -> list[str]:
    names = {"Adwaita", "HighContrast"}  # built into GTK 3
    for root in [HOME / ".themes"] + [d / "themes" for d in data_dirs()]:
        if root.is_dir():
            for t in root.iterdir():
                g = t / "gtk-3.0"
                # skip keybinding-only themes (Default, Emacs) that ship just gtk-keys.css
                if any((g / f).exists() for f in ("gtk.css", "gtk-dark.css", "gtk.gresource")):
                    names.add(t.name)
    return sorted(names, key=str.lower)


def qt_styles() -> list[str]:
    styles = ["Fusion", "Windows"]
    plugin_dirs = []
    if shutil.which("qtpaths6"):
        r = subprocess.run(["qtpaths6", "--query", "QT_INSTALL_PLUGINS"], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            plugin_dirs.append(Path(r.stdout.strip()) / "styles")
    plugin_dirs += [Path("/usr/lib/qt6/plugins/styles"), Path("/usr/lib64/qt6/plugins/styles")]
    known = {"breeze": "Breeze", "kvantum": "kvantum", "oxygen": "Oxygen", "darkly": "Darkly",
             "lightly": "Lightly", "klassy": "Klassy", "qt6ct-style": "qt6ct-style", "adwaita": "Adwaita"}
    for d in plugin_dirs:
        if not d.is_dir():
            continue
        for f in d.glob("*.so"):
            base = f.stem.lower().removeprefix("lib")
            name = next((v for k, v in known.items() if k in base), None)
            if name and name not in styles:
                styles.append(name)
    return styles


def kvantum_themes() -> list[str]:
    names = set()
    for root in [XDG_CONFIG / "Kvantum"] + [d / "Kvantum" for d in data_dirs()]:
        if root.is_dir():
            for t in root.iterdir():
                if t.is_dir() and any(t.glob("*.kvconfig")):
                    names.add(t.name)
    return sorted(names, key=str.lower)


def sddm_themes() -> list[dict]:
    """SDDM greeter themes, usable as Flamenco lock screens."""
    found: dict[str, dict] = {}
    for root in [XDG_DATA / "sddm/themes"] + [d / "sddm/themes" for d in data_dirs()]:
        if not root.is_dir():
            continue
        for t in sorted(root.iterdir()):
            meta = t / "metadata.desktop"
            if t.name in found or not meta.is_file():
                continue
            cp = read_index(meta)
            sec = "SddmGreeterTheme"
            name = cp.get(sec, "Name", fallback=t.name) if cp.has_section(sec) else t.name
            qt = cp.get(sec, "QtVersion", fallback="5") if cp.has_section(sec) else "5"
            main = cp.get(sec, "MainScript", fallback="Main.qml") if cp.has_section(sec) else "Main.qml"
            if not (t / main).is_file():
                continue
            label = name if qt.strip() == "6" else f"{name} (Qt 5, may not load)"
            found[t.name] = {"value": t.name, "label": label, "path": str(t), "qt": qt.strip()}
    return sorted(found.values(), key=lambda d: d["label"].lower())


def cmd_list_themes(args: list[str]) -> int:
    icons, cursors = icon_and_cursor_themes()
    out = {"icons": icons, "cursors": cursors, "gtk": gtk_themes(), "qtStyles": qt_styles(), "kvantum": kvantum_themes(),
           "sddm": sddm_themes()}
    if "--json" in args:
        # the other apps Flamenco can theme, and whether they're here
        out["apps"] = {k: bool(shutil.which(b) or (k == "vesktop" and any((XDG_CONFIG / d).is_dir() for d in ("vesktop", "Vencord", "equibop")))
                               or (k == "vscode" and any((HOME / d).is_dir() for d in (".vscode", ".vscode-oss", ".cursor"))))
                       for k, b in EXTRA_APPS.items()}
    if "--json" in args:
        print(json.dumps(out))
    else:
        for k, v in out.items():
            names = [x["value"] if isinstance(x, dict) else x for x in v]
            print(f"{k}: {', '.join(names) or '(none)'}")
    return 0


# ─────────────────────────────── doctor ──────────────────────────────────────

def font_installed(name: str) -> bool:
    if not shutil.which("fc-list"):
        return False
    r = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True)
    return name.lower() in r.stdout.lower()


def doctor_checks() -> list[dict]:
    """Everything Flamenco uses, grouped, with the Arch package that provides it."""
    checks = []

    def add(category, name, purpose, ok, package="", required=False, aur=False, hint="", fix=""):
        # fix: a command that sets it right when a package alone doesn't (e.g. joining a group)
        checks.append({"category": category, "name": name, "purpose": purpose, "ok": bool(ok),
                       "package": package, "required": required, "aur": aur, "hint": hint, "fix": fix})

    have = lambda *bins: any(shutil.which(b) for b in bins)
    exists = lambda *paths: any(Path(p).exists() for p in paths)

    # ── core ──
    add("Core", "Quickshell", "Runs the shell", have("qs", "quickshell"), "quickshell", True)
    add("Core", "niri", "Compositor", have("niri"), "niri", True)
    add("Core", "Icon font", "Material Symbols (bundled)",
        (shell_dir() / "assets/fonts/MaterialSymbolsRounded.ttf").is_file() or font_installed("Material Symbols Rounded"), "", True)
    add("Core", "Google Sans Flex", "the default font (bundled; other apps need it installed, which the package does)",
        font_installed("Google Sans Flex"), "", False,
        hint="the package links it into /usr/share/fonts; from a git checkout: cp shell/assets/fonts/GoogleSans*.ttf ~/.local/share/fonts/")
    add("Core", "Terminal", "Mod+T, terminal apps, > commands in the launcher", have(*TERMINALS), "kitty", True)

    # ── session ──
    if compositor() == "hyprland":
        hcfg = (HYPR_LUA if hypr_lua() else HYPR_CONFIG).read_text() if (HYPR_LUA if hypr_lua() else HYPR_CONFIG).is_file() else ""
        add("Session", "Compositor", "Hyprland", True, "hyprland", True)
        add("Session", "Starts with Hyprland", "exec-once = flamenco run in hyprland.conf",
            bool(re.search(r"^\s*exec-once\s*=\s*flamenco run", hcfg, re.M)) or 'hl.exec_cmd("flamenco run")' in hcfg,
            "", True, hint="run `flamenco hyprland-config`")
        add("Session", "Flamenco settings files", "hyprland.conf sources the flamenco-*.conf files",
            "flamenco-binds.conf" in hcfg or 'flamenco("binds")' in hcfg, "", False, hint="run `flamenco hyprland-config`")
    cfg = NIRI_CONFIG.read_text() if NIRI_CONFIG.is_file() and compositor() == "niri" else ""
    if compositor() == "niri" and have("niri") and cfg:
        r = subprocess.run(["niri", "validate", "-c", str(NIRI_CONFIG)], capture_output=True, text=True)
        add("Session", "niri config", "~/.config/niri/config.kdl is valid", r.returncode == 0, "", True,
            hint="" if r.returncode == 0 else (r.stderr or r.stdout).strip().splitlines()[-1:][0] if (r.stderr or r.stdout).strip() else "run `niri validate`")
    starts = [cfg[a:b] for a, b in kdl_spawn_lines(cfg)]
    if compositor() == "niri":
        add("Session", "Starts with niri", "spawn-at-startup \"flamenco\" \"run\" in the niri config",
            any("flamenco" in l for l in starts), "", True, hint="run `flamenco niri-config`")
    try:
        st = json.loads((CONFIG_DIR / "settings.json").read_text())
    except (OSError, ValueError):
        st = {}
    notif_backend = (st.get("notifications") or {}).get("backend", "flamenco")
    launch_backend = (st.get("launcher") or {}).get("backend", "flamenco")
    # mako chosen in Settings → Notifications: Flamenco starts it itself, so it isn't a rival
    others = [x for x in ("dms", "waybar", "swaybg", "swww", "hyprpanel", "noctalia", "ags", "eww", "mako", "dunst", "swaync")
              if any(re.search(r'\b' + x + r'\b', l) for l in starts) and not (x == "mako" and notif_backend == "mako")]
    add("Session", "No other shell", "nothing else drawing a bar, wallpaper or notifications",
        not others, "", True, hint=("also started: " + ", ".join(others)) if others else "")
    # the launcher and notification apps picked in Settings, when they aren't Flamenco's own
    if launch_backend == "fuzzel":
        add("Features", "fuzzel", "the launcher you picked (Settings → Launcher); Flamenco's opens until it's installed", have("fuzzel"), "fuzzel")
    if notif_backend == "mako":
        add("Features", "mako", "the notification daemon you picked (Settings → Notifications); Flamenco's shows them until it's installed",
            have("mako") and have("makoctl"), "mako")
    portals = {p["name"] for p in installed_portals()}
    sc = effective_portals().get("ScreenCast", "") or effective_portals().get("default", "")
    capable = portals & {"gnome", "wlr"}
    add("Session", "Screen sharing portal", "xdg-desktop-portal-wlr (light, whole screens) or -gnome (also single windows)",
        bool(capable), "xdg-desktop-portal-wlr",
        hint="choose the backend in Settings → Screen sharing" if capable else "")
    if capable and sc and sc not in capable:
        add("Session", "Screen sharing backend", f"niri-portals.conf sends screen sharing to '{sc}', which can't capture on niri",
            False, "", False, hint="pick gnome or wlr in Settings → Screen sharing")
    add("Session", "XWayland", "X11 apps (Steam, older apps)", have("xwayland-satellite"), "xwayland-satellite")
    drm = Path("/sys/class/drm")
    cards = sorted(drm.glob("card[0-9]")) + sorted(drm.glob("card[0-9][0-9]")) if drm.is_dir() else []
    vendors = []
    for card in cards:
        try:
            vendors.append((card / "device/vendor").read_text().strip())
        except OSError:
            pass
    add("Session", "GPU render node", "niri needs /dev/dri/renderD* to draw anything",
        any(Path("/dev/dri").glob("renderD*")) if Path("/dev/dri").is_dir() else False, "mesa", True)
    if "0x1af4" in vendors:   # Red Hat / virtio: a virtual machine GPU
        # virtio-gpu feature bit 0 is VIRTIO_GPU_F_VIRGL (3D); the sysfs file is one char per bit
        virgl = False
        for card in cards:
            for f in card.glob("device/virtio*/features"):
                try:
                    virgl = virgl or f.read_text().strip()[:1] == "1"
                except OSError:
                    pass
        add("Session", "VM 3D acceleration", "virtio GPU: niri needs 3D acceleration (virgl) to draw from the login screen",
            virgl, "", True,
            hint="enable 3D acceleration for the VM (QEMU/virt-manager: Video VirtIO + 'OpenGL' on the SPICE/egl-headless display; "
                 "VirtualBox: VMSVGA + 3D). Without it niri shows a black screen when started from the login manager.")

    # ── features ──
    add("Features", "NetworkManager", "Wi-Fi, Ethernet and VPN", have("nmcli"), "networkmanager")
    add("Features", "OpenVPN plugin", "import and connect .ovpn VPNs",
        exists("/usr/lib/NetworkManager/VPN/nm-openvpn-service.name"), "networkmanager-openvpn")
    add("Features", "WireGuard tools", "WireGuard VPNs", have("wg"), "wireguard-tools")
    add("Features", "PipeWire volume", "volume keys without the shell", have("wpctl"), "wireplumber")
    add("Features", "App mixer outputs", "move an app to another speaker or headset (pactl)", have("pactl"), "libpulse")
    add("Features", "brightnessctl", "screen brightness", have("brightnessctl"), "brightnessctl")
    add("Features", "playerctl", "media keys without the shell", have("playerctl"), "playerctl")
    add("Features", "Power profiles", "Power saver / Balanced / Performance", have("powerprofilesctl"), "power-profiles-daemon")
    add("Features", "UPower", "battery status", have("upower"), "upower")
    add("Features", "Bluetooth", "Bluetooth devices", have("bluetoothctl"), "bluez-utils")
    add("Features", "CUPS", "printing", have("lpstat"), "cups")
    add("Features", "Clipboard history", "; mode in the launcher", have("cliphist"), "cliphist")
    add("Features", "wl-clipboard", "copying from the launcher", have("wl-copy"), "wl-clipboard")
    add("Features", "Night light", "gammastep", have("gammastep"), "gammastep")
    add("Features", "Screenshots", "README screenshots script", have("grim"), "grim")
    add("Features", "Notifications CLI", "notify-send", have("notify-send"), "libnotify")
    add("Features", "btop", "Open btop from the performance popout", have("btop"), "btop")
    add("Features", "Sounds", "event sounds (pw-play)", have("pw-play", "paplay"), "pipewire")
    add("Features", "Firewall", "Settings → Firewall", have("ufw", "firewall-cmd"), "ufw")
    add("Features", "Flatpak", "Settings → Flatpak permissions", have("flatpak"), "flatpak")
    add("Features", "pciutils", "the graphics card in Settings → About", have("lspci"), "pciutils")
    add("Features", "File chooser portal", "Browse buttons (wallpaper folder, images)",
        bool({p["name"] for p in installed_portals()} & {"gtk", "gnome", "kde"}), "xdg-desktop-portal-gtk")
    gi_ok = False
    try:
        import importlib.util
        gi_ok = importlib.util.find_spec("gi") is not None
    except Exception:
        pass
    add("Features", "python-gobject", "talks to the file chooser portal", gi_ok, "python-gobject")

    # ── extras ──
    add("Extras", "Screen recording", "record the screen or an area (or gpu-screen-recorder)", have("wf-recorder", "gpu-screen-recorder"), "wf-recorder")
