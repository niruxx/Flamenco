DISABLED = "// disabled: "


def bind_line(sc: dict) -> str:
    key = sc["key"].strip()
    if not re.fullmatch(r"[A-Za-z0-9_+]+", key):
        raise ValueError(f"invalid key combination: {key!r}")
    t, v = sc.get("type"), str(sc.get("value", "")).strip()
    if t == "none":
        # claims the key (so a user binding on it is commented out) but binds nothing
        return DISABLED + key
    if t == "flamenco":
        if v not in SHELL_FUNCTIONS:
            raise ValueError(f"unknown Flamenco function: {v!r}")
        action = "spawn " + " ".join(kdl_quote(a) for a in ["flamenco", *SHELL_FUNCTIONS[v][1]])
    elif t == "app":
        if not v:
            raise ValueError(f"{key}: no app chosen")
        action = "spawn " + " ".join(kdl_quote(a) for a in ["flamenco", "launch", v])
    elif t == "command":
        if not v:
            raise ValueError(f"{key}: empty command")
        action = "spawn-sh " + kdl_quote(v)
    elif t == "niri":
        if not re.fullmatch(r"[a-z][a-z0-9-]*(\s+.*)?", v):
            raise ValueError(f"{key}: not a niri action: {v!r}")
        action = v
    else:
        raise ValueError(f"{key}: unknown shortcut type {t!r}")
    props = ""
    if sc.get("locked") and t != "niri":
        props += " allow-when-locked=true"
    if sc.get("title"):
        props += " hotkey-overlay-title=" + kdl_quote(sc["title"])
    return f"{key}{props} {{ {action}; }}"


def norm_key(k: str) -> str:
    """Key combos compare case-insensitively with modifiers in any order."""
    parts = k.strip().split("+")
    mods = sorted(p.lower() for p in parts[:-1])
    return "+".join(mods + [parts[-1].lower()])


def binds_region(text: str, block):
    """(start, end) of the managed region inside the binds block, or None."""
    _, o, c = block
    a = text.find(BINDS_BEGIN, o, c)
    if a < 0:
        return None
    b = text.find(BINDS_END, a, c)
    if b < 0:
        return None
    a = text.rfind("\n", 0, a) + 1                 # start of the marker line
    b = text.find("\n", b)
    return a, (b + 1 if b >= 0 else c)


def other_bind_keys(text: str) -> list[dict]:
    """Bindings in the binds block that Flamenco doesn't manage."""
    block = kdl_block(text, "binds")
    if not block:
        return []
    _, o, c = block
    region = binds_region(text, block)
    masked = kdl_mask(text)
    out = []
    for m in re.finditer(r"(?m)^[ \t]*([A-Za-z0-9_+]+)(?=[\s{])[^\n]*", masked[o + 1:c]):
        pos = o + 1 + m.start()
        if region and region[0] <= pos < region[1]:
            continue
        line = text[pos:o + 1 + m.end()].strip()
        out.append({"key": m.group(1), "line": line})
    return out


def kdl_unquote(v: str) -> str:
    return re.sub(r"\\(.)", lambda m: {"n": "\n", "t": "\t"}.get(m.group(1), m.group(1)), v)


def managed_shortcuts(text: str) -> list[dict] | None:
    """Parse our own region back into shortcut dicts (best effort)."""
    block = kdl_block(text, "binds")
    if not block:
        return None
    region = binds_region(text, block)
    if not region:
        return None
    fn_by_args = {tuple(v[1]): k for k, v in SHELL_FUNCTIONS.items()}
    out = []
    for line in text[region[0]:region[1]].splitlines():
        if line.strip().startswith(DISABLED):
            out.append({"key": line.strip()[len(DISABLED):].strip(), "type": "none", "value": "", "title": "", "locked": False})
            continue
        m = re.match(r'\s*([A-Za-z0-9_+]+)(.*?)\{\s*(.*?);?\s*\}\s*$', line)
        if not m:
            continue
        key, props, action = m.groups()
        title = re.search(r'hotkey-overlay-title="((?:[^"\\]|\\.)*)"', props)
        sc = {"key": key, "title": kdl_unquote(title.group(1)) if title else "", "locked": "allow-when-locked=true" in props}
        args = [kdl_unquote(a) for a in re.findall(r'"((?:[^"\\]|\\.)*)"', action)]
        if action.startswith("spawn-sh "):
            sc.update(type="command", value=args[0] if args else "")
        elif action.startswith("spawn ") and args[:2] == ["flamenco", "launch"]:
            sc.update(type="app", value=args[2] if len(args) > 2 else "")
        elif action.startswith("spawn ") and args[:1] == ["flamenco"] and tuple(args[1:]) in fn_by_args:
            sc.update(type="flamenco", value=fn_by_args[tuple(args[1:])])
        elif action.startswith("spawn "):
            sc.update(type="command", value=" ".join(args))
        else:
            sc.update(type="niri", value=action)
        out.append(sc)
    return out


def apply_shortcuts(text: str, shortcuts: list[dict]) -> str:
    lines = [bind_line(sc) for sc in shortcuts]
    keys = [norm_key(sc["key"]) for sc in shortcuts]
    dup = {k for k in keys if keys.count(k) > 1}
    if dup:
        raise ValueError("the same key is used twice: " + ", ".join(sorted(dup)))

    block = kdl_block(text, "binds")
    if block is None:
        text = text.rstrip("\n") + "\n\nbinds {\n}\n"
        block = kdl_block(text, "binds")
    pad = block_indent(text, block)

    # 1) restore lines we commented out earlier
    _, o, c = block
    inner = text[o + 1:c].replace(REPLACED, "")
    text = text[:o + 1] + inner + text[c:]
    block = kdl_block(text, "binds")

    # 2) drop the old managed region
    region = binds_region(text, block)
    if region:
        text = text[:region[0]] + text[region[1]:]
        block = kdl_block(text, "binds")

    # 3) comment out user bindings that collide with ours
    _, o, c = block
    masked = kdl_mask(text)
    edits = []
    for m in re.finditer(r"(?m)^([ \t]*)([A-Za-z0-9_+]+)(?=[\s{])", masked[o + 1:c]):
        if norm_key(m.group(2)) in keys:
            at = o + 1 + m.start() + len(m.group(1))
            edits.append(at)
    for at in sorted(edits, reverse=True):
        text = text[:at] + REPLACED + text[at:]
    block = kdl_block(text, "binds")

    # 4) write the region right after `binds {`
    _, o, _ = block
    body = "\n".join(pad + l for l in [BINDS_BEGIN, *lines, BINDS_END])
    return text[:o + 1] + "\n" + body + "\n" + text[o + 1:].lstrip("\n")


def kdl_child_block(text: str, parent, name: str):
    """A direct child block `name { … }` of `parent`, with absolute offsets."""
    _, o, c = parent
    rel = kdl_block(text[o + 1:c], name)
    if rel is None:
        return None
    return rel[0] + o + 1, rel[1] + o + 1, rel[2] + o + 1


def keyboard_settings(text: str) -> dict:
    out = {"layout": "", "variant": "", "options": "", "model": "", "repeatDelay": 600, "repeatRate": 25,
           "numlock": False, "trackLayout": "global"}
    inp = kdl_block(text, "input")
    kb = kdl_child_block(text, inp, "keyboard") if inp else None
    if not kb:
        return out
    vals = block_line_values(text, kb, ("repeat-delay", "repeat-rate", "numlock", "track-layout"))
    num = lambda k, d: int(re.search(r"\d+", vals[k][2]).group()) if k in vals and re.search(r"\d+", vals[k][2]) else d
    out["repeatDelay"] = num("repeat-delay", 600)
    out["repeatRate"] = num("repeat-rate", 25)
    out["numlock"] = "numlock" in vals
    if "track-layout" in vals:
        q = re.search(r'"([^"]*)"', vals["track-layout"][2])
        out["trackLayout"] = q.group(1) if q else "global"
    xkb = kdl_child_block(text, kb, "xkb")
    if xkb:
        xv = block_line_values(text, xkb, ("layout", "variant", "options", "model"))
        for k in ("layout", "variant", "options", "model"):
            if k in xv:
                q = re.search(r'"([^"]*)"', xv[k][2])
                out[k] = q.group(1) if q else ""
    return out


def apply_keyboard_input(text: str, kb: dict) -> str:
    if kdl_block(text, "input") is None:
        text = text.rstrip("\n") + "\n\ninput {\n}\n"
    inp = kdl_block(text, "input")
    if kdl_child_block(text, inp, "keyboard") is None:
        pad = block_indent(text, inp)
        text = text[:inp[1] + 1] + f"\n{pad}keyboard {{\n{pad}}}" + text[inp[1] + 1:]
    keyb = kdl_child_block(text, kdl_block(text, "input"), "keyboard")
    if kdl_child_block(text, keyb, "xkb") is None:
        pad = block_indent(text, keyb)
        text = text[:keyb[1] + 1] + f"\n{pad}xkb {{\n{pad}}}" + text[keyb[1] + 1:]
    keyb = kdl_child_block(text, kdl_block(text, "input"), "keyboard")
    xkb = kdl_child_block(text, keyb, "xkb")
    q = lambda k: f"{k} {kdl_quote(str(kb[k]))}" if str(kb.get(k, "")).strip() else None
    text = set_block_lines(text, xkb, {"layout": q("layout"), "variant": q("variant"), "options": q("options"), "model": q("model")})
    keyb = kdl_child_block(text, kdl_block(text, "input"), "keyboard")
    text = set_block_lines(text, keyb, {
        "repeat-delay": f"repeat-delay {int(kb.get('repeatDelay', 600))}",
        "repeat-rate": f"repeat-rate {int(kb.get('repeatRate', 25))}",
        "numlock": "numlock" if kb.get("numlock") else None,
        "track-layout": f"track-layout {kdl_quote(kb.get('trackLayout', 'global'))}" if kb.get("trackLayout", "global") != "global" else None,
    })
    return text


# ─────────────────────────────── mouse & touchpad ────────────────────────────
# niri: input { mouse { … } touchpad { … } }. Hyprland: written with the keyboard
# settings into flamenco-input.conf / flamenco/input.lua.

POINTER_DEFAULTS = {
    "mouseSpeed": 0.0, "mouseAccel": "adaptive", "mouseNatural": False, "mouseLeftHanded": False, "mouseScroll": 1.0,
    "touchSpeed": 0.0, "touchAccel": "adaptive", "touchNatural": True, "tap": True, "dwt": True,
    "touchScroll": 1.0, "disableWithMouse": False,
}
POINTER_ACCEL = ("adaptive", "flat")


def _num(v, lo, hi, d):
    try:
        return max(lo, min(hi, float(v)))
    except (TypeError, ValueError):
        return d


def pointer_norm(p: dict) -> dict:
    out = dict(POINTER_DEFAULTS)
    out.update({k: v for k, v in (p or {}).items() if k in POINTER_DEFAULTS})
    for k in ("mouseSpeed", "touchSpeed"):
        out[k] = round(_num(out[k], -1, 1, 0.0), 2)
    for k in ("mouseScroll", "touchScroll"):
        out[k] = round(_num(out[k], 0.1, 5, 1.0), 2)
    for k in ("mouseAccel", "touchAccel"):
        out[k] = out[k] if out[k] in POINTER_ACCEL else "adaptive"
    return out


def pointer_settings(text: str) -> dict:
    """Read mouse/touchpad settings from niri's config (missing lines = libinput defaults)."""
    out = dict(POINTER_DEFAULTS, touchNatural=False, tap=False, dwt=False)
    inp = kdl_block(text, "input")
    keys = ("accel-speed", "accel-profile", "natural-scroll", "left-handed", "scroll-factor", "tap", "dwt",
            "disabled-on-external-mouse", "off")
    num = lambda v, d: float(m.group()) if (m := re.search(r"-?\d+(\.\d+)?", v)) else d
    prof = lambda v: (m.group(1) if (m := re.search(r'"([^"]*)"', v)) else "adaptive")
    for dev, pre in (("mouse", "mouse"), ("touchpad", "touch")):
        b = kdl_child_block(text, inp, dev) if inp else None
        vals = block_line_values(text, b, keys) if b else {}
        if "accel-speed" in vals:
            out[pre + "Speed"] = num(vals["accel-speed"][2], 0.0)
        if "accel-profile" in vals:
            out[pre + "Accel"] = prof(vals["accel-profile"][2])
        if "scroll-factor" in vals:
            out[pre + "Scroll"] = num(vals["scroll-factor"][2], 1.0)
        out[pre + "Natural"] = "natural-scroll" in vals
        if dev == "mouse":
            out["mouseLeftHanded"] = "left-handed" in vals
        else:
            out["tap"] = "tap" in vals
            out["dwt"] = "dwt" in vals
            out["disableWithMouse"] = "disabled-on-external-mouse" in vals
    return pointer_norm(out)


def apply_pointer_input(text: str, p: dict) -> str:
    p = pointer_norm(p)
    if kdl_block(text, "input") is None:
        text = text.rstrip("\n") + "\n\ninput {\n}\n"
    flag = lambda on, k: k if on else None
    for dev, pre in (("mouse", "mouse"), ("touchpad", "touch")):
        inp = kdl_block(text, "input")
        if kdl_child_block(text, inp, dev) is None:
            pad = block_indent(text, inp)
            text = text[:inp[1] + 1] + f"\n{pad}{dev} {{\n{pad}}}" + text[inp[1] + 1:]
        b = kdl_child_block(text, kdl_block(text, "input"), dev)
        wanted = {
            "accel-speed": f"accel-speed {p[pre + 'Speed']:g}" if p[pre + "Speed"] else None,
            "accel-profile": f'accel-profile "{p[pre + "Accel"]}"' if p[pre + "Accel"] != "adaptive" else None,
            "scroll-factor": f"scroll-factor {p[pre + 'Scroll']:g}" if p[pre + "Scroll"] != 1 else None,
            "natural-scroll": flag(p[pre + "Natural"], "natural-scroll"),
        }
        if dev == "mouse":
            wanted["left-handed"] = flag(p["mouseLeftHanded"], "left-handed")
        else:
            wanted.update({"tap": flag(p["tap"], "tap"), "dwt": flag(p["dwt"], "dwt"),
                           "disabled-on-external-mouse": flag(p["disableWithMouse"], "disabled-on-external-mouse")})
        text = set_block_lines(text, b, wanted)
    return text


def cmd_pointer(args: list[str]) -> int:
    sub = args[0] if args else "get"
    hypr = compositor() == "hyprland"
    if sub == "get":
        if hypr:
            d = lua_read_json("input") if hypr_lua() else hypr_read_json(HYPR_INPUT)
            out = pointer_norm(d.get("pointer") or {})
        else:
            out = pointer_settings(NIRI_CONFIG.read_text() if NIRI_CONFIG.is_file() else "")
        print(json.dumps(out))
        return 0
    if sub == "apply":
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco pointer apply --json SPEC")
        spec = pointer_norm(json.loads(args[args.index("--json") + 1]))
        if hypr:
            (lua_apply_input if hypr_lua() else hypr_apply_input)(None, spec)
            hypr_reload()
            print("pointer: Hyprland config updated")
            return 0
        if not NIRI_CONFIG.is_file():
            die(f"{NIRI_CONFIG} not found (run `flamenco niri-config` first)")
        text = NIRI_CONFIG.read_text()
        new = apply_pointer_input(text, spec)
        write_niri_config(new, text)
        print("pointer: niri config updated" if new != text else "pointer: already up to date")
        return 0
    die("usage: flamenco pointer get | apply --json SPEC")


def xkb_catalog() -> dict:
    """Layouts, variants and options from the XKB rules database."""
    lst = next((p for p in (Path("/usr/share/X11/xkb/rules/evdev.lst"), Path("/usr/share/X11/xkb/rules/base.lst")) if p.exists()), None)
    out = {"layouts": [], "variants": {}, "options": []}
    if not lst:
        return out
    section = ""
    for line in lst.read_text(errors="replace").splitlines():
        if line.startswith("! "):
            section = line[2:].strip()
            continue
        m = re.match(r"\s+(\S+)\s+(.*)", line)
        if not m:
            continue
        code, desc = m.groups()
        if section == "layout":
            out["layouts"].append({"value": code, "label": f"{desc} ({code})"})
        elif section == "variant":
            lay, _, d = desc.partition(":")
            out["variants"].setdefault(lay.strip(), []).append({"value": code, "label": d.strip() or code})
        elif section == "option" and ":" in code:
            out["options"].append({"value": code, "label": desc})
    out["layouts"].sort(key=lambda x: x["label"].lower())
    return out


def find_desktop_entry(app_id: str) -> Path | None:
    name = app_id if app_id.endswith(".desktop") else app_id + ".desktop"
    for d in data_dirs():
        apps = d / "applications"
        for cand in (apps / name, *apps.glob("**/" + name)):
            if cand.is_file():
                return cand
    return None


def cmd_launch(args: list[str]) -> int:
    """Start a desktop app by id (what app shortcuts call)."""
    import shlex
    if not args:
        die("usage: flamenco launch APP_ID")
    entry = find_desktop_entry(args[0])
    if entry is None:
        die(f"no desktop entry for {args[0]!r}")
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    cp.read(entry, encoding="utf-8")
    exe = cp.get("Desktop Entry", "Exec", fallback="")
    if not exe:
        die(f"{entry} has no Exec line")
    argv = [a for a in shlex.split(exe) if not re.fullmatch(r"%[fFuUdDnNickvm]", a)]
    argv = [a.replace("%%", "%") for a in argv]
    if cp.get("Desktop Entry", "Terminal", fallback="false").lower() == "true":
        t = pick_terminal().split()
        name = Path(t[0]).name
        argv = t + (argv if name in ("kitty", "foot") else ["start", "--", *argv] if name == "wezterm" else ["--", *argv] if name in ("gnome-terminal", "kgx") else ["-e", *argv])
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def write_niri_config(new: str, old: str) -> None:
    if new == old:
        return
    tmp = niri_tmp()
    tmp.write_text(new)
    if not niri_validate(tmp):
        r = subprocess.run(["niri", "validate", "-c", str(tmp)], capture_output=True, text=True)
        tmp.unlink()
        msg = (r.stderr or r.stdout).strip().splitlines()
        die("niri rejected the change: " + (msg[-1] if msg else "invalid config") + " (config.kdl left untouched)")
    backup = BACKUP_DIR / "niri-config.before-keyboard.kdl"
    if not backup.exists():
        backup.parent.mkdir(parents=True, exist_ok=True)
        backup.write_text(old)
    niri_commit(tmp)


def cmd_keyboard(args: list[str]) -> int:
    sub = args[0] if args else "get"
    if compositor() == "hyprland" and sub in ("get", "apply"):
        if sub == "get":
            kb = {"layout": "", "variant": "", "options": "", "model": "", "repeatDelay": 600, "repeatRate": 25,
                  "numlock": True, "trackLayout": "global"}
            if hypr_lua():
                kb.update(lua_read_json("input").get("input", {}))
                kb["shortcuts"] = lua_read_json("binds").get("shortcuts")
            else:
                kb.update(hypr_read_json(HYPR_INPUT).get("input", {}))
                kb["shortcuts"] = hypr_read_json(HYPR_BINDS).get("shortcuts")
            kb["others"], kb["replaced"] = [], []
            print(json.dumps(kb))
            return 0
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco keyboard apply --json SPEC")
        spec = json.loads(args[args.index("--json") + 1])
        try:
            if spec.get("input") is not None:
                (lua_apply_input if hypr_lua() else hypr_apply_input)(spec["input"])
            if spec.get("shortcuts") is not None:
                (lua_apply_shortcuts if hypr_lua() else hypr_apply_shortcuts)(spec["shortcuts"])
        except ValueError as e:
            die(str(e))
        hypr_reload()
        print("keyboard: Hyprland config updated")
        return 0
    text = NIRI_CONFIG.read_text() if NIRI_CONFIG.is_file() else ""
    if sub == "get":
        out = keyboard_settings(text)
        out["shortcuts"] = managed_shortcuts(text)
        out["others"] = other_bind_keys(text)
        # user bindings we've commented out because a Flamenco shortcut took the key
        out["replaced"] = [{"key": m.group(1), "line": m.group(0).strip()}
                           for m in re.finditer(r"(?m)" + re.escape(REPLACED) + r"([A-Za-z0-9_+]+)[^\n]*", text)]
        print(json.dumps(out))
        return 0
    if sub == "defaults":
        print(json.dumps(DEFAULT_SHORTCUTS))
        return 0
    if sub == "functions":
        print(json.dumps([{"value": k, "label": v[0]} for k, v in SHELL_FUNCTIONS.items()]))
        return 0
    if sub == "layouts":
        print(json.dumps(xkb_catalog()))
        return 0
    if sub == "apply":
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco keyboard apply --json SPEC")
        spec = json.loads(args[args.index("--json") + 1])
        if not NIRI_CONFIG.is_file():
            die(f"{NIRI_CONFIG} not found (run `flamenco niri-config` first)")
        new = text
        try:
            if spec.get("input") is not None:
                new = apply_keyboard_input(new, spec["input"])
            if spec.get("shortcuts") is not None:
                new = apply_shortcuts(new, spec["shortcuts"])
        except ValueError as e:
            die(str(e))
        write_niri_config(new, text)
        print("keyboard: niri config updated" if new != text else "keyboard: already up to date")
        return 0
    die("usage: flamenco keyboard get | defaults | functions | layouts | apply --json SPEC")


# ─────────────────────────────── folder picker ───────────────────────────────
# The xdg-desktop-portal FileChooser first, so the file chooser picked on the
# portals page is the one that opens; kdialog / zenity / yad if there's no portal.

def portal_pick(start: str, title: str, folder: bool):
    """Chosen path, "" if cancelled, None if the portal can't be used."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except Exception:          # no PyGObject (or something else called gi)
        return None
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except GLib.Error:
        return None
    # the answer comes as a Response signal on a request object whose path is
    # known up front; subscribe before asking so it can't be missed
    token = f"flamenco_{os.getpid()}"
    sender = bus.get_unique_name().lstrip(":").replace(".", "_")
    request = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    result = {}

    def on_response(_conn, _sender, _path, _iface, _signal, params, *_):
        code, res = params.unpack()
        result["code"] = code
        result["uris"] = res.get("uris", [])
        loop.quit()

    sub = bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response",
                               request, None, Gio.DBusSignalFlags.NONE, on_response)
    opts = {"handle_token": GLib.Variant("s", token), "directory": GLib.Variant("b", folder),
            "modal": GLib.Variant("b", True)}
    if not folder:
        # one filter, by MIME type (1 = MIME pattern)
        opts["filters"] = GLib.Variant("a(sa(us))", [("Images", [(1, "image/*")])])
    if start and os.path.isdir(start):
        opts["current_folder"] = GLib.Variant.new_bytestring(os.fsencode(start))
    try:
        bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                      "org.freedesktop.portal.FileChooser", "OpenFile",
                      GLib.Variant("(ssa{sv})", ("", title, opts)), GLib.VariantType("(o)"),
                      Gio.DBusCallFlags.NONE, -1, None)
    except GLib.Error:
        # no portal running, or no FileChooser backend for this desktop
        bus.signal_unsubscribe(sub)
        return None
    loop.run()
    bus.signal_unsubscribe(sub)
    if result.get("code") == 1:
        return ""
    if result.get("code") != 0:
        return None
    uris = result.get("uris") or []
    return Gio.File.new_for_uri(uris[0]).get_path() or "" if uris else ""


def cmd_pick(args: list[str]) -> int:
    if not args or args[0] not in ("folder", "image"):
        die("usage: flamenco pick folder|image [START]")
    folder = args[0] == "folder"
    start = Path(args[1]).expanduser() if len(args) > 1 and args[1] else Path.home()
    if not folder and start.is_file():
        start = start.parent
    start = str(start)
    title = "Choose a folder" if folder else "Choose an image"
    picked = portal_pick(start, title, folder)
    if picked is None:
        images = "*.jpg *.jpeg *.png *.webp *.bmp *.gif *.avif *.jxl *.mp4 *.webm *.mkv *.mov"
        if shutil.which("kdialog"):
            cmd = ["kdialog", "--title", title] + (["--getexistingdirectory", start] if folder else ["--getopenfilename", start, f"Images ({images})"])
        elif shutil.which("zenity"):
            cmd = ["zenity", "--file-selection", "--title", title, f"--filename={start}/"] + (["--directory"] if folder else [f"--file-filter=Images | {images}"])
        elif shutil.which("yad"):
            cmd = ["yad", "--file", "--title", title, f"--filename={start}/"] + (["--directory"] if folder else [f"--file-filter=Images | {images}"])
        else:
            # the shell shows this; on a terminal it's the reason nothing opened
            print("@none")
            print("flamenco: no file chooser: install xdg-desktop-portal-gtk (or -gnome / -kde), "
                  "or kdialog / zenity", file=sys.stderr)
            return 1
        picked = subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
    if picked:
        print(picked)
    return 0


# ─────────────────────────────── login screen (greetd + Flamenco Greeter) ────
# greetd runs a greeter as its own user before anyone logs in. Like dms-greeter,
# Flamenco Greeter can't read your home folder, so `greeter apply` copies what it
# needs (config.json, the wallpaper, avatars) into GREETER_DIR, which it reads.
# The format of that folder is described in docs/greeter.md.

GREETD_CONFIG = Path(os.environ.get("FLAMENCO_GREETD_CONFIG", "/etc/greetd/config.toml"))
GREETER_DIR = Path(os.environ.get("FLAMENCO_GREETER_DIR", "/var/cache/flamenco-greeter"))
GREETER_BIN = "flamenco-greeter"
GREETER_SCHEMA = 1
SESSION_DIRS = [("wayland", Path("/usr/share/wayland-sessions")), ("wayland", Path("/usr/local/share/wayland-sessions")),
                ("x11", Path("/usr/share/xsessions")), ("x11", Path("/usr/local/share/xsessions"))]
VT_WORDS = ("next", "current", "none")


def login_sessions() -> list[dict]:
    out, seen = [], set()
    for kind, d in SESSION_DIRS:
        for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
            if f.name in seen:
                continue
            seen.add(f.name)
            e = read_desktop(f)
            if not e or e.get("Hidden", "").lower() == "true" or e.get("NoDisplay", "").lower() == "true":
                continue
            out.append({"id": f.name, "name": e.get("Name", f.stem), "exec": e.get("Exec", ""), "type": kind,
                        "comment": e.get("Comment", "")})
    return out


def login_users() -> list[dict]:
    import pwd
    shells = set()
    try:
        shells = {l.strip() for l in Path("/etc/shells").read_text().splitlines() if l.strip() and not l.startswith("#")}
    except OSError:
        pass
    users = []
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 60000 and (not shells or p.pw_shell in shells):
            users.append({"name": p.pw_name, "uid": p.pw_uid, "fullName": p.pw_gecos.split(",")[0] or p.pw_name})
    return sorted(users, key=lambda u: u["uid"])


def user_exists(name: str) -> bool:
    import pwd
    try:
        pwd.getpwnam(name)
        return True
    except KeyError:
        return False


def read_greetd() -> dict:
    """greetd's config as a dict ({} if missing); "error" if it doesn't parse."""
    import tomllib
    try:
        return tomllib.loads(GREETD_CONFIG.read_text())
    except FileNotFoundError:
        return {}
    except PermissionError:
        return {"error": f"{GREETD_CONFIG} isn't readable"}
    except tomllib.TOMLDecodeError as e:
        return {"error": f"{GREETD_CONFIG}: {e}"}


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    return json.dumps(str(v), ensure_ascii=False)     # a JSON string is a valid TOML basic string


def dump_greetd(cfg: dict) -> str:
    out = ["# greetd configuration, written by Flamenco Settings (flamenco greeter greetd)",
           "# The previous version is kept next to it as config.toml.bak-<date>, the very first as config.toml.orig.", ""]
    order = ["terminal", "general", "default_session", "initial_session"]
    for sec in order + [k for k in cfg if k not in order]:
        body = cfg.get(sec)
        if not isinstance(body, dict) or not body:
            continue
        out.append(f"[{sec}]")
        out += [f"{k} = {toml_value(v)}" for k, v in body.items() if not isinstance(v, dict)]
        out.append("")
    return "\n".join(out)


def command_exists(command: str) -> bool:
    import shlex
    try:
        first = shlex.split(command)[0]
    except (ValueError, IndexError):
        return False
    if "/" in first:
        return os.access(first, os.X_OK)
    return shutil.which(first) is not None or any(os.access(Path(d) / first, os.X_OK) for d in ("/usr/bin", "/usr/local/bin"))


def unit_enabled(unit: str) -> str:
    return run_out(["systemctl", "is-enabled", unit]).strip() or "not-found"


def greeter_status() -> dict:
    cfg = read_greetd()
    dm = ""
    try:
        dm = os.path.basename(os.readlink("/etc/systemd/system/display-manager.service")).removesuffix(".service")
    except OSError:
        pass
    applied = {}
    try:
        applied = json.loads((GREETER_DIR / "config.json").read_text())
    except (OSError, ValueError):
        pass
    default = cfg.get("default_session", {}) if isinstance(cfg.get("default_session"), dict) else {}
    initial = cfg.get("initial_session", {}) if isinstance(cfg.get("initial_session"), dict) else {}
    return {
        "greetdInstalled": bool(shutil.which("greetd") or Path("/usr/bin/greetd").exists()),
        "greetdEnabled": unit_enabled("greetd.service") == "enabled",
        "greetdActive": run_out(["systemctl", "is-active", "greetd.service"]).strip() == "active",
        "displayManager": dm,
        "greeterInstalled": shutil.which(GREETER_BIN) is not None,
        "greeterCommand": GREETER_BIN,
        "greeters": [g for g in (GREETER_BIN, "tuigreet", "agreety", "gtkgreet", "regreet", "nwg-hello", "dms-greeter") if shutil.which(g)],
        "config": {
            "path": str(GREETD_CONFIG),
            "exists": GREETD_CONFIG.exists(),
            "error": cfg.get("error", ""),
            "vt": cfg.get("terminal", {}).get("vt", 1) if isinstance(cfg.get("terminal"), dict) else 1,
            "command": default.get("command", ""),
            "user": default.get("user", "greeter"),
            "autologin": bool(initial.get("command")),
            "autologinCommand": initial.get("command", ""),
            "autologinUser": initial.get("user", ""),
        },
        "applied": applied,
        "appliedDir": str(GREETER_DIR),
        "fingerprintPam": pam_uses("greetd", "pam_fprintd.so"),
        "sessions": login_sessions(),
        "users": login_users(),
        "me": os.environ.get("USER") or HOME.name,
    }


def greeter_config(spec: dict) -> tuple[dict, dict]:
    """(config.json for the greeter, {staged name: source file}) from the settings page's spec."""
    files: dict[str, Path] = {}
    wp = spec.get("wallpaper", {})
    mode = wp.get("mode", "desktop")
    wallpaper = {"mode": "color", "file": "", "fillMode": wp.get("fillMode", "crop"),
                 "blur": max(0.0, min(1.0, float(wp.get("blur", 0)))), "dim": max(0.0, min(1.0, float(wp.get("dim", 0)))),
                 "color": str(wp.get("color") or "#000000")}
    src = Path(str(wp.get("path", ""))).expanduser() if mode in ("desktop", "custom") else None
    if src is not None:
        if not src.is_file():
            die(f"wallpaper not found: {src}")
        # a live wallpaper: the login screen gets its still
        if src.suffix.lower() in (".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi"):
            src = live_poster(Path(os.path.abspath(src))) or die(f"couldn't make a still of {src} for the login screen (is ffmpeg installed?)")
        name = "wallpaper" + src.suffix.lower()
        files[name] = src
        wallpaper.update(mode="image", file=name)
    avatars = {}
    for user, path in (spec.get("avatars") or {}).items():
        p = Path(str(path)).expanduser()
        if p.is_file() and re.fullmatch(r"[a-z_][a-z0-9_.-]*", user):
            name = f"avatars/{user}{p.suffix.lower() or '.png'}"
            files[name] = p
            avatars[user] = name
    s, u, a = spec.get("sessions", {}), spec.get("users", {}), spec.get("appearance", {})
    cfg = {
        "version": GREETER_SCHEMA,
        "generator": f"flamenco-shell {VERSION}",
        "appearance": {
            "dark": bool(a.get("dark", True)),
            "colors": {k: str(v) for k, v in (a.get("colors") or {}).items()},
            "fontFamily": a.get("fontFamily") or "Google Sans Flex",
            "monoFamily": a.get("monoFamily") or "monospace",
            "fontScale": max(0.5, min(2.0, float(a.get("fontScale", 1.0)))),
            "roundness": float(a.get("roundness", 1.0)),
        },
        "wallpaper": wallpaper,
        "clock": {"use24h": bool(spec.get("clock", {}).get("use24h", True)),
                  "showSeconds": bool(spec.get("clock", {}).get("showSeconds", False))},
        "sessions": {"picker": bool(s.get("picker", True)), "default": str(s.get("default", "")),
                     "hidden": [str(x) for x in s.get("hidden", [])]},
        "users": {"list": bool(u.get("list", True)), "rememberLast": bool(u.get("rememberLast", True)),
                  "default": str(u.get("default", "")), "avatars": avatars},
        "power": {"buttons": bool(spec.get("power", {}).get("buttons", True))},
        "auth": {"fingerprint": bool(spec.get("auth", {}).get("fingerprint", False))},
    }
    return cfg, files


def greeter_install_files(cfg: dict, files: dict, owner: str) -> int:
    """Stage config.json + files, then copy them into GREETER_DIR as root in one go."""
    import tempfile
    stage = Path(tempfile.mkdtemp(prefix="flamenco-greeter-"))
    try:
        (stage / "avatars").mkdir()
        (stage / "config.json").write_text(json.dumps(cfg, indent=2) + "\n")
        for name, src in files.items():
            shutil.copyfile(src, stage / name)
        os.chmod(stage, 0o755)
        for p in stage.rglob("*"):
            os.chmod(p, 0o755 if p.is_dir() else 0o644)
        # The folder belongs to the greeter user so it can keep its own state (last user
        # and session); what we put there is root's and read-only. Because the greeter
        # account can write that folder, root never follows anything in it: the new
        # files are made in a fresh root-only folder inside it (mktemp: never an existing
        # name), get their permissions there, and are renamed into place. rename()
        # replaces a planted symlink rather than writing through it, and a name that
        # reappears between the rm and the mv makes `mv -T` fail (set -e) instead.
        script = r'''set -eu
stage=$1 dest=$2 owner=$3
install -d -m 0755 -o root -g root "$dest"
if id -u "$owner" >/dev/null 2>&1; then chown -h "$owner:" "$dest"; fi
new=$(mktemp -d -p "$dest" .flamenco-new.XXXXXX)
trap 'rm -rf -- "$new"' EXIT
cp -r --no-preserve=all -- "$stage"/. "$new"/
find "$new" -type l -delete
chown -R root:root -- "$new"
find "$new" -type d -exec chmod 0755 {} +
find "$new" -type f -exec chmod 0644 {} +
chmod 0755 "$new"
rm -f -- "$dest"/wallpaper.*
rm -rf -- "$dest/avatars"
mv -T -- "$new/avatars" "$dest/avatars"
for f in "$new"/*; do
    [ -e "$f" ] || continue
    mv -fT -- "$f" "$dest/${f##*/}"
done
'''
        return privileged(["sh", "-c", script, "sh", str(stage), str(GREETER_DIR), owner])
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def greetd_merge(spec: dict) -> dict:
    """The new greetd config: the current one with the page's changes, checked."""
    cfg = read_greetd()
    if cfg.get("error"):
        die(cfg["error"] + " (fix it by hand first; nothing was changed)")
    vt = spec.get("vt", cfg.get("terminal", {}).get("vt", 1))
    if isinstance(vt, str) and vt.isdigit():
        vt = int(vt)
    if not (isinstance(vt, int) and 1 <= vt <= 63) and vt not in VT_WORDS:
        die(f"vt must be a number 1-63 or one of {', '.join(VT_WORDS)}")
    command = str(spec.get("command", cfg.get("default_session", {}).get("command", ""))).strip()
    user = str(spec.get("user", cfg.get("default_session", {}).get("user", "greeter"))).strip() or "greeter"
    if not command:
        die("greetd needs a greeter command")
    # a greeter that isn't installed would leave you without a login screen
    if not command_exists(command):
        die(f"'{command.split()[0]}' isn't installed; greetd would have no login screen. Nothing was changed.")
    if not user_exists(user):
        die(f"user '{user}' doesn't exist (greetd's package creates 'greeter')")
    cfg.setdefault("terminal", {})["vt"] = vt
    cfg["default_session"] = dict(cfg.get("default_session", {}), command=command, user=user)
    if spec.get("autologin"):
        auser = str(spec.get("autologinUser", "")).strip()
        acmd = str(spec.get("autologinCommand", "")).strip()
        if not auser or not user_exists(auser):
            die(f"auto-login user '{auser}' doesn't exist")
        if not acmd or not command_exists(acmd):
            die(f"auto-login session command '{acmd}' isn't installed")
        cfg["initial_session"] = {"command": acmd, "user": auser}
    else:
        cfg.pop("initial_session", None)
    return cfg


def greetd_write(cfg: dict) -> int:
    import tempfile
    from datetime import datetime
    fd, tmp = tempfile.mkstemp(prefix="greetd-", suffix=".toml")
    with os.fdopen(fd, "w") as f:
        f.write(dump_greetd(cfg))
    os.chmod(tmp, 0o644)
    bak = f"{GREETD_CONFIG}.bak-{datetime.now():%Y%m%d-%H%M%S}"
    script = 'set -e; install -d -m 0755 "$(dirname "$2")"; if [ -f "$2" ]; then cp -p "$2" "$3"; [ -e "$2.orig" ] || cp -p "$2" "$2.orig"; fi; install -m 0644 -o root -g root "$1" "$2"'
    try:
        return privileged(["sh", "-c", script, "sh", tmp, str(GREETD_CONFIG), bak])
    finally:
        os.unlink(tmp)


def cmd_greeter(args: list[str]) -> int:
    sub = args[0] if args else "status"
    if sub == "status":
        print(json.dumps(greeter_status(), indent=None if "--json" in args else 2))
        return 0
    if sub == "sessions":
        for s in login_sessions():
            print(f"{s['id']}\t{s['name']}\t{s['exec']}")
        return 0
    if sub in ("apply", "greetd") and len(args) >= 3 and args[1] == "--json":
        try:
            spec = json.loads(args[2])
        except ValueError as e:
            die(f"bad --json: {e}")
        if sub == "apply":
            cfg, files = greeter_config(spec)
            owner = read_greetd().get("default_session", {}).get("user", "greeter") if GREETD_CONFIG.exists() else "greeter"
            if greeter_install_files(cfg, files, str(owner)) != 0:
                die("couldn't write the login screen settings")
            print(f"greeter: wrote {GREETER_DIR}/config.json" + (f" and {len(files)} file(s)" if files else ""))
            return 0
        cfg = greetd_merge(spec)
        if greetd_write(cfg) != 0:
            die(f"couldn't write {GREETD_CONFIG}")
        print(f"greetd: wrote {GREETD_CONFIG} (previous version kept as config.toml.bak-<date>, the original as config.toml.orig)")
        print("        it's used from the next time greetd starts (next boot, or log out)")
        return 0
    if sub == "enable":
        # make greetd the display manager at boot (replaces SDDM, GDM, ly…)
        if not (shutil.which("greetd") or Path("/usr/bin/greetd").exists()):
            die(f"greetd isn't installed ({install_hint('greetd')})")
        cfg = read_greetd()
        command = cfg.get("default_session", {}).get("command", "") if not cfg.get("error") else ""
        if not command or not command_exists(command):
            die("set up a greeter that's installed first (greetd's default_session command); nothing was changed")
        if privileged(["systemctl", "enable", "--force", "greetd.service"]) != 0:
            die("couldn't enable greetd")
        print("greetd: enabled; it replaces your current login manager from the next boot")
        return 0
    die("usage: flamenco greeter status [--json] | sessions | apply --json SPEC | greetd --json SPEC | enable")


# ─────────────────────────────── network connections (nmcli) ────────────────
# Settings → Network edits Wi-Fi and wired connections itself instead of handing
# off to nm-connection-editor. Values are checked here before nmcli sees them.
# Saved passwords are never read back: a new one can only be set.

UUID_RE = re.compile(r"^[0-9a-fA-F-]{36}$")
NET_FIELDS = (
    "connection.id", "connection.uuid", "connection.type", "connection.interface-name", "connection.autoconnect",
    "connection.autoconnect-priority", "connection.metered",
    "802-11-wireless.ssid", "802-11-wireless.hidden", "802-11-wireless.band", "802-11-wireless.cloned-mac-address",
    "802-11-wireless.mtu", "802-11-wireless-security.key-mgmt",
    "802-3-ethernet.cloned-mac-address", "802-3-ethernet.mtu",
    "ipv4.method", "ipv4.addresses", "ipv4.gateway", "ipv4.dns", "ipv4.ignore-auto-dns", "ipv4.dns-search", "ipv4.never-default",
    "ipv6.method", "ipv6.addresses", "ipv6.gateway", "ipv6.dns", "ipv6.ignore-auto-dns", "ipv6.dns-search", "ipv6.never-default",
    "ipv6.ip6-privacy",
    "GENERAL.STATE", "GENERAL.DEVICES",
)
IP4_METHODS = ("auto", "manual", "link-local", "shared", "disabled")
IP6_METHODS = ("auto", "dhcp", "manual", "link-local", "ignore", "disabled", "shared")
MAC_MODES = ("", "permanent", "random", "stable", "preserve")


def nm_unescape(v: str) -> str:
    return re.sub(r"\\(.)", r"\1", v)


def nm_terse_fields(line: str) -> list[str]:
    """Split one `nmcli -t` line on unescaped colons."""
    out, cur, i = [], "", 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur += line[i + 1]
            i += 2
            continue
        if c == ":":
            out.append(cur)
            cur = ""
        else:
            cur += c
        i += 1
    out.append(cur)
    return out


def nm_records(text: str) -> dict:
    """`nmcli -t` multiline output (key:value per line) → {key: value}; [n] keys become lists."""
    rec: dict = {}
    for line in text.splitlines():
        if ":" not in line:
            continue
        key, val = line.split(":", 1)
        val = nm_unescape(val)
        m = re.match(r"^(.*)\[\d+\]$", key)
        if m:
            rec.setdefault(m.group(1), []).append(val)
        else:
            rec[key] = val
    return rec


def nm_list(v) -> list[str]:
    if isinstance(v, list):
        return [x.strip() for x in v if x.strip() and x.strip() != "--"]
    return [x.strip() for x in str(v or "").split(",") if x.strip() and x.strip() != "--"]


def nm_val(v) -> str:
    v = str(v if v is not None else "")
    return "" if v == "--" else v


def nmcli(args: list[str], root: bool = False) -> subprocess.CompletedProcess:
    cmd = ["nmcli"] + args
    if root:
        rc = privileged(cmd)
        return subprocess.CompletedProcess(cmd, rc, "", "")
    return subprocess.run(cmd, capture_output=True, text=True)


def net_devices() -> list[dict]:
    out = []
    r = nmcli(["-t", "-f", "DEVICE,TYPE,STATE,CON-UUID,CONNECTION", "device"])
    for line in r.stdout.splitlines():
        f = nm_terse_fields(line)
        if len(f) < 5 or f[1] not in ("ethernet", "wifi"):
            continue
        dev = {"device": f[0], "type": f[1], "state": f[2], "uuid": f[3], "connection": f[4]}
        info = nm_records(nmcli(["-t", "device", "show", f[0]]).stdout)
        dev.update({
            "mac": info.get("GENERAL.HWADDR", ""),
            "ip4": nm_list(info.get("IP4.ADDRESS", [])), "gateway4": nm_val(info.get("IP4.GATEWAY", "")),
            "dns4": nm_list(info.get("IP4.DNS", [])),
            "ip6": nm_list(info.get("IP6.ADDRESS", [])), "gateway6": nm_val(info.get("IP6.GATEWAY", "")),
            "speed": nm_val(info.get("CAPABILITIES.SPEED", "")),
            "driver": nm_val(info.get("GENERAL.DRIVER", "")),
        })
        out.append(dev)
    return out


def net_list() -> dict:
    conns = []
    r = nmcli(["-t", "-f", "NAME,UUID,TYPE,DEVICE,ACTIVE,AUTOCONNECT,TIMESTAMP", "connection", "show"])
    for line in r.stdout.splitlines():
        f = nm_terse_fields(line)
        if len(f) < 7:
            continue
        kind = {"802-11-wireless": "wifi", "802-3-ethernet": "ethernet"}.get(f[2])
        if not kind:
            continue
        conns.append({"name": f[0], "uuid": f[1], "type": kind, "device": f[3], "active": f[4] == "yes",
                      "autoconnect": f[5] == "yes", "lastUsed": int(f[6] or 0)})
    conns.sort(key=lambda c: (not c["active"], c["type"], -c["lastUsed"], c["name"].lower()))
    return {"installed": shutil.which("nmcli") is not None, "connections": conns, "devices": net_devices(),
            "error": "" if r.returncode == 0 else (r.stderr.strip() or "nmcli failed")}


def net_get(uuid: str) -> dict:
    r = nmcli(["-t", "-f", ",".join(NET_FIELDS), "connection", "show", uuid])
    if r.returncode != 0:
        die((r.stderr.strip() or "no such connection").splitlines()[-1])
    rec = nm_records(r.stdout)
    kind = {"802-11-wireless": "wifi", "802-3-ethernet": "ethernet"}.get(rec.get("connection.type", ""), "other")
    key = "802-11-wireless" if kind == "wifi" else "802-3-ethernet"
    km = nm_val(rec.get("802-11-wireless-security.key-mgmt", ""))
    yes = lambda k: nm_val(rec.get(k, "")) == "yes"
    out = {
        "uuid": uuid, "type": kind, "name": rec.get("connection.id", ""),
        "active": bool(nm_val(rec.get("GENERAL.STATE", ""))), "device": nm_val(rec.get("GENERAL.DEVICES", "")),
        "interface": nm_val(rec.get("connection.interface-name", "")),
        "autoconnect": yes("connection.autoconnect"),
        "priority": int(nm_val(rec.get("connection.autoconnect-priority", "0")) or 0),
        "metered": nm_val(rec.get("connection.metered", "unknown")) or "unknown",
        "mac": nm_val(rec.get(f"{key}.cloned-mac-address", "")),
        "mtu": nm_val(rec.get(f"{key}.mtu", "auto")).replace("auto", "") or "",
        "ssid": nm_val(rec.get("802-11-wireless.ssid", "")), "hidden": yes("802-11-wireless.hidden"),
        "band": nm_val(rec.get("802-11-wireless.band", "")),
        "security": "none" if not km else km,
        "ip4": {"method": nm_val(rec.get("ipv4.method", "auto")) or "auto", "addresses": nm_list(rec.get("ipv4.addresses")),
                "gateway": nm_val(rec.get("ipv4.gateway", "")), "dns": nm_list(rec.get("ipv4.dns")),
                "autoDns": not yes("ipv4.ignore-auto-dns"), "search": nm_list(rec.get("ipv4.dns-search")),
                "neverDefault": yes("ipv4.never-default")},
        "ip6": {"method": nm_val(rec.get("ipv6.method", "auto")) or "auto", "addresses": nm_list(rec.get("ipv6.addresses")),
                "gateway": nm_val(rec.get("ipv6.gateway", "")), "dns": nm_list(rec.get("ipv6.dns")),
                "autoDns": not yes("ipv6.ignore-auto-dns"), "search": nm_list(rec.get("ipv6.dns-search")),
                "neverDefault": yes("ipv6.never-default"),
                "privacy": {"-1": "default", "0": "off", "1": "public", "2": "temporary"}.get(
                    (re.match(r"\s*(-?\d+)", nm_val(rec.get("ipv6.ip6-privacy", ""))) or re.match("(-1)", "-1")).group(1), "default")},
    }
    return out


def net_check_list(vals, kind: str, family: int) -> str:
    """Comma-separated, validated: kind is 'iface' (address/prefix), 'addr' or 'domain'."""
    import ipaddress
    raw = vals if isinstance(vals, list) else str(vals or "").replace(";", ",").replace(" ", ",").split(",")
    items = [str(x).strip() for x in raw if str(x).strip()]
    if kind == "iface":
        # an address without a prefix gets the usual one
        items = [it if "/" in it else it + ("/24" if family == 4 else "/64") for it in items]
    for it in items:
        try:
            if kind == "iface":
                ok = ipaddress.ip_interface(it).version == family
            elif kind == "addr":
                ok = ipaddress.ip_address(it).version == family
            else:
                ok = bool(re.fullmatch(r"~?[A-Za-z0-9.-]{1,253}", it))
        except ValueError:
            ok = False
        if not ok:
            die(f"not a valid IPv{family} {'address' if kind != 'domain' else 'search domain'}: {it}")
    return ",".join(items)


def net_set_args(cur: dict, spec: dict) -> list[str]:
    """nmcli `connection modify` arguments for what changed in spec."""
    import ipaddress
    a: list[str] = []
    key = "802-11-wireless" if cur["type"] == "wifi" else "802-3-ethernet"

    def put(k, v):
        a.extend([k, str(v)])

    if "name" in spec:
        name = str(spec["name"]).strip()
        if not name or "\n" in name:
            die("the connection needs a name")
        if name != cur["name"]:
            put("connection.id", name)
    if "autoconnect" in spec:
        put("connection.autoconnect", "yes" if spec["autoconnect"] else "no")
    if "priority" in spec:
        put("connection.autoconnect-priority", max(-999, min(999, int(spec["priority"]))))
    if "metered" in spec:
        if spec["metered"] not in ("unknown", "yes", "no"):
            die("metered must be unknown, yes or no")
        put("connection.metered", spec["metered"])
    if "mac" in spec:
        mac = str(spec["mac"]).strip().lower()
        if mac not in MAC_MODES and not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
            die(f"MAC address must be default, permanent, random, stable or a MAC: {mac}")
        put(f"{key}.cloned-mac-address", mac)
    if "mtu" in spec:
        mtu = str(spec["mtu"]).strip()
        if mtu and not (mtu.isdigit() and 576 <= int(mtu) <= 9000):
            die("MTU must be empty (automatic) or 576–9000")
        put(f"{key}.mtu", mtu or "0")
    if cur["type"] == "wifi":
        if "ssid" in spec:
            ssid = str(spec["ssid"])
            if not 1 <= len(ssid.encode()) <= 32:
                die("a Wi-Fi name is 1–32 bytes")
            put("802-11-wireless.ssid", ssid)
        if "hidden" in spec:
            put("802-11-wireless.hidden", "yes" if spec["hidden"] else "no")
        if "band" in spec:
            if spec["band"] not in ("", "a", "bg"):
                die("band must be empty (any), a (5 GHz) or bg (2.4 GHz)")
            put("802-11-wireless.band", spec["band"])
            if spec["band"] == "":
                put("802-11-wireless.channel", "0")
        sec, pw = spec.get("security"), str(spec.get("password") or "")
        if sec is not None and sec != cur["security"] or pw:
            sec = sec or cur["security"]
            if sec == "none":
                pass                # cmd_net removes the security setting first
            elif sec in ("wpa-psk", "sae"):
                if not pw and cur["security"] not in ("wpa-psk", "sae"):
                    die("enter the Wi-Fi password")
                if pw and not 8 <= len(pw) <= 63:
                    die("a WPA password is 8–63 characters")
                put("802-11-wireless-security.key-mgmt", sec)
                if pw:
                    put("802-11-wireless-security.psk", pw)
            elif sec != cur["security"]:
                die("only open, WPA/WPA2 and WPA3 personal security can be set here")
    for fam in (4, 6):
        s = spec.get(f"ip{fam}")
        if not isinstance(s, dict):
            continue
        p = f"ipv{fam}"
        methods = IP4_METHODS if fam == 4 else IP6_METHODS
        method = s.get("method", cur[f"ip{fam}"]["method"])
        if method not in methods:
            die(f"IPv{fam} method must be one of: {', '.join(methods)}")
        addrs = net_check_list(s.get("addresses", cur[f"ip{fam}"]["addresses"]), "iface", fam)
        if method == "manual" and not addrs:
            die(f"manual IPv{fam} needs at least one address")
        gw = str(s.get("gateway", cur[f"ip{fam}"]["gateway"]) or "").strip()
        if gw:
            try:
                if ipaddress.ip_address(gw).version != fam:
                    raise ValueError
            except ValueError:
                die(f"not a valid IPv{fam} gateway: {gw}")
        put(f"{p}.method", method)
        put(f"{p}.addresses", addrs)
        put(f"{p}.gateway", gw)
        put(f"{p}.dns", net_check_list(s.get("dns", cur[f"ip{fam}"]["dns"]), "addr", fam))
        put(f"{p}.dns-search", net_check_list(s.get("search", cur[f"ip{fam}"]["search"]), "domain", fam))
        put(f"{p}.ignore-auto-dns", "no" if s.get("autoDns", cur[f"ip{fam}"]["autoDns"]) else "yes")
        put(f"{p}.never-default", "yes" if s.get("neverDefault", cur[f"ip{fam}"]["neverDefault"]) else "no")
        if fam == 6 and "privacy" in s:
            pv = {"default": "-1", "off": "0", "public": "1", "temporary": "2"}.get(s["privacy"])
            if pv is None:
                die("IPv6 privacy must be default, off, public or temporary")
            put("ipv6.ip6-privacy", pv)
    return a


def net_apply(cur: dict, root: bool) -> None:
    """Make a saved change take effect on an active connection."""
    if not cur["active"]:
        return
    dev = cur["device"].split(",")[0]
    if dev and nmcli(["device", "reapply", dev], root).returncode == 0:
        return
    nmcli(["connection", "up", cur["uuid"]], root)


def net_fail(r: subprocess.CompletedProcess, what: str) -> None:
    msg = (r.stderr or r.stdout or "").strip().splitlines()
    msg = msg[-1] if msg else f"nmcli exited with {r.returncode}"
    if re.search(r"(?i)insufficient privileges|not authorized|permission", msg):
        die(f"{what}: NetworkManager needs administrator rights for this (permission)", 3)
    die(f"{what}: {msg.removeprefix('Error: ')}")


def cmd_net(args: list[str]) -> int:
    root = "--sudo" in args
    args = [x for x in args if x != "--sudo"]
    sub = args[0] if args else "list"
    if not shutil.which("nmcli"):
        die("NetworkManager (nmcli) isn't installed")
    if sub == "list":
        print(json.dumps(net_list()))
        return 0
    uuid = args[1] if len(args) > 1 else ""
    if sub in ("get", "set", "delete", "up", "down") and not UUID_RE.match(uuid):
        die("usage: flamenco net get|set|delete|up|down UUID")
    if sub == "get":
        print(json.dumps(net_get(uuid)))
        return 0
    if sub == "set":
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco net set UUID --json SPEC")
        spec = json.loads(args[args.index("--json") + 1])
        cur = net_get(uuid)
        mod = net_set_args(cur, spec)
        if spec.get("security") == "none" and cur["security"] not in ("none", ""):
            r = nmcli(["connection", "modify", uuid, "remove", "802-11-wireless-security"], root)
            if r.returncode != 0:
                net_fail(r, "couldn't remove the Wi-Fi password")
        if mod:
            r = nmcli(["connection", "modify", uuid] + mod, root)
            if r.returncode != 0:
                net_fail(r, "couldn't save the connection")
        net_apply(cur, root)
        print(f"net: saved {cur['name']}" + (" and applied it" if cur["active"] else ""))
        return 0
    if sub in ("delete", "up", "down"):
        r = nmcli(["connection", sub, uuid], root)
        if r.returncode != 0:
            net_fail(r, f"couldn't {'forget' if sub == 'delete' else 'connect' if sub == 'up' else 'disconnect'} the connection")
        return 0
    if sub == "add-ethernet":
        name = args[1] if len(args) > 1 else "Wired connection"
        iface = args[2] if len(args) > 2 else ""
        if iface and not re.fullmatch(r"[\w.-]{1,15}", iface):
            die("not a valid interface name")
        r = nmcli(["connection", "add", "type", "ethernet", "con-name", name, "ifname", iface or "*"], root)
        if r.returncode != 0:
            net_fail(r, "couldn't add the connection")
        m = re.search(r"\(([0-9a-fA-F-]{36})\)", r.stdout)
        print(m.group(1) if m else "")
        return 0
    if sub == "add-wifi":
        if "--json" not in args or args.index("--json") + 1 >= len(args):
            die("usage: flamenco net add-wifi --json {ssid, password, hidden}")
        spec = json.loads(args[args.index("--json") + 1])
        ssid, pw = str(spec.get("ssid", "")), str(spec.get("password") or "")
        if not 1 <= len(ssid.encode()) <= 32:
            die("a Wi-Fi name is 1–32 bytes")
        if pw and not 8 <= len(pw) <= 63:
            die("a WPA password is 8–63 characters")
        cmd = ["device", "wifi", "connect", ssid] + (["password", pw] if pw else []) + (["hidden", "yes"] if spec.get("hidden") else [])
        r = nmcli(cmd, root)
        if r.returncode != 0:
            net_fail(r, f"couldn't connect to {ssid}")
        return 0
    die("usage: flamenco net list | get UUID | set UUID --json SPEC | up|down|delete UUID | add-ethernet [NAME [IFACE]] | add-wifi --json SPEC  [--sudo]")


# ─────────────────────────────── AI assistant ────────────────────────────────
# Connections to language models for the Assistant panel (Settings → AI).
# Anthropic goes through the official `anthropic` SDK (optional dependency);
# every other provider speaks the OpenAI-compatible chat API, which needs no
# extra packages: OpenAI, Google Gemini, OpenRouter, LM Studio, Ollama, or any
# compatible server. API keys live in the keyring (secret-tool), or a 0600 file
# when there's no keyring, and are passed over stdin, never on a command line.

AI_PROVIDERS = {
    "anthropic": {"name": "Anthropic (Claude)", "kind": "anthropic", "base": "", "model": "claude-opus-5-5",
                  "env": "ANTHROPIC_API_KEY", "key": "optional"},
    "openai": {"name": "OpenAI", "kind": "openai", "base": "https://api.openai.com/v1", "model": "",
               "env": "OPENAI_API_KEY", "key": "required"},
    "gemini": {"name": "Google Gemini", "kind": "openai", "base": "https://generativelanguage.googleapis.com/v1beta/openai",
               "model": "", "env": "GEMINI_API_KEY", "key": "required"},
    "openrouter": {"name": "OpenRouter", "kind": "openai", "base": "https://openrouter.ai/api/v1", "model": "",
                   "env": "OPENROUTER_API_KEY", "key": "required"},
    "lmstudio": {"name": "LM Studio (local)", "kind": "openai", "base": "http://localhost:1234/v1", "model": "",
                 "env": "", "key": "none"},
    "ollama": {"name": "Ollama (local)", "kind": "openai", "base": "http://localhost:11434/v1", "model": "",
               "env": "", "key": "none"},
    "custom": {"name": "Other OpenAI-compatible server", "kind": "openai", "base": "", "model": "",
               "env": "", "key": "optional"},
}
AI_KEY_FILE = CONFIG_DIR / "ai-keys.json"
# Claude models that take an effort level, and those with server-side refusal fallback
AI_EFFORT_MODELS = ("claude-fable-5-1", "claude-fable-5", "claude-opus-5-5", "claude-opus-5", "claude-sonnet-5-5",
                    "claude-sonnet-5", "claude-haiku-5-5", "claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6")
AI_FALLBACK_MODELS = ("claude-fable-5-1", "claude-opus-5-5", "claude-opus-5", "claude-sonnet-5-5")


def ai_settings() -> dict:
    try:
        return json.loads((CONFIG_DIR / "settings.json").read_text()).get("ai", {}) or {}
    except (OSError, ValueError):
        return {}


def ai_provider(pid: str) -> dict:
    """A provider preset merged with what Settings → AI saved for it (base URL, model)."""
    if pid not in AI_PROVIDERS:
        die(f"unknown provider '{pid}' (one of: {', '.join(AI_PROVIDERS)})")
    saved = (ai_settings().get("providers") or {}).get(pid) or {}
    p = dict(AI_PROVIDERS[pid], id=pid)
    if saved.get("baseUrl"):
        p["base"] = str(saved["baseUrl"]).rstrip("/")
    if saved.get("model"):
        p["model"] = str(saved["model"])
    return p


def ai_keyring() -> bool:
    # FLAMENCO_AI_NO_KEYRING=1 keeps keys in the file (tests, or a keyring you don't want used)
    return shutil.which("secret-tool") is not None and not os.environ.get("FLAMENCO_AI_NO_KEYRING")


def ai_key_get(pid: str) -> tuple[str, str]:
    """(key, where it came from): keyring | file | env | ""."""
    if ai_keyring():
        r = subprocess.run(["secret-tool", "lookup", "service", "flamenco-ai", "provider", pid],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip(), "keyring"
    try:
        k = json.loads(AI_KEY_FILE.read_text()).get(pid, "")
        if k:
            return k, "file"
    except (OSError, ValueError):
        pass
    env = AI_PROVIDERS.get(pid, {}).get("env")
    if env and os.environ.get(env):
        return os.environ[env], "env"
    return "", ""


def ai_key_set(pid: str, key: str) -> str:
    if ai_keyring():
        r = subprocess.run(["secret-tool", "store", "--label", f"Flamenco AI: {AI_PROVIDERS[pid]['name']}",
                            "service", "flamenco-ai", "provider", pid], input=key, text=True,
                           capture_output=True, timeout=30)
        if r.returncode == 0:
            ai_key_file_drop(pid)
            return "keyring"
    # no keyring (or it's locked / missing): a file only you can read
    data = {}
    try:
        data = json.loads(AI_KEY_FILE.read_text())
    except (OSError, ValueError):
        pass
    data[pid] = key
    AI_KEY_FILE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(AI_KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(AI_KEY_FILE, 0o600)
    return "file"


def ai_key_file_drop(pid: str) -> None:
    try:
        data = json.loads(AI_KEY_FILE.read_text())
    except (OSError, ValueError):
        return
    if data.pop(pid, None) is not None:
        fd = os.open(AI_KEY_FILE, os.O_WRONLY | os.O_TRUNC)
        with os.fdopen(fd, "w") as f:
            json.dump(data, f)


def ai_key_delete(pid: str) -> None:
    if ai_keyring():
        subprocess.run(["secret-tool", "clear", "service", "flamenco-ai", "provider", pid], capture_output=True, timeout=10)
    ai_key_file_drop(pid)


def ai_http(url: str, key: str, body: dict | None = None, timeout: float = 30):
    import urllib.request
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    if key:
        headers["Authorization"] = f"Bearer {key}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if body is not None else "GET")
    return urllib.request.urlopen(req, timeout=timeout)


def ai_http_error(e) -> str:
    import urllib.error
    if isinstance(e, urllib.error.HTTPError):
        detail = ""
        try:
            j = json.loads(e.read().decode(errors="replace"))
            err = j.get("error", j)
            detail = err.get("message") if isinstance(err, dict) else str(err)
        except Exception:
            pass
        hint = {401: "the API key was refused", 403: "the API key isn't allowed to do this",
                404: "not found (check the server address and model)", 429: "rate limited or out of credit"}.get(e.code, "")
        return f"HTTP {e.code}" + (f": {hint}" if hint else "") + (f" ({detail})" if detail else "")
    if isinstance(e, urllib.error.URLError):
        return f"couldn't reach the server ({e.reason}). Is it running?"
    return str(e)


AI_NO_SDK = "the Anthropic provider needs the official SDK: install python-anthropic (AUR), or pick another provider"


def ai_anthropic_client(key: str):
    try:
        import anthropic
    except ImportError:
        raise RuntimeError(AI_NO_SDK)
    # no saved key: the SDK finds ANTHROPIC_API_KEY or an `ant auth login` profile itself
    return anthropic, (anthropic.Anthropic(api_key=key) if key else anthropic.Anthropic())


def ai_models(p: dict) -> list[str]:
    key, _ = ai_key_get(p["id"])
    if p["kind"] == "anthropic":
        _, client = ai_anthropic_client(key)
        return [m.id for m in client.models.list()]
    if not p["base"]:
        die("set the server address first")
    with ai_http(p["base"] + "/models", key, timeout=15) as r:
        data = json.loads(r.read().decode())
    items = data.get("data", data.get("models", [])) if isinstance(data, dict) else data
    out = []
    for m in items:
        mid = m.get("id") or m.get("name") if isinstance(m, dict) else str(m)
        if mid:
            out.append(str(mid).removeprefix("models/"))
    return sorted(set(out))


def ai_emit(kind: str, **kw) -> None:
    print(json.dumps(dict(t=kind, **kw)), flush=True)


def ai_chat(spec: dict) -> int:
    """Stream one reply. Prints JSON lines: {t: delta, text} … then {t: done} or {t: error, message}."""
    p = ai_provider(str(spec.get("provider") or ai_settings().get("provider") or "anthropic"))
    model = str(spec.get("model") or p["model"])
    if not model:
        ai_emit("error", message=f"choose a model for {p['name']} in Settings → AI")
        return 1
    system = str(spec.get("system") or "")
    msgs = [{"role": m["role"], "content": str(m["content"])} for m in spec.get("messages", [])
            if isinstance(m, dict) and m.get("role") in ("user", "assistant") and str(m.get("content", "")).strip()]
    if not msgs or msgs[-1]["role"] != "user":
        ai_emit("error", message="nothing to answer")
        return 1
    key, _ = ai_key_get(p["id"])
    if p["key"] == "required" and not key:
        ai_emit("error", message=f"add your {p['name']} API key in Settings → AI")
        return 1

    if p["kind"] == "anthropic":
        try:
            anthropic, client = ai_anthropic_client(key)
        except RuntimeError as e:
            ai_emit("error", message=str(e))
            return 1
        kwargs = dict(model=model, max_tokens=64000, messages=msgs)
        if system:
            kwargs["system"] = system
        effort = spec.get("effort") or ai_settings().get("effort") or "low"
        if model in AI_EFFORT_MODELS and effort in ("low", "medium", "high", "xhigh", "max"):
            kwargs["output_config"] = {"effort": effort}
        try:
            if model in AI_FALLBACK_MODELS:
                # a policy decline is re-run on another model inside the same call
                stream_cm = client.beta.messages.stream(betas=["server-side-fallback-2026-07-01"], fallbacks="default", **kwargs)
            else:
                stream_cm = client.messages.stream(**kwargs)
            with stream_cm as stream:
                for text in stream.text_stream:
                    ai_emit("delta", text=text)
                final = stream.get_final_message()
            if final.stop_reason == "refusal":
                ai_emit("error", message="Claude declined to answer this one.")
                return 1
            ai_emit("done", stop=final.stop_reason, model=final.model)
            return 0
        except anthropic.NotFoundError:
            ai_emit("error", message=f"model not found: {model}")
        except anthropic.RateLimitError:
            ai_emit("error", message="rate limited; try again in a moment")
        except anthropic.APIStatusError as e:
            ai_emit("error", message=f"Anthropic API error {e.status_code}: {getattr(e, 'message', '') or e}")
        except anthropic.APIConnectionError:
            ai_emit("error", message="couldn't reach the Anthropic API")
        except Exception as e:  # missing credentials and the like
            ai_emit("error", message=str(e))
        return 1

    if not p["base"]:
        ai_emit("error", message="set the server address in Settings → AI")
        return 1
    body = {"model": model, "stream": True,
            "messages": ([{"role": "system", "content": system}] if system else []) + msgs}
    try:
        with ai_http(p["base"] + "/chat/completions", key, body, timeout=300) as r:
            for raw in r:
                line = raw.decode(errors="replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    chunk = json.loads(data)
                except ValueError:
                    continue
                if chunk.get("error"):
                    err = chunk["error"]
                    ai_emit("error", message=err.get("message", str(err)) if isinstance(err, dict) else str(err))
                    return 1
                for ch in chunk.get("choices", []):
                    text = (ch.get("delta") or {}).get("content")
                    if text:
                        ai_emit("delta", text=text)
        ai_emit("done", stop="end", model=model)
        return 0
    except Exception as e:
        ai_emit("error", message=ai_http_error(e))
        return 1


def cmd_ai(args: list[str]) -> int:
    sub = args[0] if args else "providers"
    if sub == "providers":
        out = []
        for pid in AI_PROVIDERS:
            p = ai_provider(pid)
            _, where = ai_key_get(pid)
            out.append({"id": pid, "name": p["name"], "kind": p["kind"], "baseUrl": p["base"], "model": p["model"],
                        "defaultBase": AI_PROVIDERS[pid]["base"], "key": p["key"], "keyFrom": where, "env": p["env"]})
        sdk = True
        try:
            import importlib.util
            sdk = importlib.util.find_spec("anthropic") is not None
        except Exception:
            sdk = False
        print(json.dumps({"providers": out, "keyring": ai_keyring(), "anthropicSdk": sdk}))
        return 0
    if sub == "models" and len(args) > 1:
        try:
            print(json.dumps({"models": ai_models(ai_provider(args[1]))}))
        except SystemExit:
            raise
        except Exception as e:
            print(json.dumps({"models": [], "error": ai_http_error(e)}))
            return 1
        return 0
    if sub == "test" and len(args) > 1:
        p = ai_provider(args[1])
        spec = {"provider": p["id"], "model": args[2] if len(args) > 2 else p["model"], "effort": "low",
                "messages": [{"role": "user", "content": "Reply with just the word: ok"}]}
        return ai_chat(spec)
    if sub == "chat":
        # the conversation comes on stdin (one JSON line), so it never shows up in `ps`
        line = sys.stdin.readline()
        try:
            spec = json.loads(line)
        except ValueError as e:
            ai_emit("error", message=f"bad request: {e}")
            return 1
        return ai_chat(spec)
    if sub == "ask" and len(args) > 1:
        rc = 0
        spec = {"messages": [{"role": "user", "content": " ".join(args[1:])}], "system": ai_settings().get("systemPrompt", "")}
        import io, contextlib
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = ai_chat(spec)
        for line in buf.getvalue().splitlines():
            ev = json.loads(line)
            if ev["t"] == "delta":
                print(ev["text"], end="")
            elif ev["t"] == "error":
                print(f"\nflamenco: {ev['message']}", file=sys.stderr)
        print()
        return rc
    if sub == "key" and len(args) > 2 and args[2] in AI_PROVIDERS:
        pid = args[2]
        if args[1] == "set":
            key = sys.stdin.readline().strip()
            if not key:
                die("no key given (it's read from stdin)")
            where = ai_key_set(pid, key)
            print(f"ai: saved the {AI_PROVIDERS[pid]['name']} key " + ("in your keyring" if where == "keyring" else f"in {AI_KEY_FILE} (only you can read it)"))
            return 0
        if args[1] == "delete":
            ai_key_delete(pid)
            print(f"ai: removed the {AI_PROVIDERS[pid]['name']} key")
            return 0
    die("usage: flamenco ai providers | models PROVIDER | test PROVIDER [MODEL] | chat (JSON on stdin) | ask TEXT… | key set|delete PROVIDER (key on stdin)")


# ─────────────────────────────── settings search ─────────────────────────────
# The Settings app's search box: every page, section and setting with a fixed
# label, read from the page files themselves so the index can't drift.

def qml_mask(text: str) -> str:
    """Same-length copy with string contents and comments blanked (for brace matching)."""
    out, i, n = list(text), 0, len(text)
    while i < n:
        c = text[i]
        if c in "\"'":
            j = i + 1
            while j < n and text[j] != c:
                j += 2 if text[j] == "\\" else 1
            for k in range(i + 1, min(j, n)):
                out[k] = " "
            i = j + 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            for k in range(i, j):
                out[k] = " "
            i = j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            j = n if j < 0 else j + 2
            for k in range(i, j):
                if out[k] != "\n":
                    out[k] = " "
            i = j
        else:
            i += 1
    return "".join(out)


def qml_objects(masked: str, pos: int):
    """Enclosing objects of `pos`, innermost first: (type, open brace, close brace)."""
    found, depth, i = [], 0, pos
    while i > 0:
        i -= 1
        ch = masked[i]
        if ch == "}":
            depth += 1
        elif ch == "{":
            if depth:
                depth -= 1
                continue
            m = re.search(r"(\w+)\s*(?:on\s+[\w.]+\s*)?$", masked[max(0, i - 80):i])
            d, j = 1, i + 1
            while j < len(masked) and d:
                d += {"{": 1, "}": -1}.get(masked[j], 0)
                j += 1
            found.append((m.group(1) if m else "", i, j))
    return found


def qml_literal(text: str, obj: tuple, prop: str) -> str:
    """A property's plain string value, directly in this object; "" when it's computed."""
    _, a, b = obj
    body, masked = text[a + 1:b - 1], qml_mask(text[a + 1:b - 1])
    for m in re.finditer(r"(?<![\w.])" + prop + r"\s*:\s*\"", masked):
        # only at this object's own level
        if masked[:m.start()].count("{") != masked[:m.start()].count("}"):
            continue
        sm = re.match(r'"((?:[^"\\]|\\.)*)"\s*(?=[;\n}]|$)', body[m.end() - 1:])
        if sm:
            return json.loads('"' + sm.group(1) + '"')
    return ""


def settings_index() -> list[dict]:
    pages_dir = shell_dir() / "Modules/Settings/Pages"
    win = (shell_dir() / "Modules/Settings/SettingsWindow.qml").read_text()
    comps = dict(re.findall(r"Component\s*\{\s*id:\s*(\w+);\s*(\w+)\s*\{", win))
    out = []
    for pid, icon, label, comp in re.findall(r'\{\s*id:\s*"([\w-]+)",\s*icon:\s*"([^"]+)",\s*label:\s*"([^"]+)",\s*comp:\s*(\w+)\s*\}', win):
        out.append({"page": pid, "icon": icon, "label": label, "kind": "page", "title": label, "subtitle": "", "group": ""})
        files, seen = [comps.get(comp, "")], set()
        while files:
            name = files.pop(0)
            f = pages_dir / f"{name}.qml"
            if not name or name in seen or not f.is_file():
                continue
            seen.add(name)
            text = f.read_text()
            masked = qml_mask(text)
            # sections defined in their own file (LoginSection, FingerprintSection…)
            files += [m for m in re.findall(r"(?<![\w.])(\w+Section)\s*\{", masked) if m != name]
            for m in re.finditer(r"(?<![\w.])title\s*:", masked):
                objs = qml_objects(masked, m.start())
                if not objs:
                    continue
                kind = objs[0][0]
                if not (kind.endswith("Row") or kind == "Group"):
                    continue
                title = qml_literal(text, objs[0], "title")
                if not title:
                    continue
                grp = next((o for o in objs[1:] if o[0] == "Group"), None)
                out.append({"page": pid, "icon": icon, "label": label, "kind": "group" if kind == "Group" else "row",
                            "title": title, "subtitle": qml_literal(text, objs[0], "subtitle"),
                            "group": qml_literal(text, grp, "title") if grp else ""})
    seen, uniq = set(), []
    for e in out:
        k = (e["page"], e["kind"], e["title"])
        if k not in seen:
            seen.add(k)
            uniq.append(e)
    return uniq


def cmd_settings_index(args: list[str]) -> int:
    idx = settings_index()
    if "--json" in args:
        print(json.dumps(idx))
    else:
        for e in idx:
            print(f"{e['label']:<24} {e['kind']:<5} {e['group'] + ' › ' if e['group'] else ''}{e['title']}")
    return 0


# ─────────────────────────────── privacy (camera) ────────────────────────────
# Which of your programs have a camera open. Most apps open /dev/video* directly
# instead of going through PipeWire, so this looks at open files; the bar's
# privacy indicator runs `flamenco privacy watch`, which prints only on change.

def camera_users() -> list[str]:
    names = set()
    me = os.getpid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            for fd in os.scandir(f"/proc/{pid}/fd"):
                try:
                    if os.readlink(fd.path).startswith("/dev/video"):
                        names.add(Path(f"/proc/{pid}/comm").read_text().strip() or pid)
                        break
                except OSError:
                    continue
        except OSError:
            continue        # gone, or not yours
    return sorted(names)


def privacy_watch():
    """Print {"camera": [...]} whenever the apps using a camera change. Scanning
    every process's open files is costly with browsers open, so this waits for
    the kernel (inotify) to say a /dev/video* device was opened or closed, or a
    camera was plugged in, and scans only then; with no camera, never."""
    import ctypes
    import select
    import struct
    import time
    IN_OPEN, IN_CLOSE_WRITE, IN_CLOSE_NOWRITE, IN_CREATE, IN_DELETE = 0x20, 0x08, 0x10, 0x100, 0x200
    last = None

    def emit():
        nonlocal last
        now = camera_users() if any(Path("/dev").glob("video*")) else []
        if now != last:
            print(json.dumps({"camera": now}), flush=True)
            last = now

    try:
        libc = ctypes.CDLL(None, use_errno=True)
        fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        if fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1")
    except (OSError, AttributeError):
        while True:                           # no inotify: look now and then
            emit()
            time.sleep(5)

    def add(path: str, mask: int):
        libc.inotify_add_watch(fd, path.encode(), mask)

    def watch_devices():
        for dev in Path("/dev").glob("video*"):
            add(str(dev), IN_OPEN | IN_CLOSE_WRITE | IN_CLOSE_NOWRITE)

    add("/dev", IN_CREATE | IN_DELETE)        # cameras plugged in or out
    watch_devices()
    emit()
    while True:
        ready, _, _ = select.select([fd], [], [], 60)
        if not ready:
            emit()                            # now and then anyway, in case one was missed
            continue
        replug = False
        while True:                           # take everything waiting
            try:
                data = os.read(fd, 65536)
            except BlockingIOError:
                break
            off = 0
            while off + 16 <= len(data):
                _wd, mask, _cookie, length = struct.unpack_from("iIII", data, off)
                name = data[off + 16:off + 16 + length].split(b"\0", 1)[0].decode(errors="replace")
                if mask & (IN_CREATE | IN_DELETE) and name.startswith("video"):
                    replug = True
                off += 16 + length
        if replug:
            time.sleep(0.5)                   # let udev set the new node's permissions
            watch_devices()
        time.sleep(0.25)                      # opens come in bursts: one scan for them all
        try:
            while os.read(fd, 65536):
                pass
        except BlockingIOError:
            pass
        emit()


def cmd_privacy(args: list[str]) -> int:
    if args[:1] == ["watch"]:
        privacy_watch()
        return 0
    print(json.dumps({"camera": camera_users()}))
    return 0


# ─────────────────────────────── screen recording ────────────────────────────
# wf-recorder (wlr-screencopy: niri and Hyprland, no prompts) or gpu-screen-recorder.
# The recorder runs on its own; RECORD_STATE says what's recording, so the bar
# finds it again after a shell restart, and `stop` sends it SIGINT so the file
# is finished properly.

RECORD_STATE = RUN_DIR / "flamenco-record.json"
RECORD_LOG = RUN_DIR / "flamenco-record.log"


def record_settings() -> dict:
    try:
        r = json.loads((CONFIG_DIR / "settings.json").read_text()).get("record", {}) or {}
    except (OSError, ValueError):
        r = {}
    return {"backend": r.get("backend", "auto"), "audio": r.get("audio", "none"),
            "fps": max(10, min(240, int(r.get("fps", 60) or 60))),
            "dir": str(r.get("dir") or "~/Videos/Recordings")}


def record_backend(pref: str) -> str:
    order = [pref] if pref in ("wf-recorder", "gpu-screen-recorder") else ["wf-recorder", "gpu-screen-recorder"]
    for b in order:
        if shutil.which(b):
            return b
    die("no screen recorder installed: install wf-recorder or gpu-screen-recorder")


def record_state() -> dict | None:
    try:
        st = json.loads(RECORD_STATE.read_text())
        os.kill(int(st["pid"]), 0)
        return st
    except (OSError, ValueError, KeyError, ProcessLookupError):
        RECORD_STATE.unlink(missing_ok=True)
        return None


def focused_output() -> str:
    if compositor() == "hyprland":
        try:
            mons = json.loads(run_out(["hyprctl", "monitors", "-j"]) or "[]")
            return next((m["name"] for m in mons if m.get("focused")), mons[0]["name"] if mons else "")
        except (ValueError, KeyError, IndexError):
            return ""
    try:
        return json.loads(run_out(["niri", "msg", "--json", "focused-output"]) or "{}").get("name", "")
    except ValueError:
        return ""


def record_start(mode: str, output: str = "") -> int:
    import time
    if record_state():
        die("already recording (flamenco record stop)")
    cfg = record_settings()
    backend = record_backend(cfg["backend"])
    geom = ""
    if mode == "region":
        if not shutil.which("slurp"):
            die("recording an area needs slurp")
        r = subprocess.run(["slurp", "-d"], capture_output=True, text=True)
        geom = r.stdout.strip()
        if r.returncode != 0 or not geom:
            return 0                    # cancelled
    else:
        output = output or focused_output()
    folder = Path(os.path.expanduser(cfg["dir"]))
    folder.mkdir(parents=True, exist_ok=True)
    out = folder / time.strftime("Recording %Y-%m-%d %H-%M-%S.mp4")
    audio = cfg["audio"]
    if backend == "wf-recorder":
        cmd = ["wf-recorder", "-y", "-f", str(out), "-r", str(cfg["fps"])]
        if geom:
            cmd += ["-g", geom]
        elif output:
            cmd += ["-o", output]
        if audio == "desktop":
            sink = run_out(["pactl", "get-default-sink"]).strip()
            cmd.append(f"--audio={sink}.monitor" if sink else "--audio")
        elif audio in ("mic", "both"):
            cmd.append("--audio")       # wf-recorder records one source: the default input
    else:
        if geom:
            m = re.match(r"(-?\d+),(-?\d+) (\d+)x(\d+)", geom)
            target = ["-w", "region", "-region", f"{m.group(3)}x{m.group(4)}+{m.group(1)}+{m.group(2)}"] if m else ["-w", "portal"]
        else:
            target = ["-w", output or "portal"]
        cmd = ["gpu-screen-recorder"] + target + ["-f", str(cfg["fps"]), "-o", str(out)]
        a = {"desktop": "default_output", "mic": "default_input", "both": "default_output|default_input"}.get(audio)
        if a:
            cmd += ["-a", a]
    log = open(RECORD_LOG, "w")
    proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    time.sleep(0.8)
    if proc.poll() is not None:
        lines = RECORD_LOG.read_text(errors="replace").strip().splitlines()
        die(f"{backend} stopped right away: " + (lines[-1] if lines else f"exit {proc.returncode}"))
    RECORD_STATE.write_text(json.dumps({"pid": proc.pid, "file": str(out), "started": time.time(),
                                        "backend": backend, "mode": "region" if geom else "screen", "output": output}))
    print(f"record: recording to {out}")
    return 0


def record_stop() -> int:
    import signal, time
    st = record_state()
    if not st:
        print("record: nothing is recording")
        return 0
    pid = int(st["pid"])
    try:
        os.kill(pid, signal.SIGINT)
    except ProcessLookupError:
        pass
    for _ in range(100):            # up to 10 s to finish writing
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            break
        time.sleep(0.1)
    RECORD_STATE.unlink(missing_ok=True)
    f = Path(st["file"])
    if f.exists() and f.stat().st_size > 0:
        print(f"record: saved {f}")
        if shutil.which("notify-send"):
            subprocess.Popen(["notify-send", "-a", "Screen recording", "-i", "video-x-generic",
                              "Recording saved", str(f)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print("record: stopped (no file was written)")
    return 0


def cmd_record(args: list[str]) -> int:
    sub = args[0] if args else "status"
    if sub == "status":
        st = record_state()
        print(json.dumps({"recording": bool(st), **(st or {})}))
        return 0
    if sub == "stop":
        return record_stop()
    if sub in ("start", "toggle"):
        if sub == "toggle" and record_state():
            return record_stop()
        mode = args[1] if len(args) > 1 else "screen"
        if mode not in ("screen", "region"):
            die("usage: flamenco record start|toggle [screen|region] [OUTPUT]")
        return record_start(mode, args[2] if len(args) > 2 else "")
    die("usage: flamenco record start|toggle [screen|region] [OUTPUT] | stop | status")


# ─────────────────────────────── external monitor brightness (DDC/CI) ───────
# ddcutil talks to monitors over the video cable (VCP feature 0x10 = brightness).
# It needs the i2c-dev module and access to /dev/i2c-* (the i2c group).

def ddc_list() -> dict:
    if not shutil.which("ddcutil"):
        return {"installed": False, "displays": [], "error": ""}
    r = subprocess.run(["ddcutil", "detect", "--brief"], capture_output=True, text=True, timeout=30)
    displays, cur = [], None
    for line in r.stdout.splitlines():
        if re.match(r"^Display \d+", line):
            cur = {"bus": "", "connector": "", "name": ""}
            displays.append(cur)
        elif line.startswith("Invalid display"):
            cur = None
        elif cur is not None:
            m = re.match(r"\s*I2C bus:\s*/dev/i2c-(\d+)", line)
            if m:
                cur["bus"] = m.group(1)
            m = re.match(r"\s*DRM connector:\s*card\d+-(.+)", line)
            if m:
                cur["connector"] = m.group(1).strip()
            m = re.match(r"\s*Monitor:\s*(.+)", line)
            if m:
                parts = m.group(1).split(":")
                cur["name"] = (parts[1] if len(parts) > 1 else parts[0]).strip()
    out = []
    for d in displays:
        if not d["bus"]:
            continue
        g = subprocess.run(["ddcutil", "--bus", d["bus"], "getvcp", "10", "--brief"], capture_output=True, text=True, timeout=15)
        m = re.search(r"VCP 10 \w+ (\d+) (\d+)", g.stdout)
        if m:
            out.append(dict(d, value=int(m.group(1)), max=int(m.group(2)) or 100))
    err = ""
    if not out and r.returncode != 0:
        msg = (r.stderr or r.stdout).strip().splitlines()
        err = msg[-1] if msg else "ddcutil failed"
        if re.search(r"(?i)permission|i2c", err):
            err = "no access to /dev/i2c-*: add yourself to the i2c group and load i2c-dev"
    return {"installed": True, "displays": out, "error": err}


def cmd_ddc(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "list":
        print(json.dumps(ddc_list()))
        return 0
    if sub == "set" and len(args) > 2 and args[1].isdigit():
        try:
            pct = max(0, min(100, int(float(args[2]))))
        except ValueError:
            die("usage: flamenco ddc set BUS PERCENT")
        mx = int(args[3]) if len(args) > 3 and args[3].isdigit() else 100
        r = subprocess.run(["ddcutil", "--bus", args[1], "--noverify", "setvcp", "10", str(round(pct * mx / 100))],
                           capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            die((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else "ddcutil failed")
        return 0
    die("usage: flamenco ddc list | set BUS PERCENT [MAX]")


# ─────────────────────────────── keyboard cheat sheet ────────────────────────
# Every key binding, named and grouped, for the cheat sheet (`flamenco keys`):
# niri's binds block (hotkey-overlay-title, else the action), or `hyprctl binds`.

KEY_GROUPS = (("Flamenco", ("flamenco",)), ("Screenshots", ("screenshot",)),
              ("Workspaces", ("workspace",)), ("Monitors", ("monitor",)),
              ("Windows & columns", ("window", "column", "focus", "move", "consume", "expel", "fullscreen", "maximize",
                                     "center", "width", "height", "float", "tab", "close", "resize", "swap", "pin", "group")),
              ("Media & hardware", ("xf86", "volume", "brightness", "media", "play")),
              ("Apps", ("spawn", "exec", "run")),
              ("Session", ("quit", "lock", "power", "overview", "hotkey", "exit", "dpms", "suspend")))


def key_group(key: str, action: str) -> str:
    hay = (key + " " + action).lower()
    if key.lower().startswith("xf86"):
        return "Media & hardware"
    if "flamenco" in hay:
        return "Flamenco"
    for name, words in KEY_GROUPS[1:]:
        if any(w in hay for w in words):
            return name
    return "Other"


def key_title(action: str, args: list[str]) -> str:
    if action == "spawn-sh" and args:
        # "flamenco volume up || wpctl …": named by the Flamenco part
        args = args[0].split("||")[0].split()
        action = "spawn"
    if action in ("spawn", "spawn-sh"):
        if args[:1] == ["flamenco"]:
            fn = next((v[0] for v in SHELL_FUNCTIONS.values() if v[1] == args[1:]), "")
            return fn or "Flamenco: " + " ".join(args[1:])
        prog = (args[0] if args else "").split("/")[-1]
        return "Run " + (" ".join(args) if action == "spawn-sh" else prog)
    words = action.replace("-", " ").strip()
    return (words[:1].upper() + words[1:] + (" " + " ".join(args) if args else "")).strip()


def niri_keys(text: str) -> list[dict]:
    block = kdl_block(text, "binds")
    if not block:
        return []
    _, o, c = block
    masked = kdl_mask(text)
    out = []
    for m in re.finditer(r"(?m)^[ \t]*([A-Za-z0-9_+]+)(?=[\s{])", masked[o + 1:c]):
        start = o + 1 + m.start()
        brace = masked.find("{", start, c)
        close = masked.find("}", brace, c) if brace >= 0 else -1
        if brace < 0 or close < 0 or "\n" in masked[start:brace].strip("\n"):
            continue
        head, body = text[start:brace], text[brace + 1:close]
        key = m.group(1)
        t = re.search(r'hotkey-overlay-title=(null|"((?:[^"\\]|\\.)*)")', head)
        if t and t.group(1) == "null":
            continue            # hidden from niri's overlay on purpose
        first = body.strip().split(";")[0].strip()
        if not first:
            continue
        parts = re.findall(r'"((?:[^"\\]|\\.)*)"|(\S+)', first)
        action = parts[0][0] or parts[0][1]
        # quoted arguments, and bare ones that aren't name=value properties
        args = [kdl_unquote(q) if q else b for q, b in parts[1:] if q or "=" not in b]
        title = kdl_unquote(t.group(2)) if t and t.group(2) else key_title(action, args)
        out.append({"key": key, "title": title, "group": key_group(key, action + " " + " ".join(args))})
    return out


def hypr_keys() -> list[dict]:
    try:
        binds = json.loads(run_out(["hyprctl", "binds", "-j"]) or "[]")
    except ValueError:
        return []
    bits = ((64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift"))
    out = []
    for b in binds:
        mods = [n for bit, n in bits if b.get("modmask", 0) & bit]
        key = "+".join(mods + [str(b.get("key", "")).capitalize() if len(str(b.get("key", ""))) == 1 else str(b.get("key", ""))])
        action = f"{b.get('dispatcher', '')} {b.get('arg', '')}".strip()
        args = b.get("arg", "").split()
        title = b.get("description") or (key_title("spawn", args) if b.get("dispatcher") == "exec" else action)
        out.append({"key": key, "title": title, "group": key_group(key, action)})
    return out


def cmd_keys(args: list[str]) -> int:
    if compositor() == "hyprland":
        keys = hypr_keys()
    else:
        keys = niri_keys(NIRI_CONFIG.read_text() if NIRI_CONFIG.is_file() else "")
    if "--json" in args:
        print(json.dumps(keys))
        return 0
    if args[:1] == ["show"]:
        return ipc("keys", "toggle")
    for k in keys:
        print(f"{k['group']:<20} {k['key']:<24} {k['title']}")
    return 0


# ─────────────────────────────── emoji & color picker ────────────────────────

EMOJI_RANGES = ((0x1F300, 0x1F5FF), (0x1F600, 0x1F64F), (0x1F680, 0x1F6FF), (0x1F900, 0x1F9FF),
                (0x1FA70, 0x1FAFF), (0x2600, 0x26FF), (0x2700, 0x27BF), (0x1F170, 0x1F1FF), (0x2B00, 0x2BFF))


def emoji_list() -> list[list[str]]:
    """[emoji, name] for every emoji in Python's Unicode database (no data file needed)."""
    import unicodedata
    out = []
    for a, b in EMOJI_RANGES:
        for cp in range(a, b + 1):
            ch = chr(cp)
            if unicodedata.category(ch) != "So":
                continue
            name = unicodedata.name(ch, "")
            if not name or name.startswith("REGIONAL INDICATOR"):
                continue
            # text-style symbols get the emoji presentation selector
            glyph = ch + ("️" if cp < 0x1F000 else "")
            out.append([glyph, name.lower()])
    return out


def cmd_emoji(args: list[str]) -> int:
    print(json.dumps(emoji_list(), ensure_ascii=False))
    return 0


def cmd_pick_color(args: list[str]) -> int:
    """Pick a color on screen: copied to the clipboard as #rrggbb (and printed)."""
    hexv = ""
    if compositor() == "hyprland":
        if not shutil.which("hyprpicker"):
            die("picking a color on Hyprland needs hyprpicker")
        hexv = run_out(["hyprpicker", "-f", "hex"]).strip()
    else:
        out = run_out(["niri", "msg", "--json", "pick-color"]).strip()
        try:
            rgb = json.loads(out).get("rgb") if out else None
        except ValueError:
            rgb = None
        if rgb:
            hexv = "#" + "".join(f"{max(0, min(255, round(c * 255))):02x}" for c in rgb[:3])
    if not hexv:
        return 1                    # cancelled
    print(hexv)
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", hexv])
    if "--quiet" not in args and shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Color picker", "-i", "color-select", f"Copied {hexv}", "Paste it anywhere"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


# ─────────────────────────────── calendar events ─────────────────────────────
# Events for the calendar panel from ICS links (Google / Outlook "secret iCal
# address", any webcal:// feed), .ics files, or vdir folders (what vdirsyncer
# keeps CalDAV calendars in, and khal reads). A small ICS reader, stdlib only:
# time zones, all-day events, and the usual repeat rules.

CAL_CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "flamenco/calendars"
WEEKDAYS = ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]


def ics_lines(text: str) -> list[str]:
    out = []
    for raw in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if raw[:1] in (" ", "\t") and out:
            out[-1] += raw[1:]
        elif raw:
            out.append(raw)
    return out


def ics_unescape(v: str) -> str:
    return re.sub(r"\\([\;,nN])", lambda m: "\n" if m.group(1) in "nN" else m.group(1), v)


def ics_time(value: str, params: dict):
    """(local datetime, all-day?) from a DTSTART/DTEND-style value."""
    from datetime import datetime, date
    from zoneinfo import ZoneInfo
    value = value.strip()
    if params.get("VALUE") == "DATE" or re.fullmatch(r"\d{8}", value):
        d = datetime.strptime(value[:8], "%Y%m%d")
        return d, True
    utc = value.endswith("Z")
    dt = datetime.strptime(value.rstrip("Z")[:15], "%Y%m%dT%H%M%S")
    if utc:
        from datetime import timezone
        return dt.replace(tzinfo=timezone.utc).astimezone().replace(tzinfo=None), False
    tz = params.get("TZID")
    if tz:
        try:
            return dt.replace(tzinfo=ZoneInfo(tz.strip('"'))).astimezone().replace(tzinfo=None), False
        except Exception:
            pass                    # Windows zone names and the like: take it as local time
    return dt, False


def ics_duration(v: str):
    from datetime import timedelta
    m = re.fullmatch(r"([+-])?P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?", v.strip())
    if not m:
        return None
    sign = -1 if m.group(1) == "-" else 1
    w, d, h, mi, sec = (int(x or 0) for x in m.groups()[1:])
    return sign * timedelta(weeks=w, days=d, hours=h, minutes=mi, seconds=sec)


def ics_events(text: str, lo, hi, cal: str, color: str) -> list[dict]:
    from datetime import timedelta
    events, cur, cancelled, overrides = [], None, set(), set()
    raw_events = []
    for line in ics_lines(text):
        if line == "BEGIN:VEVENT":
            cur = {}
        elif line == "END:VEVENT" and cur is not None:
            raw_events.append(cur)
            cur = None
        elif cur is not None and ":" in line:
            head, val = line.split(":", 1)
            name, *ps = head.split(";")
            params = dict(p.split("=", 1) for p in ps if "=" in p)
            cur.setdefault(name.upper(), []).append((val, params))
    # single occurrences edited on their own replace that occurrence of the series
    for ev in raw_events:
        if "RECURRENCE-ID" in ev and "UID" in ev:
            v, p = ev["RECURRENCE-ID"][0]
            overrides.add((ev["UID"][0][0], ics_time(v, p)[0]))
    for ev in raw_events:
        if ev.get("STATUS", [("", {})])[0][0].upper() == "CANCELLED" or "DTSTART" not in ev:
            continue
        start, allday = ics_time(*ev["DTSTART"][0])
        if "DTEND" in ev:
            end = ics_time(*ev["DTEND"][0])[0]
        elif "DURATION" in ev and ics_duration(ev["DURATION"][0][0]) is not None:
            end = start + ics_duration(ev["DURATION"][0][0])
        else:
            end = start + (timedelta(days=1) if allday else timedelta(0))
        length = end - start
        uid = ev.get("UID", [("", {})])[0][0]
        exdates = set()
        for v, p in ev.get("EXDATE", []):
            for part in v.split(","):
                try:
                    exdates.add(ics_time(part, p)[0])
                except ValueError:
                    pass
        starts = [start]
        if "RRULE" in ev and "RECURRENCE-ID" not in ev:
            starts = ics_expand(start, dict(kv.split("=", 1) for kv in ev["RRULE"][0][0].split(";") if "=" in kv), hi)
        base = {"title": ics_unescape(ev.get("SUMMARY", [("(no title)", {})])[0][0]),
                "location": ics_unescape(ev.get("LOCATION", [("", {})])[0][0]),
                "allDay": allday, "calendar": cal, "color": color}
        for st in starts:
            if st in exdates or ("RECURRENCE-ID" not in ev and (uid, st) in overrides):
                continue
            en = st + length
            if en < lo or st > hi:
                continue
            events.append(dict(base, start=st.isoformat(timespec="minutes"), end=en.isoformat(timespec="minutes")))
    return events


def ics_expand(start, rule: dict, hi) -> list:
    """Occurrences of a repeat rule (FREQ DAILY/WEEKLY/MONTHLY/YEARLY, INTERVAL, COUNT, UNTIL, BYDAY for weekly)."""
    from datetime import timedelta
    freq = rule.get("FREQ", "").upper()
    step = max(1, int(rule.get("INTERVAL", "1") or 1))
    count = int(rule["COUNT"]) if rule.get("COUNT", "").isdigit() else None
    until = None
    if rule.get("UNTIL"):
        try:
            until = ics_time(rule["UNTIL"], {})[0]
        except ValueError:
            until = None
    end = min(hi, until) if until else hi
    days = [WEEKDAYS.index(d[-2:]) for d in rule.get("BYDAY", "").split(",") if d[-2:] in WEEKDAYS]
    out, n, i = [], 0, 0
    while i < 3000:
        if freq == "DAILY":
            cands = [start + timedelta(days=i * step)]
        elif freq == "WEEKLY":
            week = start + timedelta(weeks=i * step)
            monday = week - timedelta(days=week.weekday())
            cands = sorted(monday + timedelta(days=d) for d in (days or [start.weekday()]))
            cands = [c.replace(hour=start.hour, minute=start.minute, second=start.second) for c in cands if c >= start]
        elif freq == "MONTHLY":
            m = start.month - 1 + i * step
            y, mo = start.year + m // 12, m % 12 + 1
            try:
                cands = [start.replace(year=y, month=mo)]
            except ValueError:
                cands = []          # e.g. the 31st in a short month
        elif freq == "YEARLY":
            try:
                cands = [start.replace(year=start.year + i * step)]
            except ValueError:
                cands = []          # 29 February
        else:
            return [start]
        for c in cands:
            if c > end or (count is not None and n >= count):
                return out
            out.append(c)
            n += 1
        i += 1
    return out


def cal_fetch(src: dict, refresh: bool) -> tuple[list[str], str]:
    """(ICS texts, error) for one source: a URL (cached), a file, or a vdir folder."""
    import hashlib, time, urllib.request
    url = str(src.get("url", "")).strip()
    if not url:
        return [], "no address"
    if re.match(r"(?i)^(https?|webcal)://", url):
        url = re.sub(r"(?i)^webcal://", "https://", url)
        CAL_CACHE.mkdir(parents=True, exist_ok=True)
        f = CAL_CACHE / (hashlib.sha1(url.encode()).hexdigest() + ".ics")
        if refresh or not f.exists() or time.time() - f.stat().st_mtime > 900:
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "flamenco-shell"})
                with urllib.request.urlopen(req, timeout=20) as r:
                    f.write_bytes(r.read())
            except Exception as e:
                if not f.exists():
                    return [], ai_http_error(e)
        return [f.read_text(errors="replace")], ""
    path = Path(os.path.expanduser(url))
    if path.is_dir():
        return [p.read_text(errors="replace") for p in sorted(path.rglob("*.ics"))], ""
    if path.is_file():
        return [path.read_text(errors="replace")], ""
    return [], f"not found: {path}"


# ─────────────────────────────── online accounts (CalDAV) ────────────────────
# Settings → Online Accounts: sign in to a CalDAV server (iCloud, Nextcloud,
# Fastmail, Radicale, Baïkal… any with a user name and an app password), pick
# calendars, and their events show in the calendar like any other. Passwords
# stay in the keyring (or a 0600 file); settings.json only names the account.
#   flamenco accounts discover SERVER USER      password on stdin → JSON calendars
#   flamenco accounts secret ID [--clear]       store (stdin) / forget an account's password

ACCOUNT_KEYS = CONFIG_DIR / "account-keys.json"
CALDAV_PRESETS = {"icloud": "https://caldav.icloud.com/", "fastmail": "https://caldav.fastmail.com/dav/",
                  "nextcloud": "{host}/remote.php/dav/", "yahoo": "https://caldav.calendar.yahoo.com/",
                  "zoho": "https://calendar.zoho.com/caldav/", "mailbox": "https://dav.mailbox.org/caldav/"}


def acct_secret_get(aid: str) -> str:
    if ai_keyring():
        r = subprocess.run(["secret-tool", "lookup", "service", "flamenco-calendar", "account", aid],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.rstrip("\n")
    try:
        return str(json.loads(ACCOUNT_KEYS.read_text()).get(aid, ""))
    except (OSError, ValueError):
        return ""


def acct_secret_file(aid: str, value: str | None) -> None:
    try:
        data = json.loads(ACCOUNT_KEYS.read_text())
    except (OSError, ValueError):
        data = {}
    if value is None:
        if data.pop(aid, None) is None:
            return
    else:
        data[aid] = value
    ACCOUNT_KEYS.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(ACCOUNT_KEYS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(ACCOUNT_KEYS, 0o600)


def acct_secret_set(aid: str, value: str) -> str:
    if ai_keyring():
        r = subprocess.run(["secret-tool", "store", "--label", f"Flamenco calendar account {aid}",
                            "service", "flamenco-calendar", "account", aid], input=value, text=True, capture_output=True, timeout=30)
        if r.returncode == 0:
            acct_secret_file(aid, None)
            return "keyring"
    acct_secret_file(aid, value)
    return "file"


def dav_local(host: str) -> bool:
    """A server on this computer or the home network (where http:// can be all there is)."""
    import ipaddress
    h = (host or "").strip("[]").lower()
    if h in ("localhost",) or h.endswith((".local", ".lan", ".home.arpa", ".internal")):
        return True
    try:
        ip = ipaddress.ip_address(h)
        return ip.is_private or ip.is_loopback or ip.is_link_local
    except ValueError:
        return False


def dav_same_site(a: str, b: str) -> bool:
    """Whether a redirect stays with the same service (caldav.icloud.com → p12-caldav.icloud.com)."""
    a, b = a.lower(), b.lower()
    base = ".".join(a.split(".")[-2:])
    return a == b or b == base or b.endswith("." + base)


def dav_request(method: str, url: str, user: str, password: str, body: str = "", depth: str = "0"):
    """(status, final url, text) of a WebDAV request, following redirects (urllib won't for PROPFIND).
    The password (Basic auth) never goes unencrypted to a server outside your network, never
    down from https to http, and never along a redirect to another site."""
    import base64
    import urllib.error
    import urllib.parse
    import urllib.request
    auth = "Basic " + base64.b64encode(f"{user}:{password}".encode()).decode()
    first = urllib.parse.urlparse(url)
    for _ in range(6):
        u = urllib.parse.urlparse(url)
        if u.scheme not in ("https", "http"):
            raise ValueError(f"not a web address: {url}")
        if u.scheme == "http" and not dav_local(u.hostname or ""):
            raise ValueError("refusing to send your password unencrypted (http://) to a server outside your network: use https://")
        if first.scheme == "https" and u.scheme == "http":
            raise ValueError("the server redirected from https to http; not sending your password that way")
        if not dav_same_site(first.hostname or "", u.hostname or ""):
            raise ValueError(f"the server redirected to another site ({u.hostname}); not sending your password there")
        req = urllib.request.Request(url, data=body.encode() if body else None, method=method,
                                     headers={"Authorization": auth, "Depth": depth, "User-Agent": UA,
                                              "Content-Type": "application/xml; charset=utf-8"})
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, r.geturl(), r.read().decode("utf-8", errors="replace")
        except urllib.error.HTTPError as e:
            if e.code in (301, 302, 303, 307, 308) and e.headers.get("Location"):
                import urllib.parse
                url = urllib.parse.urljoin(url, e.headers["Location"])
                continue
            if e.code == 401:
                raise ValueError("the user name or password was refused (many services need an app password)")
            raise
    raise ValueError("too many redirects")


DAV_NS = {"d": "DAV:", "c": "urn:ietf:params:xml:ns:caldav", "a": "http://apple.com/ns/ical/", "cs": "http://calendarserver.org/ns/"}


def dav_props(xml: str) -> list[tuple[str, object]]:
    import xml.etree.ElementTree as ET
    root = ET.fromstring(xml)
    return [(r.findtext("d:href", "", DAV_NS), r) for r in root.findall("d:response", DAV_NS)]


def caldav_discover(server: str, user: str, password: str) -> list[dict]:
    import urllib.parse
    server = server.strip()
    if not re.match(r"(?i)^https?://", server):
        server = "https://" + server
    # a bare host: its well-known address leads to the CalDAV root
    start = server if urllib.parse.urlparse(server).path not in ("", "/") else server.rstrip("/") + "/.well-known/caldav"
    q = lambda inner: f'<?xml version="1.0"?><d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav" xmlns:a="http://apple.com/ns/ical/"><d:prop>{inner}</d:prop></d:propfind>'
    _, base, xml = dav_request("PROPFIND", start, user, password, q("<d:current-user-principal/>"))
    href = next((r.findtext(".//d:current-user-principal/d:href", "", DAV_NS) for _, r in dav_props(xml)), "")
    principal = urllib.parse.urljoin(base, href) if href else base
    _, base, xml = dav_request("PROPFIND", principal, user, password, q("<c:calendar-home-set/>"))
    href = next((r.findtext(".//c:calendar-home-set/d:href", "", DAV_NS) for _, r in dav_props(xml)), "")
    home = urllib.parse.urljoin(base, href) if href else principal
    _, base, xml = dav_request("PROPFIND", home, user, password,
                               q("<d:displayname/><d:resourcetype/><a:calendar-color/><c:supported-calendar-component-set/>"), depth="1")
    cals = []
    for href, r in dav_props(xml):
        if r.find(".//d:resourcetype/c:calendar", DAV_NS) is None:
            continue
        comps = [c.get("name") for c in r.findall(".//c:supported-calendar-component-set/c:comp", DAV_NS)]
        if comps and "VEVENT" not in comps:
            continue                          # task lists only
        color = (r.findtext(".//a:calendar-color", "", DAV_NS) or "").strip()[:7]
        url = urllib.parse.urljoin(base, href)
        cals.append({"url": url, "name": (r.findtext(".//d:displayname", "", DAV_NS) or "").strip() or url.rstrip("/").rsplit("/", 1)[-1],
                     "color": color if re.fullmatch(r"#[0-9a-fA-F]{6}", color) else ""})
    if not cals:
        raise ValueError("signed in, but no calendars were found there")
    return cals


def caldav_fetch(src: dict, lo, hi, refresh: bool) -> tuple[list[str], str]:
    """Events of one CalDAV calendar between lo and hi, as ICS texts (cached for 15 minutes)."""
    import hashlib
    import time
    import xml.etree.ElementTree as ET
    url, aid = str(src.get("url", "")), str(src.get("account", ""))
    CAL_CACHE.mkdir(parents=True, exist_ok=True)
    f = CAL_CACHE / (hashlib.sha1(("caldav:" + url).encode()).hexdigest() + ".json")
    if not refresh and f.exists() and time.time() - f.stat().st_mtime < 900:
        try:
            return json.loads(f.read_text()), ""
        except ValueError:
            pass
    acct = next((a for a in (cal_settings().get("accounts") or []) if a.get("id") == aid), None)
    if not acct:
        return [], "its account was removed"
    password = acct_secret_get(aid)
    if not password:
        return [], "no password saved for " + (acct.get("name") or acct.get("user", "the account"))
    t = lambda d: d.strftime("%Y%m%dT000000Z")
    body = ('<?xml version="1.0"?><c:calendar-query xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
            '<d:prop><c:calendar-data/></d:prop><c:filter><c:comp-filter name="VCALENDAR"><c:comp-filter name="VEVENT">'
            f'<c:time-range start="{t(lo)}" end="{t(hi)}"/></c:comp-filter></c:comp-filter></c:filter></c:calendar-query>')
    try:
        _, _, xml = dav_request("REPORT", url, acct.get("user", ""), password, body, depth="1")
        texts = [e.text for e in ET.fromstring(xml).iter("{urn:ietf:params:xml:ns:caldav}calendar-data") if e.text]
    except Exception as e:
        if f.exists():
            return json.loads(f.read_text()), ""
        return [], ai_http_error(e) if not isinstance(e, ValueError) else str(e)
    f.write_text(json.dumps(texts))
    return texts, ""


def cal_settings() -> dict:
    try:
        return json.loads((CONFIG_DIR / "settings.json").read_text()).get("calendar", {}) or {}
    except (OSError, ValueError):
        return {}


def cmd_accounts(args: list[str]) -> int:
    sub = args[0] if args else ""
    if sub == "discover" and len(args) > 2:
        password = sys.stdin.readline().rstrip("\n")
        try:
            print(json.dumps({"calendars": caldav_discover(args[1], args[2], password)}))
        except Exception as e:
            print(json.dumps({"error": str(e) if isinstance(e, ValueError) else ai_http_error(e)}))
        return 0
    if sub == "secret" and len(args) > 1:
        if not re.fullmatch(r"[\w-]{1,64}", args[1]):
            die("bad account id")
        if "--clear" in args:
            acct_secret_file(args[1], None)
            if ai_keyring():
                subprocess.run(["secret-tool", "clear", "service", "flamenco-calendar", "account", args[1]], capture_output=True, timeout=10)
            print("cleared")
            return 0
        value = sys.stdin.readline().rstrip("\n")
        if not value:
            die("no password given on stdin")
        print(acct_secret_set(args[1], value))
        return 0
    die("usage: flamenco accounts discover SERVER USER (password on stdin) | secret ID [--clear]")


def calendar_events(days_before: int = 7, days_after: int = 62, refresh: bool = False) -> dict:
    from datetime import datetime, timedelta
    try:
        cfg = json.loads((CONFIG_DIR / "settings.json").read_text()).get("calendar", {}) or {}
    except (OSError, ValueError):
        cfg = {}
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    lo, hi = today - timedelta(days=days_before), today + timedelta(days=days_after)
    events, errors = [], {}
    for src in cfg.get("sources", []) or []:
        if not src.get("enabled", True):
            continue
        texts, err = caldav_fetch(src, lo, hi, refresh) if src.get("type") == "caldav" else cal_fetch(src, refresh)
        if err:
            errors[src.get("name") or src.get("url", "")] = err
        for t in texts:
            try:
                events += ics_events(t, lo, hi, src.get("name", ""), src.get("color", ""))
            except Exception as e:
                errors[src.get("name") or src.get("url", "")] = f"couldn't read it: {e}"
    events.sort(key=lambda e: (e["start"], not e["allDay"]))
    return {"events": events, "errors": errors}


def cmd_calendar(args: list[str]) -> int:
    if args[:1] == ["events"]:
        print(json.dumps(calendar_events(refresh="--refresh" in args)))
        return 0
    return ipc("calendar", args[0] if args else "toggle")


# ─────────────────────────────── package updates ─────────────────────────────
# Repo updates through checkupdates (pacman-contrib: its own copy of the sync
# database, no root), AUR updates through paru or yay, and Flatpak updates.

def updates_list() -> dict:
    out = {"repo": [], "aur": [], "flatpak": [], "tools": {}, "upgrade": ""}
    if shutil.which("checkupdates"):
        r = subprocess.run(["checkupdates"], capture_output=True, text=True, timeout=180)
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 4:
                out["repo"].append({"name": parts[0], "from": parts[1], "to": parts[3]})
        out["tools"]["checkupdates"] = True
    mgr = pkg_manager()
    if mgr == "apt" and not shutil.which("checkupdates"):
        # from the last `apt update` (no root needed to read it)
        r = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True, timeout=120)
        for line in r.stdout.splitlines():
            m = re.match(r"^([^/\s]+)/\S+\s+(\S+)\s+\S+\s+\[upgradable from: ([^\]]+)\]", line)
            if m:
                out["repo"].append({"name": m.group(1), "from": m.group(3), "to": m.group(2)})
        out["tools"]["apt"] = True
    elif mgr == "dnf" and not shutil.which("checkupdates"):
        r = subprocess.run(["dnf", "-q", "check-update"], capture_output=True, text=True, timeout=180)
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) == 3 and "." in parts[0] and not line.startswith(" "):
                out["repo"].append({"name": parts[0].rsplit(".", 1)[0], "from": "", "to": parts[1]})
        out["tools"]["dnf"] = True
    aur = next((h for h in ("paru", "yay") if shutil.which(h)), "") if mgr == "pacman" else ""
    if aur:
        r = subprocess.run([aur, "-Qua"], capture_output=True, text=True, timeout=180)
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 4 and parts[2] == "->":
                out["aur"].append({"name": parts[0], "from": parts[1], "to": parts[3]})
        out["tools"]["aur"] = aur
    if shutil.which("flatpak"):
        r = subprocess.run(["flatpak", "remote-ls", "--updates", "--columns=application,version"], capture_output=True, text=True, timeout=120)
        for line in r.stdout.splitlines():
            parts = line.split("\t")
            if parts and parts[0]:
                out["flatpak"].append({"name": parts[0], "from": "", "to": parts[1] if len(parts) > 1 else ""})
        out["tools"]["flatpak"] = True
    steps = ["sudo apt update && sudo apt upgrade" if mgr == "apt" else "sudo dnf upgrade" if mgr == "dnf"
             else f"{aur} -Syu" if aur else "sudo pacman -Syu"]
    if out["flatpak"]:
        steps.append("flatpak update")
    out["upgrade"] = " && ".join(steps)
    out["count"] = len(out["repo"]) + len(out["aur"]) + len(out["flatpak"])
    return out


def cmd_updates(args: list[str]) -> int:
    u = updates_list()
    if "--json" in args:
        print(json.dumps(u))
    else:
        for k in ("repo", "aur", "flatpak"):
            for p in u[k]:
                print(f"{k:<8} {p['name']} {p['from']} -> {p['to']}")
        print(f"{u['count']} update(s). Upgrade with: {u['upgrade']}")
    return 0


# ─────────────────────────────── wallhaven ───────────────────────────────────
# The wallpaper picker's online tab: download a Wallhaven image into
# <wallpaper folder>/wallhaven and print its path.

def cmd_wallhaven(args: list[str]) -> int:
    import urllib.request
    if args[:1] != ["get"] or len(args) < 2:
        die("usage: flamenco wallhaven get IMAGE_URL")
    url = args[1]
    if not re.fullmatch(r"https://w\.wallhaven\.cc/full/[0-9a-z]{2}/wallhaven-[0-9a-z]+\.(jpg|jpeg|png|webp)", url):
        die("not a Wallhaven image address")
    try:
        wp = json.loads((CONFIG_DIR / "settings.json").read_text()).get("wallpaper", {}).get("dir") or "~/Pictures/Wallpapers"
    except (OSError, ValueError):
        wp = "~/Pictures/Wallpapers"
    folder = Path(os.path.expanduser(wp)) / "wallhaven"
    folder.mkdir(parents=True, exist_ok=True)
    dest = folder / url.rsplit("/", 1)[1]
    if not dest.exists():
        tmp = dest.with_suffix(dest.suffix + ".part")
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "flamenco-shell"})
            with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
                shutil.copyfileobj(r, f)
            tmp.replace(dest)
        except Exception as e:
            tmp.unlink(missing_ok=True)
            die(f"download failed: {ai_http_error(e)}")
    print(dest)
    return 0


# ─────────────────────────────── users ───────────────────────────────────────
# Settings → Users: your name, picture and password, and (for administrators)
# the other accounts. Your own name and picture go through AccountsService (no
# password needed for your own account); anything needing root runs in a terminal
# (sudo), and passwords are only ever typed into `passwd` there.
#   flamenco users list [--json]
#   flamenco users name "Full Name" [USER]      USER: someone else's (needs root)
#   flamenco users avatar PICTURE | --remove
#   flamenco users password [USER]
#   flamenco users add USER "Full Name" [--admin] [--shell PATH] [--groups a,b]
#   flamenco users remove USER [--keep-home]
#   flamenco users admin USER on|off

USER_NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
FACE = HOME / ".face"


def admin_group() -> str:
    import grp
    for g in ("wheel", "sudo", "admin"):
        try:
            grp.getgrnam(g)
            return g
        except KeyError:
            continue
    return "wheel"


def accounts_path(name: str) -> str:
    """AccountsService's object for a user ("" without AccountsService)."""
    if not shutil.which("busctl"):
        return ""
    r = subprocess.run(["busctl", "--system", "call", "org.freedesktop.Accounts", "/org/freedesktop/Accounts",
                        "org.freedesktop.Accounts", "FindUserByName", "s", name], capture_output=True, text=True, timeout=10)
    m = re.search(r'"(/org/freedesktop/Accounts/[^"]+)"', r.stdout) if r.returncode == 0 else None
    return m.group(1) if m else ""


def accounts_call(name: str, method: str, value: str) -> bool:
    path = accounts_path(name)
    if not path:
        return False
    r = subprocess.run(["busctl", "--system", "call", "org.freedesktop.Accounts", path, "org.freedesktop.Accounts.User",
                        method, "s", value], capture_output=True, text=True, timeout=30)
    return r.returncode == 0


def users_list() -> dict:
    import grp
    import pwd
    me = pwd.getpwuid(os.getuid()).pw_name
    group = admin_group()
    admins = set()
    for gname in ("wheel", "sudo", "admin"):
        try:
            g = grp.getgrnam(gname)
        except KeyError:
            continue
        admins |= set(g.gr_mem) | {p.pw_name for p in pwd.getpwall() if p.pw_gid == g.gr_gid}
    out = []
    for p in sorted(pwd.getpwall(), key=lambda p: p.pw_uid):
        if not (1000 <= p.pw_uid < 60000) or p.pw_shell.endswith(("nologin", "false")):
            continue
        icon = Path("/var/lib/AccountsService/icons") / p.pw_name
        face = Path(p.pw_dir) / ".face"
        avatar = str(face) if p.pw_name == me and face.is_file() else str(icon) if os.access(icon, os.R_OK) else ""
        out.append({"name": p.pw_name, "uid": p.pw_uid, "fullName": p.pw_gecos.split(",")[0], "home": p.pw_dir,
                    "shell": p.pw_shell, "admin": p.pw_name in admins or p.pw_uid == 0, "me": p.pw_name == me, "avatar": avatar})
    shells = []
    try:
        shells = [l.strip() for l in Path("/etc/shells").read_text().splitlines() if l.strip().startswith("/") and Path(l.strip()).exists()]
    except OSError:
        pass
    return {"me": me, "adminGroup": group, "isAdmin": me in admins, "accounts": bool(accounts_path(me)), "users": out,
            "shells": sorted(set(shells)) or ["/bin/bash"], "canSudo": bool(shutil.which("sudo"))}


def pause_if_terminal() -> None:
    if sys.stdin.isatty() and os.environ.get("FLAMENCO_PAUSE"):
        try:
            input("\nPress Enter to close… ")
        except EOFError:
            pass


def cmd_users(args: list[str]) -> int:
    sub = args[0] if args else "list"
    me = users_list()["me"]
    if sub == "list":
        u = users_list()
        if "--json" in args:
            print(json.dumps(u))
        else:
            for x in u["users"]:
                print(f"{x['name']:<16} {x['fullName']:<24} {'admin' if x['admin'] else 'standard'}{'  (you)' if x['me'] else ''}")
        return 0
    if sub == "name" and len(args) > 1:
        full = re.sub(r"[\x00-\x1f\x7f,:]", " ", args[1]).strip()[:64]
        who = args[2] if len(args) > 2 else me
        if not USER_NAME.match(who):
            die(f"not a user name: {who}")
        if who == me and accounts_call(me, "SetRealName", full):
            print("name changed")
            return 0
        # without AccountsService (or for someone else): usermod as root, in the terminal
        rc = privileged(["usermod", "-c", full, who])
        pause_if_terminal()
        return rc
    if sub == "avatar" and len(args) > 1:
        if args[1] == "--remove":
            FACE.unlink(missing_ok=True)
            accounts_call(me, "SetIconFile", "")
            print("picture removed")
            return 0
        src = Path(os.path.expanduser(args[1]))
        if not src.is_file():
            die(f"no such picture: {src}")
        tmp = FACE.with_name(".face.flamenco-tmp.png")
        # a square, 512 px picture (the middle of it), when ffmpeg is there; else as it is
        if shutil.which("ffmpeg"):
            r = subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(src), "-frames:v", "1",
                                "-vf", "crop=min(iw\\,ih):min(iw\\,ih),scale=512:512", str(tmp)], capture_output=True, timeout=60)
            if r.returncode != 0 or not tmp.is_file():
                shutil.copyfile(src, tmp)
        else:
            shutil.copyfile(src, tmp)
        tmp.replace(FACE)
        os.chmod(FACE, 0o644)
        # the login screen and other apps read AccountsService's copy
        accounts_call(me, "SetIconFile", str(FACE))
        print(FACE)
        return 0
    if sub == "password":
        who = args[1] if len(args) > 1 else me
        if not USER_NAME.match(who):
            die(f"not a user name: {who}")
        print(f"Changing the password of {who}." + (" Type your current password first." if who == me else ""))
        rc = subprocess.run(["passwd"]).returncode if who == me else privileged(["passwd", who])
        print("\nPassword changed." if rc == 0 else "\nThe password wasn't changed.")
        pause_if_terminal()
        return rc
    if sub == "add" and len(args) > 2:
        name, full = args[1], re.sub(r"[\x00-\x1f\x7f,:]", " ", args[2]).strip()[:64]
        if not USER_NAME.match(name):
            die("user names are lowercase letters, digits, _ and -, starting with a letter (up to 32)")
        if any(x["name"] == name for x in users_list()["users"]):
            die(f"{name} already exists")
        opt = lambda flag: args[args.index(flag) + 1] if flag in args and args.index(flag) + 1 < len(args) else ""
        shell = opt("--shell") or "/bin/bash"
        if shell not in users_list()["shells"]:
            die(f"not a login shell in /etc/shells: {shell}")
        import grp
        groups = [g for g in re.split(r"[,\s]+", opt("--groups")) if g]
        for g in groups:
            if not USER_NAME.match(g):
                die(f"not a group name: {g}")
            try:
                grp.getgrnam(g)
            except KeyError:
                die(f"there's no group called {g}")
        if "--admin" in args:
            groups.append(admin_group())
        cmd = ["useradd", "-m", "-c", full, "-s", shell] + (["-G", ",".join(dict.fromkeys(groups))] if groups else [])
        print(f"Adding {name} ({full})" + (f", in {', '.join(dict.fromkeys(groups))}" if groups else "") + ".")
        rc = privileged(cmd + [name])
        # always a password now: an account without one could be signed into as it is
        if rc == 0:
            print(f"\nNow a password for {name}:")
            rc = privileged(["passwd", name])
        pause_if_terminal()
        return rc
    if sub == "remove" and len(args) > 1:
        name = args[1]
        if not USER_NAME.match(name):
            die(f"not a user name: {name}")
        if name == me:
            die("you can't remove the account you're using")
        keep = "--keep-home" in args
        print(f"Removing {name}" + (" (keeping their home folder)." if keep else " and their home folder."))
        rc = privileged(["userdel"] + ([] if keep else ["-r"]) + [name])
        pause_if_terminal()
        return rc
    if sub == "admin" and len(args) > 2 and args[2] in ("on", "off"):
        name = args[1]
        if not USER_NAME.match(name):
            die(f"not a user name: {name}")
        g = admin_group()
        print(("Making " + name + " an administrator" if args[2] == "on" else "Making " + name + " a standard user") + f" (group {g}).")
        rc = privileged(["gpasswd", "-a" if args[2] == "on" else "-d", name, g])
        pause_if_terminal()
        return rc
    die("usage: flamenco users list [--json] | name \"Full Name\" [USER] | avatar PICTURE|--remove | password [USER] | add USER \"Full Name\" [--admin] | remove USER [--keep-home] | admin USER on|off")


# ─────────────────────────────── date & time ─────────────────────────────────
# Settings → Date & Time, through systemd (timedatectl, systemd-timesyncd).
# Changes need root: they run with sudo (in the terminal the shell opens), except
# the time zone when "automatic time zone" installed a polkit rule letting
# administrators change just that without a password (as GNOME does).
#   flamenco datetime status [--json]
#   flamenco datetime timezones
#   flamenco datetime detect                   the time zone of where you are (from your IP)
#   flamenco datetime timezone ZONE
#   flamenco datetime ntp on|off
#   flamenco datetime server "a.example b.example" | --default
#   flamenco datetime set "YYYY-MM-DD HH:MM[:SS]"
#   flamenco datetime auto-rule on|off          the polkit rule for automatic time zones

TZ_RULE = Path("/etc/polkit-1/rules.d/50-flamenco-timezone.rules")
TIMESYNC_DROPIN = Path("/etc/systemd/timesyncd.conf.d/50-flamenco.conf")
NTP_HOST = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$|^\[?[0-9A-Fa-f:.]{2,45}\]?$")


def timedate_status() -> dict:
    def show(*cmd):
        r = subprocess.run(["timedatectl", *cmd], capture_output=True, text=True, timeout=10) if shutil.which("timedatectl") else None
        return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l) if r and r.returncode == 0 else {}
    t, sync = show("show"), show("show-timesync")
    servers = ""
    try:
        if TIMESYNC_DROPIN.is_file():
            m = re.search(r"(?m)^NTP=(.*)$", TIMESYNC_DROPIN.read_text())
            servers = m.group(1).strip() if m else ""
    except OSError:
        pass
    chrony = subprocess.run(["systemctl", "is-active", "chronyd"], capture_output=True, text=True).stdout.strip() == "active" if shutil.which("systemctl") else False
    return {"timezone": t.get("Timezone", ""), "ntp": t.get("NTP", "no") == "yes", "synced": t.get("NTPSynchronized", "no") == "yes",
            "canNtp": t.get("CanNTP", "no") == "yes", "localRtc": t.get("LocalRTC", "no") == "yes",
            "server": sync.get("ServerName", ""), "customServers": servers, "chrony": chrony,
            "autoRule": TZ_RULE.is_file(), "available": bool(t)}


def detect_timezone() -> str:
    """The time zone of where this computer seems to be (ipapi / Open-Meteo, by IP)."""
    import urllib.request
    for url in ("https://ipapi.co/timezone/", "https://api.open-meteo.com/v1/forecast?latitude=0&longitude=0&timezone=auto"):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=10) as r:
                body = r.read(4096).decode("utf-8", errors="replace").strip()
        except Exception:
            continue
        if body.startswith("{"):
            # Open-Meteo answers for the coordinates, not the IP: only used as a sanity fallback
            continue
        if re.fullmatch(r"[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}", body) and Path("/usr/share/zoneinfo", body).is_file():
            return body
    return ""


def valid_timezone(z: str) -> bool:
    return bool(re.fullmatch(r"[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}|UTC", z)) and Path("/usr/share/zoneinfo", z).is_file()


def cmd_datetime(args: list[str]) -> int:
    sub = args[0] if args else "status"
    if sub == "status":
        st = timedate_status()
        print(json.dumps(st) if "--json" in args else "\n".join(f"{k}: {v}" for k, v in st.items()))
        return 0
    if sub == "timezones":
        zones = []
        if shutil.which("timedatectl"):
            r = subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True, timeout=20)
            zones = r.stdout.split()
        if not zones:
            # tzdata's own list
            for tab in ("/usr/share/zoneinfo/tzdata.zi", "/usr/share/zoneinfo/zone1970.tab", "/usr/share/zoneinfo/zone.tab"):
                try:
                    text = Path(tab).read_text(errors="replace")
                except OSError:
                    continue
                if tab.endswith(".zi"):
                    zones = [l.split()[1] for l in text.splitlines() if l.startswith(("Z ", "L ")) and len(l.split()) > 1]
                else:
                    zones = [l.split("\t")[2] for l in text.splitlines() if l and not l.startswith("#") and len(l.split("\t")) > 2]
                if zones:
                    break
        print("\n".join(sorted(set(zones) | {"UTC"})))
        return 0
    if sub == "detect":
        z = detect_timezone()
        if not z:
            die("couldn't tell where you are (offline?)")
        print(z)
        return 0
    if sub == "timezone" and len(args) > 1:
        z = args[1]
        if not valid_timezone(z):
            die(f"not a time zone: {z}")
        # without a password when the polkit rule allows it; else sudo in the terminal
        r = subprocess.run(["timedatectl", "--no-ask-password", "set-timezone", z], capture_output=True, text=True)
        rc = r.returncode if r.returncode == 0 else privileged(["timedatectl", "set-timezone", z])
        pause_if_terminal()
        return rc
    if sub == "ntp" and len(args) > 1 and args[1] in ("on", "off"):
        rc = privileged(["timedatectl", "set-ntp", "true" if args[1] == "on" else "false"])
        pause_if_terminal()
        return rc
    if sub == "server" and len(args) > 1:
        if args[1] == "--default":
            rc = privileged(["rm", "-f", str(TIMESYNC_DROPIN)])
        else:
            hosts = args[1].split()
            if not hosts or len(hosts) > 8 or not all(NTP_HOST.match(h) for h in hosts):
                die("time servers are host names or IP addresses, separated by spaces")
            body = f"# {MARKER}: Flamenco Settings → Date & Time\n[Time]\nNTP={' '.join(hosts)}\n"
            # written through tee as root (no shell): the content is validated above
            rc = privileged(["mkdir", "-p", str(TIMESYNC_DROPIN.parent)])
            if rc == 0:
                if os.geteuid() == 0:
                    TIMESYNC_DROPIN.write_text(body)
                else:
                    rc = subprocess.run(["sudo", "tee", str(TIMESYNC_DROPIN)], input=body, text=True, stdout=subprocess.DEVNULL).returncode \
                        if sys.stdin.isatty() and shutil.which("sudo") else privileged(["sh", "-c", 'printf "%s" "$1" > "$2"', "sh", body, str(TIMESYNC_DROPIN)])
        if rc == 0:
            rc = privileged(["systemctl", "restart", "systemd-timesyncd"])
        print("Time servers updated." if rc == 0 else "The time servers weren't changed.")
        pause_if_terminal()
        return rc
    if sub == "set" and len(args) > 1:
        when = args[1].strip()
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2} \d{2}:\d{2}(:\d{2})?", when):
            die('the time as "YYYY-MM-DD HH:MM"')
        rc = privileged(["timedatectl", "set-ntp", "false"])
        if rc == 0:
            rc = privileged(["timedatectl", "set-time", when])
        pause_if_terminal()
        return rc
    if sub == "auto-rule" and len(args) > 1 and args[1] in ("on", "off"):
        if args[1] == "off":
            rc = privileged(["rm", "-f", str(TZ_RULE)])
        else:
            group = admin_group()
            rule = (f"// {MARKER}: Flamenco Settings → Date & Time → Automatic time zone.\n"
                    "// Lets administrators at this computer change the time zone (only that) without a password.\n"
                    "polkit.addRule(function(action, subject) {\n"
                    '    if (action.id == "org.freedesktop.timedate1.set-timezone" &&\n'
                    f'        subject.isInGroup("{group}") && subject.local && subject.active) {{\n'
                    "        return polkit.Result.YES;\n    }\n});\n")
            if os.geteuid() == 0:
                TZ_RULE.write_text(rule)
                rc = 0
            elif sys.stdin.isatty() and shutil.which("sudo"):
                rc = subprocess.run(["sudo", "tee", str(TZ_RULE)], input=rule, text=True, stdout=subprocess.DEVNULL).returncode
            else:
                rc = privileged(["sh", "-c", 'printf "%s" "$1" > "$2"', "sh", rule, str(TZ_RULE)])
        print(("Automatic time zone can now change it without a password." if args[1] == "on" else "Removed.") if rc == 0 else "Nothing was changed.")
        pause_if_terminal()
        return rc
    die('usage: flamenco datetime status [--json] | timezones | detect | timezone ZONE | ntp on|off | server "HOSTS"|--default | set "YYYY-MM-DD HH:MM" | auto-rule on|off')


# ─────────────────────────────── live wallpapers ─────────────────────────────
# Videos and GIFs in the wallpaper folder play on the desktop. The picker's
# "Live" tab finds more online through this (the shell never sees the API keys):
#   flamenco live search SOURCE [QUERY] [PAGE]   JSON: {"results": [...], "more": bool}
#   flamenco live get URL                         download into <folder>/live, print its path
#   flamenco live key SOURCE [--clear]            store an API key (read from stdin)
#   flamenco live keys                            JSON: which sources have a key
#   flamenco live poster VIDEO                    make (or find) its still, print its path
# Sources: wikimedia (Wikimedia Commons, no key), pexels and pixabay (free API keys).

LIVE_SOURCES = {
    "wikimedia": {"name": "Wikimedia Commons", "key": False, "site": "https://commons.wikimedia.org"},
    "pexels": {"name": "Pexels", "key": True, "site": "https://www.pexels.com/api/"},
    "pixabay": {"name": "Pixabay", "key": True, "site": "https://pixabay.com/api/docs/"},
}
LIVE_KEY_FILE = CONFIG_DIR / "wallpaper-keys.json"
LIVE_TYPES = {"video/mp4": ".mp4", "video/webm": ".webm", "video/quicktime": ".mov", "video/x-matroska": ".mkv", "image/gif": ".gif"}
LIVE_EXTS = (".mp4", ".webm", ".mkv", ".mov", ".m4v", ".gif")
LIVE_MAX_BYTES = 600 * 1024 * 1024
UA = "flamenco-shell/" + VERSION + " (https://github.com/niruxx/flamenco-shell)"


def _ipv4_first():
    """Web requests try IPv4 addresses first: Python waits out the whole timeout on each
    address in turn, so a network with broken IPv6 made every download hang."""
    import socket
    real = socket.getaddrinfo

    def ordered(*a, **kw):
        return sorted(real(*a, **kw), key=lambda r: r[0] != socket.AF_INET)
    socket.getaddrinfo = ordered


_ipv4_first()


def wallpaper_dir() -> Path:
    try:
        wp = json.loads((CONFIG_DIR / "settings.json").read_text()).get("wallpaper", {}).get("dir") or "~/Pictures/Wallpapers"
    except (OSError, ValueError):
        wp = "~/Pictures/Wallpapers"
    return Path(os.path.expanduser(wp))


def live_key_get(src: str) -> str:
    if ai_keyring():
        r = subprocess.run(["secret-tool", "lookup", "service", "flamenco-wallpaper", "source", src],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    try:
        return str(json.loads(LIVE_KEY_FILE.read_text()).get(src, ""))
    except (OSError, ValueError):
        return ""


def live_key_file_write(src: str, key: str | None) -> None:
    try:
        data = json.loads(LIVE_KEY_FILE.read_text())
    except (OSError, ValueError):
        data = {}
    if key is None:
        if data.pop(src, None) is None:
            return
    else:
        data[src] = key
    LIVE_KEY_FILE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(LIVE_KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(LIVE_KEY_FILE, 0o600)


def live_key_set(src: str, key: str) -> str:
    if ai_keyring():
        r = subprocess.run(["secret-tool", "store", "--label", f"Flamenco wallpapers: {LIVE_SOURCES[src]['name']}",
                            "service", "flamenco-wallpaper", "source", src], input=key, text=True,
                           capture_output=True, timeout=30)
        if r.returncode == 0:
            live_key_file_write(src, None)
            return "keyring"
    live_key_file_write(src, key)
    return "file"


def live_key_clear(src: str) -> None:
    if ai_keyring():
        subprocess.run(["secret-tool", "clear", "service", "flamenco-wallpaper", "source", src], capture_output=True, timeout=10)
    live_key_file_write(src, None)


def live_fetch_json(url: str, headers: dict | None = None):
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json", **(headers or {})})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode("utf-8", errors="replace"))


def live_best(files: list[dict], max_w: int = 2560) -> dict | None:
    """The largest of `files` ({w, h, url}) no wider than max_w, else the smallest."""
    files = [f for f in files if f.get("url")]
    fit = [f for f in files if (f.get("w") or 0) <= max_w]
    if fit:
        return max(fit, key=lambda f: f.get("w") or 0)
    return min(files, key=lambda f: f.get("w") or 0) if files else None


def live_search(src: str, query: str, page: int) -> dict:
    import urllib.parse
    q = query.strip()
    out = []
    if src == "wikimedia":
        per = 24
        params = {"action": "query", "format": "json", "formatversion": "2", "generator": "search", "gsrnamespace": "6",
                  "gsrsearch": f"filetype:video filew:>1279 {q or 'nature'}", "gsrlimit": str(per), "gsroffset": str((page - 1) * per),
                  "prop": "videoinfo", "viprop": "url|size|mime|derivatives", "viurlwidth": "480"}
        d = live_fetch_json("https://commons.wikimedia.org/w/api.php?" + urllib.parse.urlencode(params))
        for pg in sorted((d.get("query") or {}).get("pages") or [], key=lambda x: x.get("index", 0)):
            vi = (pg.get("videoinfo") or [{}])[0]
            w, h = vi.get("width") or 0, vi.get("height") or 0
            if not w or w < h:
                continue
            files = [{"w": x.get("width") or 0, "h": x.get("height") or 0, "url": x.get("src", "")}
                     for x in vi.get("derivatives") or [] if "webm" in str(x.get("type", "")) or "mp4" in str(x.get("type", ""))]
            if vi.get("mime") in ("video/webm", "video/mp4"):
                files.append({"w": w, "h": h, "url": vi.get("url", "")})
            best = live_best(files)
            if not best:
                continue
            out.append({"id": str(pg.get("pageid")), "title": re.sub(r"^File:|\.[^.]+$", "", pg.get("title", "")),
                        "thumb": vi.get("thumburl", ""), "url": best["url"], "w": best["w"] or w, "h": best["h"] or h,
                        "duration": round(float(vi.get("duration") or 0)), "author": "", "page": vi.get("descriptionurl", "")})
        return {"results": out, "more": "continue" in d}
    key = live_key_get(src)
    if not key:
        return {"results": [], "more": False, "needKey": True,
                "error": f"{LIVE_SOURCES[src]['name']} needs a free API key: add it in Settings → Wallpaper → Live wallpapers"}
    if src == "pexels":
        per = 24
        if q:
            url = "https://api.pexels.com/videos/search?" + urllib.parse.urlencode({"query": q, "orientation": "landscape", "size": "large", "per_page": per, "page": page})
        else:
            url = "https://api.pexels.com/videos/popular?" + urllib.parse.urlencode({"min_width": 1920, "per_page": per, "page": page})
        d = live_fetch_json(url, {"Authorization": key})
        for v in d.get("videos") or []:
            files = [{"w": f.get("width") or 0, "h": f.get("height") or 0, "url": f.get("link", "")}
                     for f in v.get("video_files") or [] if f.get("file_type") == "video/mp4"]
            best = live_best(files)
            if best and (v.get("width") or 0) >= (v.get("height") or 0):
                out.append({"id": str(v.get("id")), "title": "", "thumb": v.get("image", ""), "url": best["url"], "w": best["w"], "h": best["h"],
                            "duration": int(v.get("duration") or 0), "author": (v.get("user") or {}).get("name", ""), "page": v.get("url", "")})
        return {"results": out, "more": bool(d.get("next_page"))}
    if src == "pixabay":
        per = 24
        url = "https://pixabay.com/api/videos/?" + urllib.parse.urlencode({"key": key, "q": q, "page": page, "per_page": per, "safesearch": "true", "order": "popular" if not q else "popular"})
        d = live_fetch_json(url)
        for v in d.get("hits") or []:
            vids = v.get("videos") or {}
            files = [{"w": f.get("width") or 0, "h": f.get("height") or 0, "url": f.get("url", "")} for f in vids.values() if isinstance(f, dict)]
            best = live_best(files)
            thumb = next((f.get("thumbnail") for f in (vids.get("medium"), vids.get("small"), vids.get("large")) if f and f.get("thumbnail")), "")
            if best and (best["w"] >= best["h"]):
                out.append({"id": str(v.get("id")), "title": str(v.get("tags", "")).split(",")[0], "thumb": thumb, "url": best["url"],
                            "w": best["w"], "h": best["h"], "duration": int(v.get("duration") or 0), "author": v.get("user", ""), "page": v.get("pageURL", "")})
        return {"results": out, "more": page * per < int(d.get("totalHits") or 0)}
    die(f"unknown source: {src} (wikimedia, pexels or pixabay)")


def live_poster(video: Path) -> Path | None:
    """Its still in ~/.cache/flamenco/live (the shell names it the same way: md5 of the path)."""
    import hashlib
    out = XDG_CACHE / "flamenco" / "live" / (hashlib.md5(str(video).encode()).hexdigest() + ".jpg")
    if out.is_file() and out.stat().st_size > 0:
        return out
    if not shutil.which("ffmpeg"):
        return None
    out.parent.mkdir(parents=True, exist_ok=True)
    base = ["ffmpeg", "-nostdin", "-loglevel", "error", "-y"]
    subprocess.run(base + ["-ss", "1", "-i", str(video), "-frames:v", "1", "-vf", "scale=min(2560\\,iw):-2", "-q:v", "3", str(out)], capture_output=True, timeout=60)
    if not (out.is_file() and out.stat().st_size > 0):
        subprocess.run(base + ["-i", str(video), "-frames:v", "1", "-q:v", "3", str(out)], capture_output=True, timeout=60)
    return out if out.is_file() and out.stat().st_size > 0 else None


def live_get(url: str) -> Path:
    import urllib.parse
    import urllib.request
    u = urllib.parse.urlparse(url)
    if u.scheme not in ("https", "http") or not u.netloc:
        die("not a web address (https://…)")
    folder = wallpaper_dir() / "live"
    folder.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        r = urllib.request.urlopen(req, timeout=60)
    except Exception as e:
        die(f"download failed: {ai_http_error(e)}")
    with r:
        ctype = r.headers.get_content_type()
        name = Path(urllib.parse.unquote(u.path)).name
        ext = Path(name).suffix.lower()
        if ext not in LIVE_EXTS:
            ext = LIVE_TYPES.get(ctype, "")
            if not ext:
                die(f"that isn't a video or a GIF ({ctype}); live wallpapers are mp4, webm, mkv, mov or gif")
            name = (Path(name).stem or "live") + ext
        stem = re.sub(r"[^\w.-]+", "-", Path(name).stem).strip("-.")[:80] or "live"
        size = int(r.headers.get("Content-Length") or 0)
        if size > LIVE_MAX_BYTES:
            die(f"too big ({size // 1048576} MB; the limit is {LIVE_MAX_BYTES // 1048576} MB)")
        dest = folder / (stem + ext)
        if dest.exists():
            return dest
        tmp = dest.with_name(dest.name + ".part")
        got = 0
        try:
            with open(tmp, "wb") as f:
                while chunk := r.read(1 << 16):
                    got += len(chunk)
                    if got > LIVE_MAX_BYTES:
                        raise ValueError(f"too big (over {LIVE_MAX_BYTES // 1048576} MB)")
                    f.write(chunk)
            tmp.replace(dest)
        except Exception as e:
            tmp.unlink(missing_ok=True)
            die(f"download failed: {ai_http_error(e)}")
    if dest.suffix != ".gif":
        live_poster(dest)
    return dest


def cmd_live(args: list[str]) -> int:
    sub = args[0] if args else ""
    if sub == "search":
        src = args[1] if len(args) > 1 else "wikimedia"
        if src not in LIVE_SOURCES:
            die(f"unknown source: {src} (wikimedia, pexels or pixabay)")
        query = args[2] if len(args) > 2 else ""
        page = max(1, int(args[3])) if len(args) > 3 and args[3].isdigit() else 1
        try:
            res = live_search(src, query, page)
        except Exception as e:
            res = {"results": [], "more": False, "error": f"{LIVE_SOURCES[src]['name']}: {ai_http_error(e)}"}
        print(json.dumps(res))
        return 0
    if sub == "get" and len(args) > 1:
        print(live_get(args[1]))
        return 0
    if sub == "key" and len(args) > 1:
        src = args[1]
        if src not in LIVE_SOURCES or not LIVE_SOURCES[src]["key"]:
            die("API keys are for pexels and pixabay")
        if "--clear" in args:
            live_key_clear(src)
            print("cleared")
            return 0
        key = sys.stdin.readline().strip()
        if not key:
            die("no key given (pipe it in: flamenco live key pexels <<< KEY)")
        print(live_key_set(src, key))
        return 0
    if sub == "keys":
        print(json.dumps({s: bool(live_key_get(s)) for s, v in LIVE_SOURCES.items() if v["key"]}))
        return 0
    if sub == "poster" and len(args) > 1:
        p = live_poster(Path(os.path.abspath(os.path.expanduser(args[1]))))
        if not p:
            die("couldn't make a still (is ffmpeg installed?)")
        print(p)
        return 0
    die("usage: flamenco live search SOURCE [QUERY] [PAGE] | get URL | key SOURCE [--clear] | keys | poster VIDEO")


# ─────────────────────────────── get new stuff ───────────────────────────────
# Settings → Get themes: like KDE's "Get New…", one place to find and install icon
# and cursor themes, GTK themes, KDE color schemes and wallpapers (from the KDE
# Store, store.kde.org / pling) and fonts (from Fontsource, the Google Fonts
# catalog and more). Everything goes into your home folder only, unpacked in a
# private staging folder first (no paths or links outside it), and is recorded in
# ~/.local/share/flamenco/get.json so it can be removed again.

GET_KINDS = {
    "icons": {"name": "Icon themes", "cat": "132"},
    "cursors": {"name": "Cursors", "cat": "107"},
    "gtk": {"name": "GTK themes", "cat": "135"},
    "colors": {"name": "Color schemes", "cat": "112"},
    "wallpapers": {"name": "Wallpapers", "cat": "299"},
    "fonts": {"name": "Fonts", "cat": ""},
}
GET_OCS = "https://api.kde-look.org/ocs/v1/content/data"
GET_MANIFEST = XDG_DATA / "flamenco" / "get.json"
GET_MAX_DOWNLOAD = 400 * 1024 * 1024
GET_MAX_UNPACKED = 2 * 1024 * 1024 * 1024
GET_MAX_FILES = 250_000
GET_NAME = re.compile(r"^[\w][\w.+ ()@,'-]{0,99}$")
GET_IMAGES = (".jpg", ".jpeg", ".png", ".webp", ".jxl", ".avif")
GET_POPULAR_FONTS = ["inter", "roboto", "open-sans", "lato", "montserrat", "poppins", "noto-sans", "jetbrains-mono", "fira-code",
                     "source-sans-3", "nunito", "raleway", "work-sans", "ibm-plex-sans", "manrope", "outfit", "dm-sans",
                     "space-grotesk", "ubuntu", "rubik", "playfair-display", "merriweather", "lora", "fira-sans", "geist"]


def get_dirs() -> dict[str, Path]:
    return {"icons": XDG_DATA / "icons", "cursors": XDG_DATA / "icons", "gtk": XDG_DATA / "themes",
            "colors": XDG_DATA / "color-schemes", "wallpapers": wallpaper_dir() / "kde-store", "fonts": XDG_DATA / "fonts" / "flamenco"}


def get_stage() -> Path:
    """Where downloads are unpacked before they're installed: only you can get in.
    Left-overs of an install that was cut off (over an hour old) are cleared."""
    import time
    d = XDG_CACHE / "flamenco" / "get"
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    for old in d.iterdir():
        try:
            if time.time() - old.lstat().st_mtime > 3600:
                shutil.rmtree(old) if old.is_dir() and not old.is_symlink() else old.unlink()
        except OSError:
            pass
    return d


def get_manifest() -> dict:
    try:
        m = json.loads(GET_MANIFEST.read_text())
        return m if isinstance(m, dict) else {}
    except (OSError, ValueError):
        return {}


def get_manifest_save(m: dict) -> None:
    GET_MANIFEST.parent.mkdir(parents=True, exist_ok=True)
    tmp = GET_MANIFEST.with_name(GET_MANIFEST.name + ".tmp")
    tmp.write_text(json.dumps(m, indent=1))
    tmp.replace(GET_MANIFEST)


def get_plain(text: str, limit: int = 400) -> str:
    """Store descriptions are BBCode/HTML: just the words."""
    t = re.sub(r"<[^>]*>|\[/?[a-zA-Z*][^\]]*\]", " ", str(text or ""))
    t = re.sub(r"&(amp|lt|gt|quot|#39|nbsp);", lambda x: {"amp": "&", "lt": "<", "gt": ">", "quot": '"', "#39": "'", "nbsp": " "}[x.group(1)], t)
    t = re.sub(r"\s+", " ", t).strip()
    return t[:limit] + ("…" if len(t) > limit else "")


def get_https(url: str) -> str:
    import urllib.parse
    u = urllib.parse.urlparse(url)
    if u.scheme != "https" or not u.hostname or dav_local(u.hostname):
        die(f"won't download from {u.hostname or url!r} (only https:// on the internet)")
    # store links can have spaces and such in their file names
    return urllib.parse.urlunparse(u._replace(path=urllib.parse.quote(urllib.parse.unquote(u.path), safe="/@:+,;=~!$&'()*"),
                                               query=urllib.parse.quote(u.query, safe="=&/:+,;%@~!$'()*")))


def get_pick(kind: str, files: list[dict]) -> dict:
    """The file to install when none is chosen: the first that looks installable here
    (for wallpapers: the biggest picture, one without a logo if there is one)."""
    if kind == "wallpapers":
        pics = [f for f in files if f["name"].lower().endswith(GET_IMAGES)]
        if pics:
            return max(pics, key=lambda f: (not re.search(r"with[ _-]?logo", f["name"], re.I), f["size"]))
    want = {"colors": (".colors",), "wallpapers": GET_IMAGES}.get(kind, ())
    archives = (".tar.gz", ".tgz", ".tar.xz", ".txz", ".tar.bz2", ".tbz2", ".tar.zst", ".tar", ".zip")
    for f in files:
        low = f["name"].lower()
        if low.endswith(want + archives) and not re.search(r"windows|\bwin\b|macos|\.exe", low):
            return f
    return files[0]


def get_files(item: dict) -> list[dict]:
    out = []
    for n in range(1, 40):
        link = item.get(f"downloadlink{n}")
        if not link:
            if n > 1 and not item.get(f"downloadlink{n + 1}"):
                break
            continue
        name = str(item.get(f"downloadname{n}") or Path(str(link).split("?")[0]).name)
        out.append({"n": n, "name": name, "size": int(float(item.get(f"downloadsize{n}") or 0)) * 1024,
                    "url": str(link), "md5": str(item.get(f"downloadmd5sum{n}") or "")})
    return out


def get_ocs(kind: str, query: str, page: int, sort: str) -> dict:
    import urllib.parse
    per = 24
    params = {"categories": GET_KINDS[kind]["cat"], "format": "json", "pagesize": per, "page": page - 1,
              "sortmode": {"new": "new", "rating": "high", "downloads": "down"}.get(sort, "high")}
    if query.strip():
        params["search"] = query.strip()
    d = live_fetch_json(GET_OCS + "?" + urllib.parse.urlencode(params))
    done = get_manifest().get(kind, {})
    out = []
    for it in d.get("data") or []:
        sid = str(it.get("id", ""))
        files = get_files(it)
        out.append({"id": sid, "name": get_plain(it.get("name"), 80), "author": str(it.get("personid") or ""),
                    "summary": get_plain(it.get("summary") or it.get("description"), 240),
                    "thumb": str(it.get("smallpreviewpic1") or it.get("previewpic1") or ""),
                    "preview": str(it.get("previewpic1") or ""), "page": str(it.get("detailpage") or ""),
                    "downloads": int(it.get("downloads") or 0), "score": round(int(it.get("score") or 0) / 10, 1),
                    "updated": str(it.get("changed") or "")[:10], "version": str(it.get("version") or ""),
                    "files": [{k: f[k] for k in ("n", "name", "size")} for f in files],
                    "installed": sid in done, "ours": sid in done, "names": (done.get(sid) or {}).get("names", []),
                    "paths": (done.get(sid) or {}).get("paths", [])})
    total = int(d.get("totalitems") or 0)
    return {"results": out, "more": page * per < total, "total": total}


def get_font_list(refresh: bool = False) -> list[dict]:
    import time
    cache = XDG_CACHE / "flamenco" / "fontsource.json"
    try:
        if not refresh and time.time() - cache.stat().st_mtime < 86400:
            return json.loads(cache.read_text())
    except (OSError, ValueError):
        pass
    data = live_fetch_json("https://api.fontsource.org/v1/fonts?subsets=latin")
    if not isinstance(data, list):
        die("Fontsource sent something unexpected")
    data = [f for f in data if isinstance(f, dict) and GET_NAME.match(str(f.get("id", ""))) and f.get("type") in ("google", "other")]
    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(data))
    return data


def get_fonts(query: str, page: int, category: str) -> dict:
    fonts = get_font_list()
    q = query.strip().lower()
    have = {f.lower() for f in font_families()}
    done = get_manifest().get("fonts", {})
    if category and category != "all":
        fonts = [f for f in fonts if f.get("category") == category]
    if q:
        fonts = sorted((f for f in fonts if q in str(f.get("family", "")).lower()),
                       key=lambda f: (not str(f.get("family", "")).lower().startswith(q), str(f.get("family", "")).lower()))
    else:
        rank = {fid: i for i, fid in enumerate(GET_POPULAR_FONTS)}
        fonts = sorted(fonts, key=lambda f: (rank.get(f.get("id"), len(rank)), str(f.get("family", "")).lower()))
    per = 30
    chunk = fonts[(page - 1) * per: page * per]
    out = [{"id": f["id"], "name": f.get("family", f["id"]), "author": f.get("license", ""), "summary": f.get("category", ""),
            "weights": f.get("weights") or [], "italic": "italic" in (f.get("styles") or []), "category": f.get("category", ""),
            "installed": f["id"] in done or str(f.get("family", "")).lower() in have, "ours": f["id"] in done,
            "names": [f.get("family", "")], "page": f"https://fontsource.org/fonts/{f['id']}"} for f in chunk]
    return {"results": out, "more": page * per < len(fonts), "total": len(fonts)}


def get_download(url: str, dest: Path, limit: int = GET_MAX_DOWNLOAD) -> str:
    """Saves `url` to `dest`; gives back the file name the server suggested."""
    import urllib.parse
    import urllib.request
    class Checked(urllib.request.HTTPRedirectHandler):
        # every redirect is checked too: https, and not to this computer or the home network
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            get_https(newurl)
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    req = urllib.request.Request(get_https(url), headers={"User-Agent": UA})
    try:
        r = urllib.request.build_opener(Checked).open(req, timeout=60)
    except Exception as e:
        die(f"download failed: {ai_http_error(e)}")
    with r:
        if int(r.headers.get("Content-Length") or 0) > limit:
            die(f"too big (the limit is {limit // 1048576} MB)")
        cd = r.headers.get("Content-Disposition") or ""
        m = re.search(r"filename\*?=(?:UTF-8'')?\"?([^\";]+)", cd)
        name = urllib.parse.unquote(m.group(1)) if m else Path(urllib.parse.unquote(urllib.parse.urlparse(r.geturl()).path)).name
        got = 0
        with open(dest, "wb") as f:
            while chunk := r.read(1 << 16):
                got += len(chunk)
                if got > limit:
                    die(f"too big (over {limit // 1048576} MB)")
                f.write(chunk)
    return Path(name).name


def get_unpack(archive: Path, name: str, into: Path) -> None:
    """Unpacks into `into` only: no absolute paths, no `..`, no links or devices leading out, a size and count cap."""
    import tarfile
    import zipfile
    into.mkdir()
    low = name.lower()
    if zipfile.is_zipfile(archive):
        total = 0
        with zipfile.ZipFile(archive) as z:
            infos = z.infolist()
            if len(infos) > GET_MAX_FILES:
                die("too many files in the archive")
            for zi in infos:
                total += zi.file_size
                if total > GET_MAX_UNPACKED:
                    die("the archive unpacks too big")
                dest = (into / zi.filename).resolve()
                if not dest.is_relative_to(into.resolve()) or dest == into.resolve():
                    continue
                if (zi.external_attr >> 16) & 0o170000 == 0o120000:
                    continue                      # a link: skipped
                if zi.is_dir():
                    dest.mkdir(parents=True, exist_ok=True)
                    continue
                dest.parent.mkdir(parents=True, exist_ok=True)
                with z.open(zi) as src, open(dest, "wb") as out:
                    shutil.copyfileobj(src, out)
        return
    src = archive
    with open(archive, "rb") as fh:
        magic = fh.read(4)
    if low.endswith((".zst", ".tzst")) or magic == b"\x28\xb5\x2f\xfd":
        if not shutil.which("zstd"):
            die("this archive is zstd-compressed and zstd isn't installed")
        src = archive.with_suffix(".tar")
        subprocess.run(["zstd", "-q", "-d", "-f", "-o", str(src), "--", str(archive)], check=True, timeout=600)
    try:
        tf = tarfile.open(src, "r:*")
    except tarfile.TarError:
        die(f"can't unpack {name} (not a tar or zip archive)")
    with tf:
        members, total = [], 0
        for ti in tf:
            if len(members) >= GET_MAX_FILES:
                die("too many files in the archive")
            total += max(0, ti.size)
            if total > GET_MAX_UNPACKED:
                die("the archive unpacks too big")
            if ti.isfile() or ti.isdir() or ti.issym() or ti.islnk():
                members.append(ti)
        def safe(ti, path):
            # tar's "data" rules (nothing outside, no devices, no setuid…); what breaks them is left out
            try:
                return tarfile.data_filter(ti, path)
            except tarfile.FilterError:
                return None
        tf.extractall(into, members=members, filter=safe)


def get_safe_links(root: Path) -> None:
    """Drops any link that points outside `root` (or nowhere)."""
    base = root.resolve()
    for dirpath, dirnames, filenames in os.walk(root):
        for n in dirnames + filenames:
            p = Path(dirpath) / n
            if p.is_symlink():
                try:
                    ok = p.resolve(strict=True).is_relative_to(base)
                except (OSError, RuntimeError):
                    ok = False
                if not ok:
                    p.unlink()


def get_find(kind: str, root: Path) -> list[Path]:
    """The theme folders (or files) inside what was unpacked."""
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        d = Path(dirpath)
        dirnames[:] = [x for x in dirnames if not x.startswith(".") and x != "__MACOSX"]
        if kind in ("icons", "cursors"):
            if "index.theme" not in filenames and not (kind == "cursors" and "cursors" in dirnames):
                continue
            idx = read_index(d / "index.theme")
            has_icons = idx.has_section("Icon Theme") and idx.get("Icon Theme", "Directories", fallback="").strip()
            if (kind == "icons" and has_icons) or (kind == "cursors" and (d / "cursors").is_dir()):
                found.append(d)
                dirnames[:] = []
        elif kind == "gtk":
            if any((d / g / f).is_file() for g in ("gtk-3.0", "gtk-4.0") for f in ("gtk.css", "gtk-dark.css", "gtk.gresource")):
                found.append(d)
                dirnames[:] = []
        elif kind == "colors":
            found += [d / f for f in filenames if f.lower().endswith(".colors")]
        elif kind == "wallpapers":
            found += [d / f for f in filenames if f.lower().endswith(GET_IMAGES)]
    if kind == "wallpapers" and found:
        # a KDE wallpaper package has the picture in several sizes: keep the biggest
        found = [max(found, key=lambda p: p.stat().st_size)]
    return found


def get_place(src: Path, dest_dir: Path, owned: set[str]) -> Path | None:
    """Moves `src` into `dest_dir` under its own name; replaces only what Flamenco put there."""
    name = src.name
    if not GET_NAME.match(name):
        name = re.sub(r"[^\w.+ ()@,'-]+", "-", name).strip("-. ()@,'+")[:100]
        if not GET_NAME.match(name):
            name = "theme" + src.suffix.lower()
    dest = dest_dir / name
    if dest.exists() or dest.is_symlink():
        if str(dest) not in owned:
            # someone else's: left alone (the same file counts as there already)
            same = src.is_file() and dest.is_file() and not dest.is_symlink() and dest.read_bytes() == src.read_bytes()
            return dest if same else None
        shutil.rmtree(dest) if dest.is_dir() and not dest.is_symlink() else dest.unlink()
    dest_dir.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(dest))
    return dest


def get_install_ocs(kind: str, sid: str, n: int) -> dict:
    import hashlib
    import tempfile
    import urllib.parse
    if not sid.isdigit():
        die("not a KDE Store id")
    d = live_fetch_json(f"{GET_OCS}/{sid}?" + urllib.parse.urlencode({"format": "json"}))
    items = d.get("data") or []
    if not items:
        die("not found in the KDE Store")
    item = items[0] if isinstance(items, list) else items
    files = get_files(item)
    if not files:
        die("it has no files to download")
    f = next((x for x in files if x["n"] == n), None) if n else get_pick(kind, files)
    if not f:
        die(f"it has no file {n}")
    with tempfile.TemporaryDirectory(dir=get_stage()) as tmp:
        tmp = Path(tmp)
        dl = tmp / "download"
        name = get_download(f["url"], dl) or f["name"]
        if f["md5"] and re.fullmatch(r"[0-9a-fA-F]{32}", f["md5"]):
            h = hashlib.md5()
            with open(dl, "rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    h.update(chunk)
            if h.hexdigest().lower() != f["md5"].lower():
                die("the download doesn't match the store's checksum: not installed")
        low = (name or f["name"]).lower()
        files_dir = tmp / "files"
        if kind == "colors" and low.endswith(".colors"):
            files_dir.mkdir()
            shutil.move(str(dl), str(files_dir / Path(name).name))
        elif kind == "wallpapers" and low.endswith(GET_IMAGES):
            files_dir.mkdir()
            shutil.move(str(dl), str(files_dir / Path(name).name))
        else:
            get_unpack(dl, name or f["name"], files_dir)
        get_safe_links(files_dir)
        found = get_find(kind, files_dir)
        if not found:
            die({"icons": "no icon theme (a folder with an index.theme) in that download",
                 "cursors": "no cursor theme (a folder with cursors/) in that download",
                 "gtk": "no GTK 3/4 theme in that download",
                 "colors": "no .colors file in that download",
                 "wallpapers": "no picture in that download"}[kind])
        m = get_manifest()
        owned = {p for e in m.get(kind, {}).values() for p in e.get("paths", [])}
        placed, skipped = [], []
        for src in found:
            dest = get_place(src, get_dirs()[kind], owned)
            (placed if dest else skipped).append(dest or src.name)
    if not placed:
        die("already there from somewhere else (not replaced): " + ", ".join(str(s) for s in skipped))
    names = [p.name if kind in ("icons", "cursors", "gtk") else p.stem if kind == "colors" else p.name for p in placed]
    m.setdefault(kind, {})[sid] = {"name": get_plain(item.get("name"), 80), "names": names, "paths": [str(p) for p in placed],
                                   "file": f["name"], "version": str(item.get("version") or ""), "changed": str(item.get("changed") or "")}
    get_manifest_save(m)
    return {"installed": True, "names": names, "paths": [str(p) for p in placed], "skipped": [str(s) for s in skipped]}


def get_install_font(fid: str) -> dict:
    import tempfile
    fonts = {f["id"]: f for f in get_font_list()}
    f = fonts.get(fid)
    if not f:
        die(f"no font {fid!r} on Fontsource")
    styles = ["normal"] + (["italic"] if "italic" in (f.get("styles") or []) else [])
    weights = [int(w) for w in f.get("weights") or [400] if str(w).isdigit()][:9]
    dest = XDG_DATA / "fonts" / "flamenco" / fid
    with tempfile.TemporaryDirectory(dir=get_stage()) as tmp:
        tmp = Path(tmp)
        got = []
        for w in weights:
            for s in styles:
                fn = f"{fid}-latin-{w}-{s}.ttf"
                get_download(f"https://cdn.jsdelivr.net/fontsource/fonts/{fid}@latest/latin-{w}-{s}.ttf", tmp / fn, 20 * 1024 * 1024)
                if (tmp / fn).read_bytes()[:4] not in (b"\x00\x01\x00\x00", b"OTTO", b"true"):
                    die("Fontsource sent something that isn't a font")
                got.append(fn)
        if dest.exists():
            shutil.rmtree(dest)
        dest.mkdir(parents=True)
        for fn in got:
            shutil.move(str(tmp / fn), str(dest / fn))
    if shutil.which("fc-cache"):
        subprocess.run(["fc-cache", "-f", str(dest)], capture_output=True, timeout=120)
    m = get_manifest()
    m.setdefault("fonts", {})[fid] = {"name": f.get("family", fid), "names": [f.get("family", fid)], "paths": [str(dest)], "file": f"{len(got)} files"}
    get_manifest_save(m)
    return {"installed": True, "names": [f.get("family", fid)], "paths": [str(dest)], "skipped": []}


def get_remove(kind: str, sid: str) -> dict:
    m = get_manifest()
    e = m.get(kind, {}).pop(sid, None)
    if not e:
        die("that wasn't installed from here")
    # where it may be: its folder (wallpapers went straight into the wallpaper folder before 0.51.1)
    roots = {get_dirs()[kind].resolve()} | ({wallpaper_dir().resolve()} if kind == "wallpapers" else set())
    gone = []
    for p in map(Path, e.get("paths", [])):
        # only straight inside the folder it was put in
        if p.parent.resolve() not in roots or not GET_NAME.match(p.name):
            continue
        if p.is_symlink() or p.is_file():
            p.unlink()
        elif p.is_dir():
            shutil.rmtree(p)
        else:
            continue
        gone.append(str(p))
    get_manifest_save(m)
    if kind == "fonts" and shutil.which("fc-cache"):
        subprocess.run(["fc-cache", "-f"], capture_output=True, timeout=300)
    return {"removed": gone, "names": e.get("names", [])}


def cmd_get(args: list[str]) -> int:
    sub = args[0] if args else ""
    kind = args[1] if len(args) > 1 else ""
    if sub == "kinds":
        print(json.dumps([{"id": k, "name": v["name"]} for k, v in GET_KINDS.items()]))
        return 0
    if sub == "list":
        print(json.dumps(get_manifest()))
        return 0
    if sub not in ("search", "install", "remove") or kind not in GET_KINDS:
        die("usage: flamenco get search KIND [QUERY] [PAGE] [SORT|CATEGORY] | install KIND ID [FILE] | remove KIND ID | list | kinds\n"
            "  KIND: " + ", ".join(GET_KINDS) + "; SORT (store): rating, downloads, new; CATEGORY (fonts): sans-serif, serif, monospace, display, handwriting")
    if sub == "search":
        query = args[2] if len(args) > 2 else ""
        page = max(1, int(args[3])) if len(args) > 3 and args[3].isdigit() else 1
        extra = args[4] if len(args) > 4 else ""
        try:
            res = get_fonts(query, page, extra) if kind == "fonts" else get_ocs(kind, query, page, extra)
        except Exception as e:
            res = {"results": [], "more": False, "error": f"{'Fontsource' if kind == 'fonts' else 'KDE Store'}: {ai_http_error(e)}"}
        print(json.dumps(res))
        return 0
    if len(args) < 3:
        die(f"usage: flamenco get {sub} KIND ID")
    if sub == "remove":
        print(json.dumps(get_remove(kind, args[2])))
        return 0
    n = int(args[3]) if len(args) > 3 and args[3].isdigit() else 0
    res = get_install_font(args[2]) if kind == "fonts" else get_install_ocs(kind, args[2], n)
    print(json.dumps(res))
    return 0


# ─────────────────────────────── plugins ─────────────────────────────────────
# Third-party bar widgets and launcher extensions in ~/.config/flamenco/plugins/<id>/,
# described by manifest.json (see docs/plugins.md). New plugins start disabled;
# they're turned on in Settings → Plugins.

PLUGIN_DIR = CONFIG_DIR / "plugins"
PLUGIN_ID = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")


def plugin_read(d: Path) -> dict:
    p = {"id": d.name, "dir": str(d), "ok": False, "error": ""}
    try:
        m = json.loads((d / "manifest.json").read_text())
    except (OSError, ValueError) as e:
        p["error"] = f"manifest.json: {e}"
        return p
    if not PLUGIN_ID.match(d.name):
        p["error"] = "folder name must be lowercase letters, digits, . _ -"
        return p
    p.update(name=str(m.get("name") or d.name), version=str(m.get("version", "")), author=str(m.get("author", "")),
             description=str(m.get("description", "")), homepage=str(m.get("homepage", "")))
    bar = m.get("bar")
    if bar:
        f = (d / str(bar)).resolve()
        if not f.is_relative_to(d.resolve()) or not f.is_file() or f.suffix != ".qml":
            p["error"] = f"bar widget not found: {bar}"
            return p
        p["bar"] = str(f)
        p["barLabel"] = str(m.get("barLabel") or p["name"])
    la = m.get("launcher")
    if la:
        f = (d / str(la.get("script", ""))).resolve()
        prefix = str(la.get("prefix", ""))
        if not prefix or len(prefix) > 3 or prefix in ("=", ">", ";", ":", "#"):
            p["error"] = "launcher prefix must be 1–3 characters and not one of = > ; : #"
            return p
        if not f.is_relative_to(d.resolve()) or not f.is_file():
            p["error"] = f"launcher script not found: {la.get('script')}"
            return p
        if not os.access(f, os.X_OK):
            p["error"] = f"launcher script isn't executable: chmod +x {f}"
            return p
        p["launcher"] = {"prefix": prefix, "script": str(f), "hint": str(la.get("hint", ""))}
    if not bar and not la:
        p["error"] = "the manifest has neither a bar widget nor a launcher extension"
        return p
    p["ok"] = True
    return p


def plugins_list() -> list[dict]:
    if not PLUGIN_DIR.is_dir():
        return []
    return [plugin_read(d) for d in sorted(PLUGIN_DIR.iterdir()) if d.is_dir() and not d.name.startswith(".")]


PLUGIN_EXAMPLE = {
    "manifest.json": json.dumps({
        "name": "Hello", "version": "1.0", "author": "you", "description": "An example: a bar widget and a launcher extension",
        "bar": "BarWidget.qml", "barLabel": "Hello (example)",
        "launcher": {"prefix": "!", "script": "launcher.py", "hint": "! something to search"}}, indent=2) + "\n",
    "BarWidget.qml": """import QtQuick

// A Flamenco bar widget. `api` is set by Flamenco (see docs/plugins.md):
// api.theme (colors, fonts, sizes), api.media / api.audio / api.niri / api.time…,
// api.run([...]), api.exec([...], callback), api.notify(title, body), api.settings.
Rectangle {
    id: root
    property var api
    property string screenName
    property int barLevel: 0

    implicitWidth: label.implicitWidth + 20
    implicitHeight: api ? api.theme.barHeight - 10 : 30
    radius: height / 2
    color: hover.hovered && api ? Qt.rgba(api.theme.accent.r, api.theme.accent.g, api.theme.accent.b, 0.18) : "transparent"

    Text {
        id: label
        anchors.centerIn: parent
        text: "👋 " + (api ? api.time.time : "")
        color: api ? api.theme.text : "white"
        font.family: api ? api.theme.fontFamily : ""
        font.pixelSize: api ? api.theme.fsSm : 12
    }
    HoverHandler { id: hover }
    TapHandler { onTapped: api.notify("Hello from a plugin", "Edit BarWidget.qml to make it yours") }
