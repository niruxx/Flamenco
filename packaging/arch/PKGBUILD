# Maintainer: niruxxdaboi
#
# Builds from this local checkout:  cd packaging/arch && makepkg -si
pkgname=flamenco-shell
pkgver=0.47.1
pkgrel=1
pkgdesc="Quickshell desktop shell for niri, with Qt and GTK app theming"
arch=('any')
url="https://github.com/niruxx/flamenco-shell"
license=('unknown' 'Apache-2.0' 'OFL-1.1' 'MIT')  # Apache-2.0: Material Symbols; OFL-1.1: Google Sans Flex / Code; MIT: shell/Compat (Noctalia, DMS, Tabler icons)
depends=('quickshell' 'python' 'python-gobject' 'qt6-declarative' 'procps-ng')
optdepends=(
    'niri: compositor (or hyprland)'
    'hyprland: compositor (or niri)'
    'jq: Hyprland window screenshots'
    'grim: screenshots on Hyprland'
    'libnotify: screenshot notifications on Hyprland'
    'flatpak: Flatpak permissions page'
    'fprintd: fingerprint enrolling and unlock'
    'python-anthropic: Claude in the AI assistant (AUR)'
    'libsecret: keep AI API keys in the keyring (secret-tool)'
    'wf-recorder: screen recording'
    'gpu-screen-recorder: screen recording (alternative)'
    'slurp: recording an area'
    'ddcutil: brightness of external monitors (DDC/CI)'
    'hyprpicker: the color picker on Hyprland'
    'pacman-contrib: checkupdates, for the package updates widget'
    'cava: the audio visualizer'
    'greetd: login screen (with flamenco-greeter)'
    'pciutils: graphics card in Settings → About'
    'networkmanager: network status and Wi-Fi control'
    'brightnessctl: screen brightness'
    'matugen: colors from wallpaper'
    'qt6-multimedia: live (video) wallpapers'
    'qt6-multimedia-ffmpeg: live wallpapers: the video backend'
    'ffmpeg: live wallpapers: stills for thumbnails and colors'
    'cliphist: clipboard history in the launcher'
    'fuzzel: the fuzzel launcher (Settings → Launcher), themed by Flamenco'
    'mako: mako notifications (Settings → Notifications), themed by Flamenco'
    'wl-clipboard: copy from launcher / clipboard'
    'gammastep: night light'
    'qt5ct: theme Qt 5 apps'
    'qt6ct: theme Qt 6 apps'
    'xdg-desktop-portal-wlr: lightweight screen sharing'
    'xdg-desktop-portal-gtk: file chooser and settings portal'
    'slurp: pick the screen to share with the wlr portal'
    'ufw: firewall (or firewalld)'
    'sound-theme-freedesktop: default sound theme'
    'adw-gtk-theme: libadwaita look for GTK 3 apps'
    'power-profiles-daemon: power profile tile'
    'upower: battery status'
    'bluez: Bluetooth'
)
install=flamenco-shell.install

package() {
    local src="$startdir/../.."
    install -Dm755 "$src/bin/flamenco" "$pkgdir/usr/bin/flamenco"
    install -d "$pkgdir/usr/share/flamenco-shell"
    cp -r --no-preserve=ownership "$src/shell" "$pkgdir/usr/share/flamenco-shell/"
    find "$pkgdir/usr/share/flamenco-shell" -type f -exec chmod 644 {} +
    find "$pkgdir/usr/share/flamenco-shell" -type d -exec chmod 755 {} +
    install -Dm644 "$src/examples/niri-flamenco.kdl" "$pkgdir/usr/share/flamenco-shell/examples/niri-flamenco.kdl"
    install -Dm644 "$src/data/niri/config.kdl" "$pkgdir/usr/share/flamenco-shell/niri/config.kdl"
    install -Dm644 "$src/data/hypr/hyprland.conf" "$pkgdir/usr/share/flamenco-shell/hypr/hyprland.conf"
    install -Dm644 "$src/data/hypr/hyprland.lua" "$pkgdir/usr/share/flamenco-shell/hypr/hyprland.lua"
    install -d "$pkgdir/usr/share/sounds"
    cp -r --no-preserve=ownership "$src/data/sounds/flamenco" "$pkgdir/usr/share/sounds/"
    find "$pkgdir/usr/share/sounds" -type f -exec chmod 644 {} +
    find "$pkgdir/usr/share/sounds" -type d -exec chmod 755 {} +
    install -Dm644 "$src/data/flamenco-settings.desktop" "$pkgdir/usr/share/applications/flamenco-settings.desktop"
    install -Dm644 "$src/data/flamenco-settings.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/flamenco-settings.svg"
    install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/flamenco-shell/README.md"
    install -Dm644 "$src/shell/assets/fonts/MaterialSymbols-LICENSE.txt" "$pkgdir/usr/share/licenses/flamenco-shell/MaterialSymbols-LICENSE.txt"
    install -Dm644 "$src/shell/assets/fonts/GoogleSansFlex-OFL.txt" "$pkgdir/usr/share/licenses/flamenco-shell/GoogleSansFlex-OFL.txt"
    install -Dm644 "$src/shell/assets/fonts/GoogleSansCode-OFL.txt" "$pkgdir/usr/share/licenses/flamenco-shell/GoogleSansCode-OFL.txt"
    install -Dm644 "$src/shell/Compat/Noctalia/LICENSE" "$pkgdir/usr/share/licenses/flamenco-shell/Noctalia-MIT.txt"
    install -Dm644 "$src/shell/Compat/Dms/LICENSE" "$pkgdir/usr/share/licenses/flamenco-shell/DankMaterialShell-MIT.txt"
    install -Dm644 "$src/shell/Compat/Dms/DankCommon/LICENSE" "$pkgdir/usr/share/licenses/flamenco-shell/dank-qml-common-MIT.txt"
    install -Dm644 "$src/shell/Compat/Noctalia/Assets/Fonts/tabler/tabler-icons-license.txt" "$pkgdir/usr/share/licenses/flamenco-shell/Tabler-Icons-MIT.txt"
    # the default fonts for every app (GTK, the greeter), not just the shell;
    # linked to the shell's copies, and fontconfig's pacman hook refreshes the cache
    install -d "$pkgdir/usr/share/fonts/flamenco-shell"
    for f in GoogleSansFlex.ttf GoogleSansCode.ttf GoogleSansCode-Italic.ttf; do
        ln -s "../../flamenco-shell/shell/assets/fonts/$f" "$pkgdir/usr/share/fonts/flamenco-shell/$f"
    done
}
